From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: premohq <48417750+premohq@users.noreply.github.com>
Date: Thu, 22 Oct 2026 07:18:35 +0000
Subject: [PATCH] PS5: floating-point literals read with strtof, where libc++
 has no from_chars for them

The PS5's libc++ deletes std::from_chars for float. strtof reads the same text in the C locale, the only one there.
---
 source/effect_lexer.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/source/effect_lexer.cpp b/source/effect_lexer.cpp
index 7d6069e..5642d73 100644
--- a/source/effect_lexer.cpp
+++ b/source/effect_lexer.cpp
@@ -6,6 +6,8 @@
 #include "effect_lexer.hpp"
 #include <cassert>
 #include <charconv> // std::from_chars
+#include <cstdlib> // std::strtof
+#include <string>
 #include <string_view>
 #include <unordered_map> // Used for static lookup tables
 
@@ -1212,7 +1214,8 @@ void reshadefx::lexer::parse_numeric_literal(token &tok) const
 
 		tok.literal_as_float = exponent_negative ? mantissa / static_cast<float>(e) : mantissa * static_cast<float>(e);
 #else
-		std::from_chars(begin, end, tok.literal_as_float);
+		// PS5: its libc++ has no from_chars for floating point; strtof reads the same literal (the C locale)
+		tok.literal_as_float = std::strtof(std::string(begin, end).c_str(), nullptr);
 #endif
 	}
 
