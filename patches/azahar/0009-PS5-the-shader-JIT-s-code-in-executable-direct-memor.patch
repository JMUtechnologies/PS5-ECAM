From: ps5cemu <ps5cemu@localhost>
Date: Sun, 4 Oct 2026 22:08:20 +0000
Subject: [PATCH] PS5: the shader JIT's code in executable direct memory

The x64 shader JIT took Xbyak's own allocator, which makes heap memory
executable with mprotect. The console refuses that, so a game whose
shaders fall back to the software engine (geometry shaders, for one)
could stop where desktop Azahar runs it. Its code now goes in the
platform layer's read-write-execute direct memory, near Azahar's own
code, as dynarmic's code cache does (ps5platform/exec.h); video_core is
given the layer's headers for it.
---
 src/video_core/CMakeLists.txt                 |  6 ++++
 .../shader/shader_jit_x64_compiler.cpp        | 30 +++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/src/video_core/CMakeLists.txt b/src/video_core/CMakeLists.txt
index bcc601562..52ef483b2 100644
--- a/src/video_core/CMakeLists.txt
+++ b/src/video_core/CMakeLists.txt
@@ -222,6 +222,12 @@ if ("x86_64" IN_LIST ARCHITECTURE)
     target_link_libraries(video_core PUBLIC xbyak)
 endif()
 
+# The PS5: the shader JIT's code goes in the platform layer's executable memory (ps5platform/exec.h),
+# as dynarmic's does
+if (PS5_PLATFORM_INCLUDE)
+    target_include_directories(video_core PRIVATE ${PS5_PLATFORM_INCLUDE})
+endif()
+
 if ("arm64" IN_LIST ARCHITECTURE)
     target_link_libraries(video_core PUBLIC oaknut)
 endif()
diff --git a/src/video_core/shader/shader_jit_x64_compiler.cpp b/src/video_core/shader/shader_jit_x64_compiler.cpp
index a8b35677e..5b3902e81 100644
--- a/src/video_core/shader/shader_jit_x64_compiler.cpp
+++ b/src/video_core/shader/shader_jit_x64_compiler.cpp
@@ -19,6 +19,9 @@
 #include "video_core/pica/shader_unit.h"
 #include "video_core/pica_types.h"
 #include "video_core/shader/shader_jit_x64_compiler.h"
+#ifdef __PROSPERO__
+#include <ps5platform/exec.h>
+#endif
 
 using namespace Common::X64;
 using namespace Xbyak::util;
@@ -1100,7 +1103,34 @@ void JitShader::Compile(const std::array<u32, MAX_PROGRAM_CODE_LENGTH>* program_
     LOG_DEBUG(HW_GPU, "Compiled shader size={}", getSize());
 }
 
+#ifdef __PROSPERO__
+namespace {
+// The PS5: a shader's code goes in the platform layer's read-write-execute direct memory
+// (ps5platform/exec.h), near this code, as dynarmic's code cache does. Xbyak's own allocator makes
+// heap memory executable with mprotect, which the console refuses.
+class ExecutableAllocator : public Xbyak::Allocator {
+public:
+    uint8_t* alloc(size_t size) override {
+        void* p = ps5_exec_allocate(size, reinterpret_cast<uintptr_t>(this));
+        if (p == nullptr) {
+            throw Xbyak::Error(Xbyak::ERR_CANT_ALLOC);
+        }
+        return static_cast<uint8_t*>(p);
+    }
+    void free(uint8_t* p) override {
+        ps5_exec_release(p);
+    }
+    bool useProtect() const override {
+        return false;
+    }
+};
+ExecutableAllocator s_executable_allocator;
+} // namespace
+
+JitShader::JitShader() : Xbyak::CodeGenerator(MAX_SHADER_SIZE, nullptr, &s_executable_allocator) {}
+#else
 JitShader::JitShader() : Xbyak::CodeGenerator(MAX_SHADER_SIZE) {}
+#endif
 
 void JitShader::Compile_Log2(Xbyak::Label subroutine) {
     // SSE does not have a log instruction, thus we must approximate.
