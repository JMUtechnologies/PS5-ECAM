From: premohq <48417750+premohq@users.noreply.github.com>
Date: Wed, 21 Oct 2026 21:14:15 +0000
Subject: [PATCH] PS5: an HTTPS client OpenSSL cannot make says why, and is
 made again (#45)

Artic Setup's system update failed at its first HTTPS request with "Request failed: -1: Invalid":
httplib's SSL client had no context (SSL_CTX_new, or the client certificate refused), and its
connect gives up without an error of its own. The reason OpenSSL queued is now logged with whether
its random generator is seeded; without a seed it gets one from the CPU (RDRAND) and the client is
made again, then without the client certificate.
---
 src/core/hle/service/http/http_c.cpp | 64 ++++++++++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/src/core/hle/service/http/http_c.cpp b/src/core/hle/service/http/http_c.cpp
index d64562e55..e55493d12 100644
--- a/src/core/hle/service/http/http_c.cpp
+++ b/src/core/hle/service/http/http_c.cpp
@@ -13,6 +13,12 @@
 #include <cryptopp/aes.h>
 #include <cryptopp/modes.h>
 #include <fmt/format.h>
+#ifdef __PROSPERO__
+#include <cstring>
+#include <openssl/err.h>
+#include <openssl/rand.h>
+#include <x86intrin.h>
+#endif
 #include "common/archives.h"
 #include "common/assert.h"
 #include "common/file_util.h"
@@ -498,6 +504,37 @@ void Context::MakeRequestNonSSL(httplib::Request& request, const Common::URLInfo
     FinishTransfer();
 }
 
+#ifdef __PROSPERO__
+// PS5: OpenSSL's random generator seeded from the CPU (RDRAND, the TSC where it gives nothing), for
+// a console where OpenSSL found no seed of its own: an SSL context cannot be made without one
+static void SeedOpenSslFromCpu() {
+    unsigned char seed[64];
+    for (std::size_t at = 0; at < sizeof(seed); at += 8) {
+        unsigned long long value = 0;
+        unsigned char ok = 0;
+        for (int tries = 0; tries < 10 && !ok; tries++) {
+            asm volatile("rdrand %0; setc %1" : "=r"(value), "=qm"(ok));
+        }
+        if (!ok) {
+            value ^= __rdtsc() * 0x9E3779B97F4A7C15ull;
+        }
+        std::memcpy(seed + at, &value, 8);
+    }
+    RAND_seed(seed, sizeof(seed));
+}
+
+// The reasons OpenSSL has queued, for the log
+static std::string OpenSslErrors() {
+    std::string reasons;
+    for (unsigned long code = ERR_get_error(); code != 0; code = ERR_get_error()) {
+        char text[256];
+        ERR_error_string_n(code, text, sizeof(text));
+        reasons += reasons.empty() ? text : std::string("; ") + text;
+    }
+    return reasons.empty() ? std::string("no reason given") : reasons;
+}
+#endif
+
 void Context::MakeRequestSSL(httplib::Request& request, const Common::URLInfo& url_info,
                              std::vector<Context::RequestHeader>& pending_headers) {
     httplib::Error error{-1};
@@ -537,6 +574,33 @@ void Context::MakeRequestSSL(httplib::Request& request, const Common::URLInfo& u
         client = std::make_unique<httplib::SSLClient>(url_info.host, url_info.port);
     }
 
+#ifdef __PROSPERO__
+    // PS5: an SSL client OpenSSL could not make (its context, or the client certificate refused)
+    // failed every HTTPS request with "-1: Invalid" and nothing more: Artic Setup's system update
+    // stopped there (#45). OpenSSL's reason is logged; with no seed for its random generator it is
+    // given one and the client made again, then without the client certificate
+    if (!client->is_valid()) {
+        const bool seeded = RAND_status() == 1;
+        LOG_ERROR(Service_HTTP, "SSL client for {} not made: {} (OpenSSL's random generator {})",
+                  url_info.host, OpenSslErrors(), seeded ? "seeded" : "not seeded");
+        if (!seeded) {
+            SeedOpenSslFromCpu();
+            LOG_INFO(Service_HTTP, "OpenSSL's random generator seeded from the CPU: {}",
+                     RAND_status() == 1 ? "now seeded" : "still not seeded");
+        }
+        client = cert && key ? std::make_unique<httplib::SSLClient>(url_info.host, url_info.port, cert, key)
+                             : std::make_unique<httplib::SSLClient>(url_info.host, url_info.port);
+        if (!client->is_valid() && cert && key) {
+            LOG_ERROR(Service_HTTP, "SSL client with the client certificate not made again: {}; without it",
+                      OpenSslErrors());
+            client = std::make_unique<httplib::SSLClient>(url_info.host, url_info.port);
+        }
+        if (!client->is_valid()) {
+            LOG_ERROR(Service_HTTP, "SSL client for {} not made: {}", url_info.host, OpenSslErrors());
+        }
+    }
+#endif
+
     // TODO(B3N30): Check for SSLOptions-Bits and set the verify method accordingly
     // https://www.3dbrew.org/wiki/SSL_Services#SSLOpt
     // Hack: Since for now RootCerts are not implemented we set the VerifyMode to None.
