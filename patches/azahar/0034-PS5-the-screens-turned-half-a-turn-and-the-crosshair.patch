From: premohq <48417750+premohq@users.noreply.github.com>
Date: Thu, 22 Oct 2026 06:07:48 +0000
Subject: [PATCH] PS5: the screens turned half a turn, and the crosshair over
 the top screen

Settings::values.upside_down (set by PS5-ECAM, not saved) turns the whole layout half a turn: the
screens' rectangles are mirrored through the middle of the picture (FramebufferLayout::is_flipped),
the renderers draw them with the flipped orientations they already had, and a touch is turned back.
With upright_screen, it is a quarter turn clockwise; PS5-ECAM's 3DS side turns the console a quarter
turn at a time, as its DS side does.

CursorInfo::over_top_screen: the crosshair over the top screen, for a bottom screen that is not shown
and is touched all the same.
---
 src/common/settings.h                         |  3 ++
 src/core/frontend/emu_window.cpp              | 20 +++++++++++
 src/core/frontend/emu_window.h                |  3 ++
 src/core/frontend/framebuffer_layout.h        |  3 ++
 .../renderer_opengl/renderer_opengl.cpp       | 18 +++++++---
 .../renderer_vulkan/renderer_vulkan.cpp       | 34 +++++++++++++------
 6 files changed, 66 insertions(+), 15 deletions(-)

diff --git a/src/common/settings.h b/src/common/settings.h
index 485de05eb..511436273 100644
--- a/src/common/settings.h
+++ b/src/common/settings.h
@@ -563,6 +563,9 @@ struct Values {
     SwitchableSetting<LayoutOption> layout_option{LayoutOption::Default, Keys::layout_option};
     SwitchableSetting<bool> swap_screen{false, Keys::swap_screen};
     SwitchableSetting<bool> upright_screen{false, Keys::upright_screen};
+    // PS5: the screens turned half a turn, with upright_screen a quarter turn clockwise; the layout is
+    // mirrored through its middle (EmuWindow::UpdateCurrentFramebufferLayout). Not saved: PS5-ECAM sets it
+    bool upside_down = false;
     SwitchableSetting<SecondaryDisplayLayout> secondary_display_layout{
         SecondaryDisplayLayout::OppositeScreenOnly, Keys::secondary_display_layout};
     SwitchableSetting<std::vector<LayoutOption>> layouts_to_cycle{
diff --git a/src/core/frontend/emu_window.cpp b/src/core/frontend/emu_window.cpp
index 46f0885d6..bef7715e0 100644
--- a/src/core/frontend/emu_window.cpp
+++ b/src/core/frontend/emu_window.cpp
@@ -144,6 +144,12 @@ bool EmuWindow::TouchPressed(unsigned framebuffer_x, unsigned framebuffer_y) {
         static_cast<float>(framebuffer_y - framebuffer_layout.bottom_screen.top) /
         (framebuffer_layout.bottom_screen.bottom - framebuffer_layout.bottom_screen.top);
 
+    // PS5: a screen turned half a turn, its point turned back
+    if (framebuffer_layout.is_flipped) {
+        touch_state->touch_x = 1.f - touch_state->touch_x;
+        touch_state->touch_y = 1.f - touch_state->touch_y;
+    }
+
     if (!framebuffer_layout.is_rotated) {
         std::swap(touch_state->touch_x, touch_state->touch_y);
         touch_state->touch_x = 1.f - touch_state->touch_x;
@@ -275,6 +281,20 @@ void EmuWindow::UpdateCurrentFramebufferLayout(u32 width, u32 height, bool is_po
         layout = Layout::GetCardboardSettings(layout);
     }
     layout.render_3d_mode = stereo_option;
+    // PS5: the whole layout turned half a turn, the screens drawn turned with it (the renderers'
+    // flipped orientations), without stereo's two halves
+    if (Settings::values.upside_down && stereo_option == Settings::StereoRenderOption::Off) {
+        const auto turn = [&layout](Common::Rectangle<u32>& rect) {
+            rect = {layout.width - rect.right, layout.height - rect.bottom, layout.width - rect.left,
+                    layout.height - rect.top};
+        };
+        turn(layout.top_screen);
+        turn(layout.bottom_screen);
+        if (layout.additional_screen_enabled) {
+            turn(layout.additional_screen);
+        }
+        layout.is_flipped = true;
+    }
     NotifyFramebufferLayoutChanged(layout);
 }
 
