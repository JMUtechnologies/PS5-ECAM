         /// bottom_screen.GetHeight().
         float projected_x = 0;
         float projected_y = 0;
+        /// PS5: the bottom screen is not shown and is touched all the same: the crosshair is over the
+        /// top screen, its coordinates the top screen's
+        bool over_top_screen = false;
     };
 
     /// Returns the current cursor state. Override to provide cursor position.
