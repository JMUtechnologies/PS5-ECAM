@@ -1192,6 +1212,20 @@ void RendererVulkan::SwapBuffers() {
     const Layout::FramebufferLayout& layout = render_window.GetFramebufferLayout();
     PrepareRendertarget();
     RenderScreenshot();
+#ifdef __PROSPERO__
+    // the remote touch screen: the bottom screen at its own size, whether or not the TV shows it, at
+    // most 30 times a second while a browser shows it (while none does, a call that reads a flag)
+    if (AzaharPS5_StreamWantFrame()) {
+        const auto previous_pipeline = current_pipeline;
+        const auto previous_interlaced = draw_info.reverse_interlaced;
+        ReloadPipeline(Settings::StereoRenderOption::Off);
+        stream_capture = true;
+        RenderScreenshotWithStagingCopy(true);
+        stream_capture = false;
+        current_pipeline = previous_pipeline;
+        draw_info.reverse_interlaced = previous_interlaced;
+    }
+#endif
     isSecondaryWindow = false;
     RenderToWindow(main_present_window, layout, false);
 #ifndef ANDROID
@@ -1241,10 +1275,21 @@ void RendererVulkan::RenderScreenshot() {
     settings.screenshot_complete_callback(false);
 }
 
-void RendererVulkan::RenderScreenshotWithStagingCopy() {
+void RendererVulkan::RenderScreenshotWithStagingCopy(bool stream) {
     const vk::Device device = instance.GetDevice();
 
-    const Layout::FramebufferLayout layout{settings.screenshot_framebuffer_layout};
+    Layout::FramebufferLayout layout{settings.screenshot_framebuffer_layout};
+#ifdef __PROSPERO__
+    if (stream) {
+        // the bottom screen alone, at its own 320 x 240, whether or not the TV's layout shows it
+        layout = {};
+        layout.width = 320;
+        layout.height = 240;
+        layout.bottom_screen_enabled = true;
+        layout.bottom_screen = {0, 0, 320, 240};
+        layout.render_3d_mode = Settings::StereoRenderOption::Off;
+    }
+#endif
     const u32 width = layout.width;
     const u32 height = layout.height;
 
@@ -1344,20 +1389,48 @@ void RendererVulkan::RenderScreenshotWithStagingCopy() {
             cmdbuf.pipelineBarrier(
                 vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eAllCommands,
                 vk::DependencyFlagBits::eByRegion, memory_write_barrier, {}, write_barrier);
+            const vk::BufferMemoryBarrier host_barrier = {
+                .srcAccessMask = vk::AccessFlagBits::eTransferWrite,
+                .dstAccessMask = vk::AccessFlagBits::eHostRead,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .buffer = staging_buffer,
+                .offset = 0,
+                .size = VK_WHOLE_SIZE,
+            };
+            cmdbuf.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+                                   vk::PipelineStageFlagBits::eHost, {}, {}, host_barrier, {});
         });
 
     // Ensure the copy is fully completed before saving the screenshot
     scheduler.Finish();
 
-    // Copy backing image data to the QImage screenshot buffer
-    std::memcpy(settings.screenshot_bits, alloc_info.pMappedData, staging_buffer_info.size);
-
-    // QImage::Format_RGB32 expects BGRA byte order. If the swapchain format is RGBA,
-    // swap R and B channels so the screenshot colors are correct.
-    if (main_present_window.GetSurfaceFormat() == vk::Format::eR8G8B8A8Unorm) {
-        u8* pixels = static_cast<u8*>(settings.screenshot_bits);
-        for (u32 i = 0; i < width * height; i++) {
-            std::swap(pixels[i * 4 + 0], pixels[i * 4 + 2]);
+    // Make non-coherent host memory visible after the GPU has finished writing.
+    vmaInvalidateAllocation(instance.GetAllocator(), allocation, 0, VK_WHOLE_SIZE);
+#ifdef __PROSPERO__
+    if (stream) {
+        const auto* pixels = static_cast<const u8*>(alloc_info.pMappedData);
+        const bool rgba = main_present_window.GetSurfaceFormat() == vk::Format::eR8G8B8A8Unorm;
+        std::vector<u8> rgb(width * height * 3);
+        for (u32 i = 0; i < width * height; ++i) {
+            rgb[i * 3] = pixels[i * 4 + (rgba ? 0 : 2)];
+            rgb[i * 3 + 1] = pixels[i * 4 + 1];
+            rgb[i * 3 + 2] = pixels[i * 4 + (rgba ? 2 : 0)];
+        }
+        AzaharPS5_StreamFrame(rgb.data(), static_cast<int>(width), static_cast<int>(height));
+    } else
+#endif
+    {
+        // Copy backing image data to the QImage screenshot buffer
+        std::memcpy(settings.screenshot_bits, alloc_info.pMappedData, staging_buffer_info.size);
+
+        // QImage::Format_RGB32 expects BGRA byte order. If the swapchain format is RGBA,
+        // swap R and B channels so the screenshot colors are correct.
+        if (main_present_window.GetSurfaceFormat() == vk::Format::eR8G8B8A8Unorm) {
+            u8* pixels = static_cast<u8*>(settings.screenshot_bits);
+            for (u32 i = 0; i < width * height; i++) {
+                std::swap(pixels[i * 4 + 0], pixels[i * 4 + 2]);
+            }
         }
     }
 
