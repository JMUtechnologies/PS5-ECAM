+// SPDX-License-Identifier: GPL-3.0-or-later
+// Where a game's update and DLC files are, besides the game files folder's updates/ (main.cpp hands
+// them to Eden's ExternalContentProvider, which the patch manager and the add-on service read):
+//   - a game in a folder of its own: that folder, at any depth, as roms/<folder>/ has been since
+//     issue 168. Its folder is the first under roms/, or under the folder PS5-ECAM's Switch side
+//     lists its games from (--set games_folder), whichever is closer to the game: the launcher says
+//     "each in a folder of its own with its update and DLC" for any folder it is given, a USB
+//     drive's too, and lists that folder's mods and cheats for the game.
+//   - a game directly in such a folder, or anywhere else: the NSP and XCI files beside it that hold
+//     its update or DLC. A dump's name usually gives its title ID ("Game [0100ABCD12340800].nsp"),
+//     which decides without opening the file; one whose name gives none is opened to read what it
+//     holds (main.cpp). Another game's files are neither handed to Eden nor kept open.
+// dlc/ in the game files folder is read as updates/ is: the other systems' folders have one.
+#pragma once
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+namespace Eden::AddOns {
+
+// A title's game, as Eden's FileSys::GetBaseTitleID has it: its update (base + 0x800) and its DLC
+// (base + 0x1000 + n) have the game's base title ID
+inline constexpr std::uint64_t BaseOf(std::uint64_t title) { return title & 0xFFFFFFFFFFFFE000ull; }
+// Whether a title is the game's update or one of its DLC, not the game (or another of its programs)
+inline constexpr bool IsAddOnOf(std::uint64_t title, std::uint64_t base) { return BaseOf(title) == base && (title & 0x1FFF) >= 0x800; }
+
+// The title ID in a dump's name ("[0100ABCD12345000]"), else 0
+inline std::uint64_t TaggedTitle(std::string_view name) {
+    for (size_t open = name.find('['); open != std::string_view::npos; open = name.find('[', open + 1)) {
+        if (open + 17 >= name.size() || name[open + 17] != ']' || name.substr(open + 1, 2) != "01") continue;
+        const std::string_view digits = name.substr(open + 1, 16);
+        if (std::all_of(digits.begin(), digits.end(), [](char c) { return std::isxdigit(static_cast<unsigned char>(c)) != 0; }))
+            return std::strtoull(std::string{digits}.c_str(), nullptr, 16);
+    }
+    return 0;
+}
+
+inline bool IsSwitchFile(const std::filesystem::path& path) {
+    std::string extension = path.extension().string();
+    std::transform(extension.begin(), extension.end(), extension.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return extension == ".nsp" || extension == ".xci";
+}
+
+// The game's own folder ("<root>/<folder>"): of the roots the game is in, the closest to it, and the
+// first folder under that root. Empty for a game directly in it, or in none of them.
+inline std::string GameFolder(std::string_view rom, const std::vector<std::string>& roots) {
+    std::string closest;
+    for (std::string root : roots) {
+        while (root.size() > 1 && root.back() == '/') root.pop_back();
+        if (root.size() < 2 || root.front() != '/') continue;
+        root += '/';
+        if (rom.starts_with(root) && root.size() > closest.size()) closest = std::move(root);
+    }
+    if (closest.empty()) return {};
+    const size_t slash = rom.find('/', closest.size());
+    return slash == std::string_view::npos || slash == closest.size() ? std::string{} : std::string{rom.substr(0, slash)};
+}
+
+// The NSP and XCI files beside a game (in its folder, not the folders in it), the game's own file
+// left out: those whose names give one of the game's update and DLC titles go in named, those whose
+// names give no title in unnamed (what they hold decides). Files named for another title, the game's
+// own included (another copy of it), are left out. base: the game's base title ID.
+inline void Beside(const std::filesystem::path& rom, std::uint64_t base, std::vector<std::filesystem::path>& named,
+                   std::vector<std::filesystem::path>& unnamed) {
+    if (!base) return;
+    std::error_code ec;
+    const std::filesystem::path folder = rom.parent_path();
+    std::vector<std::filesystem::path> files;
+    for (std::filesystem::directory_iterator it(folder, ec), end; !ec && it != end; it.increment(ec)) {
+        std::error_code type;
+        if (it->is_regular_file(type) && IsSwitchFile(it->path()) && it->path().filename() != rom.filename())
+            files.push_back(it->path());
+    }
+    std::sort(files.begin(), files.end());
+    for (std::filesystem::path& file : files) {
+        const std::string name = file.filename().string();
+        if (name.empty() || name.front() == '.') continue;
+        const std::uint64_t title = TaggedTitle(name);
+        if (!title) unnamed.push_back(std::move(file));
+        else if (IsAddOnOf(title, base)) named.push_back(std::move(file));
+    }
+}
+
+}  // namespace Eden::AddOns
