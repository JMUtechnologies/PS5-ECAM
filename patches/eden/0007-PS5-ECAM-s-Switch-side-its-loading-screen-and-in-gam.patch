+#include "ingame.h"
+
+// PS5-ECAM's in-game menu (its port/eden/ingame.h): the settings it shows, as this session has them
+static ps5ingamenx::Settings EcamSettings() {
+    ps5ingamenx::Settings settings;
+    switch (Settings::values.scaling_filter.GetValue()) {
+    case Settings::ScalingFilter::Fsr: settings.filter = 1; break;
+    case Settings::ScalingFilter::Bicubic: settings.filter = 2; break;
+    case Settings::ScalingFilter::NearestNeighbor: settings.filter = 3; break;
+    default: settings.filter = 0; break;
+    }
+    const int percent = Settings::values.use_speed_limit.GetValue() ? Settings::values.speed_limit.GetValue() : 0;
+    settings.speedLimit = 4;
+    for (int i = 0; i < 5; ++i)
+        if (Eden::kSpeedLimitPercent[i] == percent) settings.speedLimit = i;
+    settings.volume = Settings::values.volume.GetValue();
+#ifdef EDEN_PS5_MIHAWKGEN
+    settings.frameGeneration = Eden::MihawkGenBridge::active.load();
+    settings.canGenerate = settings.frameGeneration;  // its network is loaded only when the game starts with it
+#endif
+    return settings;
+}
+
+// What the menu changed, at once
+static void EcamApply(const ps5ingamenx::Settings& settings) {
+    static constexpr Settings::ScalingFilter filters[] = {Settings::ScalingFilter::Bilinear, Settings::ScalingFilter::Fsr,
+                                                          Settings::ScalingFilter::Bicubic, Settings::ScalingFilter::NearestNeighbor};
+    Settings::values.scaling_filter.SetValue(filters[std::clamp(settings.filter, 0, 3)]);
+    const int percent = Eden::kSpeedLimitPercent[std::clamp(settings.speedLimit, 0, 4)];
+    Settings::values.use_speed_limit.SetValue(percent > 0);
+    Settings::values.speed_limit.SetValue(static_cast<u16>(percent > 0 ? percent : 100));
+    Settings::values.volume.SetValue(static_cast<u8>(std::clamp(settings.volume, 0, 100)));
+#ifdef EDEN_PS5_MIHAWKGEN
+    if (settings.canGenerate) Eden::MihawkGenBridge::active.store(settings.frameGeneration);
+#endif
+    LOG_INFO(Frontend, "EDEN_ECAM_MENU filter={} speed={} volume={} frame_gen={}", settings.filter, percent, settings.volume,
+             settings.frameGeneration);
+}
+#endif
