--- /dev/null
+++ b/headless/ecam.cmake
@@ -0,0 +1,32 @@
+# PS5-ECAM's Switch side: its loading screen and in-game menu (PS5-ECAM's port/eden/ingame.h), drawn
+# here over Eden's own frames, in place of ProsperoEden's loading screen. Its code and Dear ImGui come
+# from the PS5-ECAM checkout that PS5ECAM_PORT names (its port/ folder: tools/build-eden.sh sets it).
+# Without it, Eden is built as ProsperoEden's, with its own screens.
+set(PS5ECAM_PORT "$ENV{PS5ECAM_PORT}" CACHE PATH "PS5-ECAM's port/ folder, for the Switch side's screens")
+if(PS5ECAM_PORT AND EXISTS "${PS5ECAM_PORT}/eden/ingame.cpp")
+    set(ecam_imgui "${PS5ECAM_PORT}/../.deps/Cemu/dependencies/imgui")
+    add_library(ecam_ingame STATIC
+        "${ecam_imgui}/imgui.cpp" "${ecam_imgui}/imgui_draw.cpp" "${ecam_imgui}/imgui_tables.cpp"
+        "${ecam_imgui}/imgui_widgets.cpp" "${ecam_imgui}/backends/imgui_impl_vulkan.cpp"
+        "${PS5ECAM_PORT}/eden/ingame.cpp" "${PS5ECAM_PORT}/eden/ingame_log.cpp"
+        "${PS5ECAM_PORT}/app/lang.cpp" "${PS5ECAM_PORT}/app/keyboard.cpp" "${PS5ECAM_PORT}/ui/text.cpp")
+    target_include_directories(ecam_ingame PUBLIC "${PS5ECAM_PORT}/eden"
+        PRIVATE "${ecam_imgui}" "${ecam_imgui}/backends" "${PS5ECAM_PORT}")
+    # its Vulkan through Eden's device (ingame.cpp loads what it calls), text without FreeType's fonts
+    target_compile_definitions(ecam_ingame PRIVATE VK_NO_PROTOTYPES IMGUI_IMPL_VULKAN_NO_PROTOTYPES PS5ECAM_TEXT_NO_FONTS)
+    target_compile_options(ecam_ingame PRIVATE -Wno-unused-function -Wno-unused-parameter -Wno-unused-variable
+        -Wno-unused-const-variable -Wno-missing-field-initializers
+        $<$<BOOL:${PS5_NATIVE}>:-femulated-tls>)
+    set_target_properties(ecam_ingame PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
+    target_link_libraries(ecam_ingame PUBLIC Vulkan::Headers) # ingame.h names Vulkan's types
+    if(TARGET fmt::fmt)
+        target_link_libraries(ecam_ingame PUBLIC fmt::fmt)
+    elseif(TARGET fmt)
+        target_link_libraries(ecam_ingame PUBLIC fmt)
+    endif()
+    foreach(ecam_user video_core eden-pad)
+        target_link_libraries(${ecam_user} PRIVATE ecam_ingame)
+        target_compile_definitions(${ecam_user} PRIVATE EDEN_ECAM=1)
+    endforeach()
+    message(STATUS "PS5-ECAM's Switch screens: from ${PS5ECAM_PORT}")
+endif()
