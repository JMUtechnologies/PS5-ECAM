diff --git a/headless/pad.cpp b/headless/pad.cpp
index 5b0f99b..70ede18 100644
--- a/headless/pad.cpp
+++ b/headless/pad.cpp
@@ -1,5 +1,8 @@
 // SPDX-License-Identifier: GPL-3.0-or-later
 #include "devices.h"
+#ifdef EDEN_ECAM
+#include "ingame.h"
+#endif
 #include <algorithm>
 #include <cmath>
 #include <numbers>
@@ -403,6 +406,27 @@ void Pad::Consume(std::size_t player, std::span<const ps5::pad::Data> samples) {
             slot.touch_chord = true;
             slot.select_held = false;
         }
+#ifdef EDEN_ECAM
+        // PS5-ECAM's in-game menu (ingame.h): touchpad click + Options, either side, opens and closes it;
+        // while it is up, player 1's controller is the menu's and every player's game gets a still one
+        constexpr ButtonMask ecam_chord = kButtonTouchPad | kButtonOptions;
+        const bool ecam = (pressed & ecam_chord) == ecam_chord;
+        if (ecam && (last_buttons & ecam_chord) != ecam_chord) ecam_toggle = true;
+        if (ecam) {
+            sample.buttons &= ~ecam_chord;
+            slot.touch_chord = true;
+            slot.select_held = false;
+        }
+        const bool ecam_menu = player == 0 ? ps5ingamenx::Controller(sample.buttons | (pressed & kButtonTouchPad),
+                                                                     sample.left_stick.x, sample.left_stick.y)
+                                           : ps5ingamenx::MenuOpen();
+        if (ecam_menu) {
+            sample = neutral_data(raw.timestamp_us);
+            slot.touch_chord = true;
+            slot.select_held = false;
+            slot.select_pulse = 0;
+        }
+#endif
         if (!touch && touched) {
             if (!slot.touch_chord && !slot.select_held) slot.select_pulse = kSelectTapPolls + 1;
             slot.select_held = false;
