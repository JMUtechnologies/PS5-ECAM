+// Resolve after elevation, never during static initialization in the sandbox. This is the same
+// legacy/verified-copy selection used by the host launcher for its launch request and saves.
+inline const std::string& DataDir() {
+    if (!FilesystemAccess()) {
+        static const std::string unavailable = ecam_layout::Sibling(ECAM_SHARED_DATA, "eden");
+        return unavailable;
+    }
+    static const std::string selected = ecam_layout::System(ECAM_SHARED_DATA, "eden");
+    return selected;
+}
