diff --git a/tools/patch-radv-spirv-failure.py b/tools/patch-radv-spirv-failure.py
new file mode 100755
index 0000000..5727625
--- /dev/null
+++ b/tools/patch-radv-spirv-failure.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""A shader whose SPIR-V the driver cannot read builds no pipeline, rather than crashing it.
+
+Mesa's spirv_to_nir gives back nothing for SPIR-V it refuses, and RADV went on with that nothing:
+This War of Mine crashed on a VkPipelineBuilder thread (radv_shader_spirv_to_nir reading address
+0x40) as one of its shaders, as Eden translated it, was refused. Why it was refused went to the
+VK_EXT_debug_report callback Eden does not install. Now the reason is written to stderr (Eden's
+stderr.log) with the stage, and a graphics or compute pipeline with such a shader fails to be
+created (VK_ERROR_UNKNOWN). Eden already catches that: it logs the pipeline, and the draws and
+dispatches that use it are skipped. Applied to the driver checkout after
+patch-radv-transfer-split.py; running it again changes nothing.
+"""
+from pathlib import Path
+import sys
+import hashlib
+
+fingerprint = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+if sys.argv[1:2] == ['--digest']:
+    print(fingerprint)
+    raise SystemExit(0)
+if sys.argv[1:2] == ['--check']:
+    stamp = Path(sys.argv[2])
+    raise SystemExit(0 if stamp.is_file() and stamp.read_text().strip() == fingerprint else 1)
+
+root = Path(__file__).resolve().parents[1]
+src = Path(sys.argv[1]) if len(sys.argv) > 1 else root.parent / 'mihawk-vulkan-review/.deps/work/radv-src'
+vulkan = src / 'src/amd/vulkan'
+mark = 'tools/patch-radv-spirv-failure.py'
+
+
+def edit(path, changes):
+    """Each (before, after) once; a file that has every after already is left as it is."""
+    text = path.read_text()
+    changed = False
+    for before, after in changes:
+        if after in text:
+            continue
+        assert text.count(before) == 1, f'{path.name} changed: {before.splitlines()[0].strip()}'
+        text = text.replace(before, after)
+        changed = True
+    if changed:
+        path.write_text(text)
+    return changed
+
+
+changed = edit(vulkan / 'radv_shader.c', [
+    ('''   snprintf(buffer, sizeof(buffer), "SPIR-V offset %lu: %s", (unsigned long)spirv_offset, message);
+''', '''   snprintf(buffer, sizeof(buffer), "SPIR-V offset %lu: %s", (unsigned long)spirv_offset, message);
+
+   /* ProsperoEden: why a shader's SPIR-V was refused, in the log (tools/patch-radv-spirv-failure.py) */
+   if (level == NIR_SPIRV_DEBUG_LEVEL_ERROR)
+      fprintf(stderr, "[ProsperoEden] radv: %s\\n", buffer);
+'''),
+    ('''                         &compiler_info->nir_options[stage->stage]);
+      nir->info.internal |= is_internal;
+''', '''                         &compiler_info->nir_options[stage->stage]);
+      if (!nir) {
+         /* ProsperoEden: SPIR-V the reader refused (why: the line before) builds no pipeline
+          * (tools/patch-radv-spirv-failure.py). */
+         fprintf(stderr, "[ProsperoEden] radv: a %s shader's SPIR-V (%u bytes) was refused: its pipeline is not built\\n",
+                 _mesa_shader_stage_to_string(stage->stage), (unsigned)stage->spirv.size);
+         vtn_free_specialization(spec);
+         return NULL;
+      }
+      nir->info.internal |= is_internal;
+'''),
+])
+
+changed |= edit(vulkan / 'radv_pipeline_graphics.h', [
+    ('void radv_graphics_shaders_compile(', 'bool radv_graphics_shaders_compile('),
+])
+
+graphics = vulkan / 'radv_pipeline_graphics.c'
+changed |= edit(graphics, [
+    ('''void
+radv_graphics_shaders_compile(''', '''bool
+radv_graphics_shaders_compile('''),
+    ('''            stages[s].nir = radv_shader_spirv_to_nir(compiler_info, &stages[s], &options, is_internal);
+            if (nir_cache)
+               radv_pipeline_cache_insert_nir(compiler_info, cache, key, stages[s].nir);
+         }
+      }
+
+      stages[s].feedback.duration += os_time_get_nano() - stage_start;
+   }
+''', '''            stages[s].nir = radv_shader_spirv_to_nir(compiler_info, &stages[s], &options, is_internal);
+            if (nir_cache && stages[s].nir)
+               radv_pipeline_cache_insert_nir(compiler_info, cache, key, stages[s].nir);
+         }
+      }
+
+      stages[s].feedback.duration += os_time_get_nano() - stage_start;
+   }
+
+   /* ProsperoEden: a stage whose SPIR-V was refused has no NIR, and nothing is compiled
+    * (tools/patch-radv-spirv-failure.py). */
+   for (unsigned s = 0; s < MESA_VULKAN_SHADER_STAGES; s++) {
+      if (stages[s].stage != MESA_SHADER_NONE && !stages[s].nir)
+         return false;
+   }
+'''),
+    ('''      gs_compute->tess = gs_compute_nir.tess;
+      gs_compute->used = true;
+   }
+}
+''', '''      gs_compute->tess = gs_compute_nir.tess;
+      gs_compute->used = true;
+   }
+   return true;
+}
+'''),
+    ('''   radv_graphics_shaders_compile(compiler_info, cache, stages, &gfx_state->key.gfx_state, pipeline->base.is_internal,
+                                 retained_shaders, noop_fs, debug, binaries, &gs_copy_debug, &gs_copy_binary,
+                                 &gs_compute);
+''', '''   if (!radv_graphics_shaders_compile(compiler_info, cache, stages, &gfx_state->key.gfx_state,
+                                      pipeline->base.is_internal, retained_shaders, noop_fs, debug, binaries,
+                                      &gs_copy_debug, &gs_copy_binary, &gs_compute)) {
+      /* ProsperoEden: no pipeline from SPIR-V the reader refused (tools/patch-radv-spirv-failure.py) */
+      result = VK_ERROR_UNKNOWN;
+      goto done;
+   }
+'''),
+])
+
+changed |= edit(vulkan / 'radv_pipeline_compute.c', [
+    ('''   cs_stage->nir = radv_shader_spirv_to_nir(compiler_info, cs_stage, NULL, is_internal);
+''', '''   cs_stage->nir = radv_shader_spirv_to_nir(compiler_info, cs_stage, NULL, is_internal);
+   if (!cs_stage->nir)
+      return NULL; /* ProsperoEden: SPIR-V the reader refused (tools/patch-radv-spirv-failure.py) */
+'''),
+    ('''      radv_compile_cs(compiler_info, &cs_stage, pipeline->base.is_internal, &cs_dbg);
+''', '''      radv_compile_cs(compiler_info, &cs_stage, pipeline->base.is_internal, &cs_dbg);
+   if (!cs_binary) {
+      /* ProsperoEden: no pipeline from SPIR-V the reader refused (tools/patch-radv-spirv-failure.py) */
+      radv_pipeline_stage_finish(&cs_stage);
+      result = VK_ERROR_UNKNOWN;
+      goto done;
+   }
+'''),
+])
+
+if changed:
+    # Upstream skips the whole build while its receipt names the pinned revision: set the receipt
+    # aside so the next build compiles the changed files (Ninja keeps every other object).
+    provenance = root.parent / 'mihawk-vulkan-review/.deps/native/radv-release/PROVENANCE.txt'
+    if provenance.exists():
+        provenance.replace(provenance.with_suffix('.base.txt'))
+for path in ('radv_shader.c', 'radv_pipeline_graphics.c', 'radv_pipeline_compute.c'):
+    assert mark in (vulkan / path).read_text(), f'{path} is not patched'
+print('RADV: refused SPIR-V logged, its pipeline not built')
diff --git a/tools/prepare-build.sh b/tools/prepare-build.sh
index 2bf5f83..f4a1d6f 100644
--- a/tools/prepare-build.sh
+++ b/tools/prepare-build.sh
@@ -98,7 +98,8 @@ if [[ -f $radv_release/lib/libvulkan_radeon.ps5.a ]]; then
     elif ! python3 -B tools/patch-radv-wsi.py --check "$radv_release/EDEN_WSI_SHA256" ||
          ! python3 -B tools/patch-radv-gs-compute.py --check "$radv_release/EDEN_GS_SHA256" ||
          ! python3 -B tools/patch-radv-disk-cache.py --check "$radv_release/EDEN_DISK_CACHE_SHA256" ||
-         ! python3 -B tools/patch-radv-transfer-split.py --check "$radv_release/EDEN_TRANSFER_SPLIT_SHA256"; then
+         ! python3 -B tools/patch-radv-transfer-split.py --check "$radv_release/EDEN_TRANSFER_SPLIT_SHA256" ||
+         ! python3 -B tools/patch-radv-spirv-failure.py --check "$radv_release/EDEN_SPIRV_FAILURE_SHA256"; then
         step "RADV: this repository's adaptation of the driver changed"
         bash tools/build-radv-dependencies.sh
         rm -f build/radv-isolated/libvulkan_radeon.ps5.a
