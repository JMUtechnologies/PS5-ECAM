@@ -26,6 +26,8 @@ assert 'patch-radv-disk-cache.py --check "$radv_release/EDEN_DISK_CACHE_SHA256"'
 assert 'patch-radv-disk-cache.py" --digest > "$vulkan/.deps/native/radv-release/EDEN_DISK_CACHE_SHA256"' in build
