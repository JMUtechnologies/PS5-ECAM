diff --git a/src/lifecycle.c b/src/lifecycle.c
index 3002c52..228c3c1 100644
--- a/src/lifecycle.c
+++ b/src/lifecycle.c
@@ -5,6 +5,30 @@
 extern int sceKernelUsleep(uint32_t microseconds);
 extern int sceKernelDebugOutText(int channel, const char *text);
 extern int sceSystemServiceLoadExec(const char *path, const char **args);
+// PS5CEMU-HAR (PPSA99360) runs this program from its app folder's eden/ as its Switch side.
+// When main returns (its launcher was left, or a game PS5CEMU-HAR started has ended), the app
+// goes back to PS5CEMU-HAR's own eboot, which opens on its Switch side; only a home screen
+// tile's --exit-after-game closes it (eden_stay_closed). Each eboot is tried until one takes.
+static int return_to_host = 1;
+static const char *host_eboot = NULL;
+void eden_set_host_eboot(const char *eboot) { host_eboot = eboot; }
+void eden_stay_closed(void) { return_to_host = 0; }
+static void return_to_host_app(void) {
+    char marker[160];
+    const char *eboots[] = {host_eboot, "/app0/eboot.bin", "/system_ex/app/PPSA99360/eboot.bin",
+                            "/data/homebrew/PPSA99360/eboot.bin"};
+    for (unsigned i = 0; i < sizeof(eboots) / sizeof(eboots[0]); i++) {
+        if (!eboots[i] || !eboots[i][0]) continue;
+        snprintf(marker, sizeof(marker), "EDEN_PS5CEMU_RETURN %s\n", eboots[i]);
+        sceKernelDebugOutText(0, marker);
+        const int refused = sceSystemServiceLoadExec(eboots[i], NULL);
+        // it does not come back when it works; allow for one that returns before the process ends
+        if (refused == 0)
+            for (int wait = 0; wait < 100; wait++) sceKernelUsleep(100000);
+        snprintf(marker, sizeof(marker), "EDEN_PS5CEMU_RETURN_REFUSED %s rc=%x\n", eboots[i], (unsigned)refused);
+        sceKernelDebugOutText(0, marker);
+    }
+}
 // main returned: ask the system to end this title. The C library's exit() and _Exit() are not a
 // way out for a native title: the kernel answers them with signal 12, so the app "crashes", the
 // system writes a crash report and force-kills it (every development run ended that way, and three
@@ -14,6 +38,7 @@ __attribute__((noreturn)) void catchReturnFromMain(int status) {
     fflush(NULL);
     snprintf(marker, sizeof(marker), "EDEN_PPSA99121_MAIN_RETURN status=%d\n", status);
     sceKernelDebugOutText(0, marker);
+    if (return_to_host) return_to_host_app();
     const int refused = sceSystemServiceLoadExec("exit", NULL);
     snprintf(marker, sizeof(marker), "EDEN_PPSA99121_EXIT_REFUSED rc=%x\n", (unsigned)refused);
     sceKernelDebugOutText(0, marker);
@@ -26,7 +51,8 @@ __attribute__((noreturn)) void catchReturnFromMain(int status) {
 int eden_restart_app(void) {
     char marker[96];
     sceKernelDebugOutText(0, "EDEN_PPSA99121_RESTART\n");
-    const int refused = sceSystemServiceLoadExec("/app0/eboot.bin", NULL);
+    int refused = sceSystemServiceLoadExec("/app0/eden/eboot.bin", NULL);
+    if (refused != 0) refused = sceSystemServiceLoadExec("/app0/eboot.bin", NULL);
     snprintf(marker, sizeof(marker), "EDEN_PPSA99121_RESTART_REFUSED rc=%x\n", (unsigned)refused);
     sceKernelDebugOutText(0, marker);
     return refused;
