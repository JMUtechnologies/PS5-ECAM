+// A game PS5CEMU-HAR started (--rom): its cover and its own name where the library keeps them
+// (covers/, by the file's path in roms/, eden_services.cpp), for PS5CEMU-HAR's Switch side to show;
+// the library writes the same when it lists the game. Each is read from the game once.
+static void KeepForwardedCover(const std::string& rom) {
+    const std::string roms = Eden::AssetsPath("roms/");
+    const std::string file = rom.rfind(roms, 0) == 0 ? rom.substr(roms.size()) : std::filesystem::path(rom).filename().string();
+    const std::string cover = Eden::CoverFile(file);
+    char name[16]{};
+    std::snprintf(name, sizeof(name), "/%08x.name", Eden::HashPath(file));
+    const std::string name_path = Eden::CoversDir() + name;
+    if (Eden::FileExists(cover) && Eden::FileExists(name_path)) return;
+    (void)mkdir(Eden::CoversDir().c_str(), 0777);
+    char title[513]{};
+    const int found = eden_extract_game_metadata(rom.c_str(), Eden::AssetsPath("keys").c_str(), cover.c_str(), title,
+                                                 sizeof(title));
+    if ((found & EDEN_METADATA_TITLE) && title[0]) {
+        const std::string staged = name_path + ".new";
+        if (std::FILE* out = std::fopen(staged.c_str(), "wb")) {
+            const std::size_t length = std::strlen(title);
+            const bool written = std::fwrite(title, 1, length, out) == length;
+            const bool kept = std::fclose(out) == 0 && written && std::rename(staged.c_str(), name_path.c_str()) == 0;
+            if (!kept) (void)std::remove(staged.c_str());
+        }
+    }
+    Eden::BootTrace::Line("the game's cover: %s, its name: %s", (found & EDEN_METADATA_COVER) ? "kept" : "none",
+                          (found & EDEN_METADATA_TITLE) ? "kept" : "none");
+}
