From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: premohq <48417750+premohq@users.noreply.github.com>
Date: Tue, 20 Oct 2026 07:39:07 +0000
Subject: [PATCH] The Switch side's settings for the game it starts (--set
 key=value)

PS5CEMU-HAR's launcher has the Switch side's settings, and a game's own, as it has every side's:
it starts a game with them as --set arguments (resolution, upscaling_filter, astc_textures,
fps_overlay, volume and vibration as video, audio and controls name them, console_mode as a
game's), which go over Settings and the game's own for that session (SessionSettings:
PreferencesFor, LoadGameDocked).
---
 headless/forwarded_launch.h |  9 +++++++
 headless/main.cpp           |  4 +++
 headless/settings_store.h   | 51 +++++++++++++++++++++++++++++++++++--
 3 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/headless/forwarded_launch.h b/headless/forwarded_launch.h
index 289f045..9c468d6 100644
--- a/headless/forwarded_launch.h
+++ b/headless/forwarded_launch.h
@@ -2,6 +2,8 @@
 #pragma once
 #include <string>
 #include <string_view>
+#include <utility>
+#include <vector>
 
 namespace Eden {
 
@@ -9,6 +11,9 @@ struct ForwardedArgs {
     std::string rom;
     bool exit_after_game = false;
     std::string return_to;  // --return <eboot>: PS5CEMU-HAR's, which started this program
+    // --set <key>=<value>, repeated: the settings PS5CEMU-HAR's Switch side starts the game with
+    // (settings_store.h's SetSessionSetting)
+    std::vector<std::pair<std::string, std::string>> settings;
 };
 
 inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
@@ -29,6 +34,10 @@ inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
             if (i + 1 < argc && argv[i + 1] != nullptr) result.return_to = argv[++i];
         } else if (arg.starts_with("--return=")) {
             result.return_to = std::string{arg.substr(9)};
+        } else if (arg == "--set" && i + 1 < argc && argv[i + 1] != nullptr) {
+            const std::string_view setting{argv[++i]};
+            if (const auto equals = setting.find('='); equals != std::string_view::npos && equals > 0)
+                result.settings.emplace_back(setting.substr(0, equals), setting.substr(equals + 1));
         }
     }
     return result;
diff --git a/headless/main.cpp b/headless/main.cpp
index 1708a61..0a9b08c 100644
--- a/headless/main.cpp
+++ b/headless/main.cpp
@@ -522,6 +522,10 @@ int main(int argc, char** argv) {
         // The previous run crashed: the launcher says where its report is.
         if (!last_crash.report.empty()) launch_error = std::string{Eden::Crash::kNotice} + last_crash.report;
         const Eden::ForwardedArgs forwarded = Eden::ParseForwardedArgs(argc, argv);
+        // the settings PS5CEMU-HAR's Switch side starts its game with, over this program's own
+        for (const auto& [key, value] : forwarded.settings)
+            if (!forwarded.rom.empty() && !Eden::SetSessionSetting(key, value))
+                Eden::BootTrace::Line("PS5CEMU-HAR's setting %s=%s left out", key.c_str(), value.c_str());
         // PS5CEMU-HAR's eboot, for when main returns (src/lifecycle.c)
         static const std::string host_eboot = forwarded.return_to;
         eden_set_host_eboot(host_eboot.c_str());
diff --git a/headless/settings_store.h b/headless/settings_store.h
index f5f0033..6a49190 100644
--- a/headless/settings_store.h
+++ b/headless/settings_store.h
@@ -559,8 +559,41 @@ inline bool SavePreferences(const Preferences& value, const std::string& file =
     return Settings::Write(document, file);
 }
 
+// PS5CEMU-HAR's Switch side starts a game with its own launcher's settings for it (--set key=value,
+// forwarded_launch.h): its resolution, upscaling filter, ASTC textures, overlay, volume, vibration
+// and console mode, over Settings and the game's own for that session; -1 where it gave none.
+struct SessionSettings {
+    int resolution = -1, upscaling_filter = -1, astc_textures = -1, hud = -1, volume = -1, docked = -1, vibration = -1;
+};
+inline SessionSettings& Session() {
+    static SessionSettings settings;
+    return settings;
+}
+// One of them by its key in this file (video's resolution, upscaling_filter, astc_textures and
+// fps_overlay, audio's volume, controls' vibration, a game's console_mode) and value as the file
+// has it; false when the key or the value is not one of those.
+inline bool SetSessionSetting(std::string_view key, std::string_view value) {
+    const std::string text{value};
+    const auto index = [&](const char* const* keys, int count) { return KeyIndex(text, keys, count, -1); };
+    SessionSettings& session = Session();
+    if (key == "resolution") session.resolution = index(kResolutionKeys, int(std::size(kResolutionKeys)));
+    else if (key == "upscaling_filter") session.upscaling_filter = index(kUpscalingFilterKeys, int(std::size(kUpscalingFilterKeys)));
+    else if (key == "astc_textures") session.astc_textures = index(kAstcTextureKeys, int(std::size(kAstcTextureKeys)));
+    else if (key == "fps_overlay") session.hud = text == "1" || text == "true" ? 1 : text == "0" || text == "false" ? 0 : -1;
+    else if (key == "vibration") session.vibration = text == "1" || text == "true" ? 1 : text == "0" || text == "false" ? 0 : -1;
+    else if (key == "console_mode") session.docked = text == "docked" ? 1 : text == "handheld" ? 0 : -1;
+    else if (key == "volume") {
+        int volume = -1;
+        if (!text.empty() && text.size() <= 3 && std::all_of(text.begin(), text.end(), [](char c) { return c >= '0' && c <= '9'; }))
+            volume = std::stoi(text);
+        session.volume = volume <= 100 ? volume : -1;
+    } else return false;
+    return true;
+}
+
 // Games run docked unless the player saved "Handheld" for that title in the launcher.
 inline bool LoadGameDocked(uint64_t title_id, const std::string& file = SettingsFile()) {
+    if (Session().docked >= 0) return Session().docked == 1;  // PS5CEMU-HAR's Switch side's
     if (!title_id) return true;
     using Settings::Json;
     const Json document = Settings::Load(file);
@@ -771,8 +804,10 @@ inline bool SaveGameSettings(uint64_t title_id, const GameSettings& value, const
     return Settings::Write(document, file);
 }
 
-// The settings a session of a game uses: Settings, with what the game does differently.
-inline Preferences PreferencesFor(uint64_t title_id, const std::string& file = SettingsFile()) {
+// The settings a session of a game uses: Settings, with what the game does differently, and what
+// PS5CEMU-HAR's Switch side started it with over both (Session).
+inline Preferences PreferencesFor(uint64_t title_id, const std::string& file = SettingsFile());
+inline Preferences PreferencesForGame(uint64_t title_id, const std::string& file) {
     Preferences result = LoadPreferences(file);
     if (!title_id) return result;
     const GameSettings game = LoadGameSettings(title_id, file);
@@ -798,6 +833,18 @@ inline Preferences PreferencesFor(uint64_t title_id, const std::string& file = S
     return result;
 }
 
+inline Preferences PreferencesFor(uint64_t title_id, const std::string& file) {
+    Preferences result = PreferencesForGame(title_id, file);
+    const SessionSettings& session = Session();
+    if (session.resolution >= 0) result.resolution = session.resolution;
+    if (session.upscaling_filter >= 0) result.upscaling_filter = session.upscaling_filter;
+    if (session.astc_textures >= 0) result.astc_textures = session.astc_textures;
+    if (session.hud >= 0) result.hud = session.hud == 1;
+    if (session.volume >= 0) result.volume = session.volume;
+    if (session.vibration >= 0) result.vibration = session.vibration == 1;
+    return result;
+}
+
 // The game the running session belongs to (0 at the launcher): what the audio and the renderer
 // read their game's settings for.
 inline std::atomic<uint64_t> session_title{0};
