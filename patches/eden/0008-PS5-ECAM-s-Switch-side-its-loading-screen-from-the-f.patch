+// The room PS5-ECAM's Multiplayer page chose (settings_store.h's Session), joined before the game
+// starts, as ProsperoEden's launcher has the player do: false when it could not be, with why in the
+// result file ("room:" and the room's name, then Eden's words)
+static bool EcamJoinRoom(Eden::Multiplayer::RoomClient& rooms) {
+    using Eden::Multiplayer::Phase;
+    const auto& session = Eden::Session();
+    if (session.room_host.empty()) return true;
+    Eden::Multiplayer::Connection connection;
+    connection.host = session.room_host;
+    if (session.room_port > 0) connection.port = static_cast<std::uint16_t>(session.room_port);
+    connection.nickname = session.room_nickname.empty() ? "PlayerPS5" : session.room_nickname;
+    connection.password = session.room_password;
+    const std::string name = session.room_name.empty() ? connection.host : session.room_name;
+    Eden::BootTrace::Line("joining PS5-ECAM's room %s:%u", connection.host.c_str(), unsigned(connection.port));
+    if (rooms.GetSnapshot().phase == Phase::Connected) return true;
+    const bool asked = rooms.Connect(connection);
+    const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(20);
+    for (;;) {
+        const auto snapshot = rooms.GetSnapshot();
+        if (snapshot.phase == Phase::Connected) {
+            Eden::Report("multiplayer", ("Joined " + name + " for the game").c_str());
+            return true;
+        }
+        if (!asked || snapshot.phase == Phase::Failed || snapshot.phase == Phase::Idle ||
+            std::chrono::steady_clock::now() > until) {
+            const std::string why = !snapshot.error.empty() ? snapshot.error : "The room did not answer.";
+            rooms.Leave();
+            Eden::Report("multiplayer", ("Could not join " + name + ": " + why).c_str());
+            ps5ingamenx::WriteResult("failed", "room:" + name + "\t" + why);
+            return false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
 }
