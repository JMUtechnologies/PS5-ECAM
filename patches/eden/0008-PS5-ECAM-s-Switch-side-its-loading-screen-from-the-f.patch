+// a controller of its own, player 1's alone. Automatic is a Pro Controller here.
+static void EcamControllers(Core::System& system, const Eden::Pad& pad, int controller) {
+    using Core::HID::NpadStyleIndex;
+    Eden::session_controller = controller;
+    const NpadStyleIndex style = Eden::ChosenStyle(controller).value_or(NpadStyleIndex::Fullkey);
+    const bool handheld = style == NpadStyleIndex::Handheld;
+    const unsigned connected = pad.ConnectedPlayers() | 1u;
+    for (std::size_t index = 0; index < Eden::Pad::kMaxPlayers; ++index) {
+        auto* emulated = system.HIDCore().GetEmulatedControllerByIndex(index);
+        auto& player = Settings::values.players.GetValue()[index];
+        const bool present = !handheld && (connected & (1u << index)) != 0;
+        emulated->Disconnect();
+        player.connected = present;
+        player.controller_type = Eden::ControllerSetting(controller < 0 || handheld ? 0 : controller);
+        if (!present) continue;
+        emulated->SetNpadStyleIndex(style);
+        emulated->Connect(true);
+    }
+    auto* emulated_handheld = system.HIDCore().GetEmulatedController(Core::HID::NpadIdType::Handheld);
+    emulated_handheld->Disconnect();
+    Settings::values.players.GetValue()[8].connected = handheld;
+    if (handheld) {
+        emulated_handheld->SetNpadStyleIndex(NpadStyleIndex::Handheld);
+        emulated_handheld->Connect(true);
+    }
+    Eden::handheld_in_use = handheld;
+}
