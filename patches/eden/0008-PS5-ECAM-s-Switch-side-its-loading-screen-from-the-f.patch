+// An amiibo dump touched to player 1's controller, or the one there taken away, as Eden's desktop
+// frontend does it (OnLoadAmiibo): only while the game looks for one
+static ps5ingamenx::AmiiboAnswer EcamAmiibo(Eden::Pad& pad, const std::string& path) {
+    using State = InputCommon::VirtualAmiibo::State;
+    using Info = InputCommon::VirtualAmiibo::Info;
+    auto& amiibo = pad.Amiibo();
+    // the one there first goes (the game is looking again, as after a scan)
+    if (amiibo.GetCurrentState() == State::TagNearby) amiibo.CloseAmiibo();
+    if (path.empty()) return ps5ingamenx::AmiiboAnswer::Removed;
+    if (amiibo.GetCurrentState() != State::WaitingForAmiibo) return ps5ingamenx::AmiiboAnswer::NotAsked;
+    switch (amiibo.LoadAmiibo(path)) {
+    case Info::Success: return ps5ingamenx::AmiiboAnswer::Touched;
+    case Info::NotAnAmiibo: return ps5ingamenx::AmiiboAnswer::NotAnAmiibo;
+    case Info::WrongDeviceState: return ps5ingamenx::AmiiboAnswer::NotAsked;
+    default: return ps5ingamenx::AmiiboAnswer::Unreadable;
+    }
+}
