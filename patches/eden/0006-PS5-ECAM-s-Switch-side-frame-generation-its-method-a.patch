+            const auto speed = Eden::PerformanceFor(eden_game_title_id(guest));
             Settings::values.use_asynchronous_shaders = speed.async_shaders;
             if (speed.fast_gpu) {
                 // Nothing calls UpdateGPUAccuracy() here; set the live value too.
