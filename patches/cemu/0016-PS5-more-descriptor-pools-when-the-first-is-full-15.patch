From: premohq <48417750+premohq@users.noreply.github.com>
Date: Sun, 4 Oct 2026 02:08:16 +0000
Subject: [PATCH] PS5: more descriptor pools when the first is full (#15)

RADV holds a descriptor pool to its declared sizes, where desktop drivers let it run over, and Batman: Arkham Origins needs more than one pool's 128K image samplers: Cemu stopped with "Failed to allocate descriptor sets". A set now comes from the first pool with room, and a new pool is made when none has; each set is freed to its own pool.
---
 src/Cafe/HW/Latte/Renderer/Vulkan/VKRBase.h   |  3 +
 .../Latte/Renderer/Vulkan/VulkanRenderer.cpp  | 74 +++++++++++++++++--
 .../HW/Latte/Renderer/Vulkan/VulkanRenderer.h | 10 +++
 .../Renderer/Vulkan/VulkanRendererCore.cpp    |  4 +
 .../Renderer/Vulkan/VulkanSurfaceCopy.cpp     |  4 +
 5 files changed, 90 insertions(+), 5 deletions(-)

diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VKRBase.h b/src/Cafe/HW/Latte/Renderer/Vulkan/VKRBase.h
index 7d2cb65..a2de3f2 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VKRBase.h
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VKRBase.h
@@ -230,4 +230,7 @@ public:
 	~VKRObjectDescriptorSet() override;
 
 	VkDescriptorSet descriptorSet{ VK_NULL_HANDLE };
+#if defined(CEMU_PS5)
+	VkDescriptorPool pool{ VK_NULL_HANDLE }; // the pool it came from (VulkanRenderer::PS5_AllocateDescriptorSet)
+#endif
 };
\ No newline at end of file
diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
index 4aa1fca..eba56e4 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
@@ -883,6 +883,11 @@ VulkanRenderer::~VulkanRenderer()
 	}
 
 	vkDestroyDescriptorPool(m_logicalDevice, m_descriptorPool, nullptr);
+#if defined(CEMU_PS5)
+	for (VkDescriptorPool pool : m_ps5ExtraDescriptorPools)
+		vkDestroyDescriptorPool(m_logicalDevice, pool, nullptr);
+	m_ps5ExtraDescriptorPools.clear();
+#endif
 
 	for(auto& i : m_backbufferBlitPipelineCache)
 	{
@@ -3294,27 +3299,82 @@ void VulkanRenderer::DrawBackbufferQuad(LatteTextureView* texView, RendererOutpu
 	chainInfo.hasDefinedSwapchainImage = true;
 }
 
+#if defined(CEMU_PS5)
+void PS5Cemu_LogLine(std::string_view line);
+
+VkResult VulkanRenderer::PS5_AllocateDescriptorSet(VkDescriptorSetLayout layout, VkDescriptorSet& set, VkDescriptorPool& pool)
+{
+	VkDescriptorSetAllocateInfo allocInfo = {};
+	allocInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+	allocInfo.descriptorSetCount = 1;
+	allocInfo.pSetLayouts = &layout;
+	auto tryPool = [&](VkDescriptorPool candidate) {
+		allocInfo.descriptorPool = candidate;
+		const VkResult result = vkAllocateDescriptorSets(m_logicalDevice, &allocInfo, &set);
+		if (result == VK_SUCCESS)
+			pool = candidate;
+		return result;
+	};
+	VkResult result = tryPool(m_descriptorPool);
+	for (size_t i = 0; result != VK_SUCCESS && i < m_ps5ExtraDescriptorPools.size(); i++)
+		result = tryPool(m_ps5ExtraDescriptorPools[i]);
+	if (result == VK_ERROR_OUT_OF_POOL_MEMORY || result == VK_ERROR_FRAGMENTED_POOL)
+	{
+		const VkDescriptorPool extra = PS5_CreateDescriptorPool();
+		if (extra == VK_NULL_HANDLE)
+			return result;
+		m_ps5ExtraDescriptorPools.push_back(extra);
+		PS5Cemu_LogLine(fmt::format("[vulkan] descriptor pools full ({} sets, {} image samplers): pool {} added",
+			performanceMonitor.vk.numDescriptorSets.get(), performanceMonitor.vk.numDescriptorSamplerTextures.get(),
+			m_ps5ExtraDescriptorPools.size() + 1));
+		result = tryPool(extra);
+	}
+	return result;
+}
+#endif
+
 void VulkanRenderer::CreateDescriptorPool()
 {
+#if defined(CEMU_PS5)
+	m_descriptorPool = PS5_CreateDescriptorPool();
+	if (m_descriptorPool == VK_NULL_HANDLE)
+		UnrecoverableError("Failed to create descriptor pool!");
+}
+
+VkDescriptorPool VulkanRenderer::PS5_CreateDescriptorPool()
+{
+	// four times desktop Cemu's pool, made at the start: a pool made later, mid-game, faulted on its
+	// first write on the console (#15), so the first one has to be large enough
+	constexpr uint32 kScale = 4;
+#else
+	constexpr uint32 kScale = 1;
+#endif
 	std::array<VkDescriptorPoolSize, 4> poolSizes = {};
 	poolSizes[0].type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
-	poolSizes[0].descriptorCount = 1024 * 128;
+	poolSizes[0].descriptorCount = 1024 * 128 * kScale;
 	poolSizes[1].type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
-	poolSizes[1].descriptorCount = 1024 * 1;
+	poolSizes[1].descriptorCount = 1024 * 1 * kScale;
 	poolSizes[2].type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
-	poolSizes[2].descriptorCount = 1024 * 128;
+	poolSizes[2].descriptorCount = 1024 * 128 * kScale;
 	poolSizes[3].type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
-	poolSizes[3].descriptorCount = 1024 * 4;
+	poolSizes[3].descriptorCount = 1024 * 4 * kScale;
 
 	VkDescriptorPoolCreateInfo poolInfo = {};
 	poolInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
 	poolInfo.poolSizeCount = poolSizes.size();
 	poolInfo.pPoolSizes = poolSizes.data();
-	poolInfo.maxSets = 1024 * 256;
+	poolInfo.maxSets = 1024 * 256 * kScale;
 	poolInfo.flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT;
 
+#if defined(CEMU_PS5)
+	VkDescriptorPool pool = VK_NULL_HANDLE;
+	if (vkCreateDescriptorPool(m_logicalDevice, &poolInfo, nullptr, &pool) != VK_SUCCESS)
+		return VK_NULL_HANDLE;
+	return pool;
+#else
 	if (vkCreateDescriptorPool(m_logicalDevice, &poolInfo, nullptr, &m_descriptorPool) != VK_SUCCESS)
 		UnrecoverableError("Failed to create descriptor pool!");
+#endif
 }
 
 VkDescriptorSet VulkanRenderer::backbufferBlit_createDescriptorSet(VkDescriptorSetLayout descriptor_set_layout, LatteTextureViewVk* texViewVk, bool useLinearTexFilter)
@@ -4469,6 +4529,10 @@ VKRObjectDescriptorSet::VKRObjectDescriptorSet()
 VKRObjectDescriptorSet::~VKRObjectDescriptorSet()
 {
 	auto vkr = VulkanRenderer::GetInstance();
+#if defined(CEMU_PS5)
+	vkFreeDescriptorSets(vkr->GetLogicalDevice(), pool != VK_NULL_HANDLE ? pool : vkr->GetDescriptorPool(), 1, &descriptorSet);
+#else
 	vkFreeDescriptorSets(vkr->GetLogicalDevice(), vkr->GetDescriptorPool(), 1, &descriptorSet);
+#endif
 	performanceMonitor.vk.numDescriptorSets.decrement();
 }
diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h
index 692bd00..93fe22a 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h
@@ -230,6 +230,12 @@ public:
 	VkPhysicalDevice GetPhysicalDevice() const { return m_physicalDevice; }
 
 	VkDescriptorPool GetDescriptorPool() const { return m_descriptorPool; }
+#if defined(CEMU_PS5)
+	// A descriptor set from the first pool with room, a new pool when none has: RADV holds a pool to
+	// its declared sizes, where desktop drivers let it run over, and some games (Batman: Arkham
+	// Origins) need more image samplers than one pool's 128K. pool is where it came from, to free it.
+	VkResult PS5_AllocateDescriptorSet(VkDescriptorSetLayout layout, VkDescriptorSet& set, VkDescriptorPool& pool);
+#endif
 
 	void WaitDeviceIdle() const { vkDeviceWaitIdle(m_logicalDevice); }
 
@@ -434,6 +440,10 @@ private:
 	VkRenderPass m_imguiRenderPass = VK_NULL_HANDLE;
 
 	VkDescriptorPool m_descriptorPool;
+#if defined(CEMU_PS5)
+	std::vector<VkDescriptorPool> m_ps5ExtraDescriptorPools;
+	VkDescriptorPool PS5_CreateDescriptorPool();
+#endif
 
   public:
 	struct QueueFamilyIndices
