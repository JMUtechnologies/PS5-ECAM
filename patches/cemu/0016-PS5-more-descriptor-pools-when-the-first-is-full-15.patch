index 512ebee..c765a42 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRendererCore.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRendererCore.cpp
@@ -623,7 +623,11 @@ VkDescriptorSetInfo* VulkanRenderer::draw_getOrCreateDescriptorSet(PipelineInfo*
 	allocInfo.pSetLayouts = &descriptor_set_layout;
 
 	VkDescriptorSet result;
+#if defined(CEMU_PS5)
+	if (PS5_AllocateDescriptorSet(descriptor_set_layout, result, vkObjDS->pool) != VK_SUCCESS)
+#else
 	if (vkAllocateDescriptorSets(m_logicalDevice, &allocInfo, &result) != VK_SUCCESS)
+#endif
 	{
 		UnrecoverableError(fmt::format("Failed to allocate descriptor sets. Currently allocated: Descriptors={} TextureSamplers={} DynUniformBuffers={} StorageBuffers={}",
 			performanceMonitor.vk.numDescriptorSets.get(),
diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanSurfaceCopy.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanSurfaceCopy.cpp
index d102a89..1ea131e 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanSurfaceCopy.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanSurfaceCopy.cpp
@@ -523,7 +523,11 @@ VKRObjectDescriptorSet* VulkanRenderer::surfaceCopy_getOrCreateDescriptorSet(VkC
 	allocInfo.descriptorSetCount = 1;
 	allocInfo.pSetLayouts = &pipelineInfo->vkObjPipeline->m_pixelDSL;
 
+#if defined(CEMU_PS5)
+	if (PS5_AllocateDescriptorSet(pipelineInfo->vkObjPipeline->m_pixelDSL, vkObjDescriptorSet->descriptorSet, vkObjDescriptorSet->pool) != VK_SUCCESS)
+#else
 	if (vkAllocateDescriptorSets(m_logicalDevice, &allocInfo, &vkObjDescriptorSet->descriptorSet) != VK_SUCCESS)
+#endif
 	{
 		UnrecoverableError("failed to allocate descriptor set for surface copy operation");
 	}
