From: premohq <48417750+premohq@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:46:55 -0500
Subject: [PATCH] PS5: an ImGui texture that keeps its alpha, for the in-game
 menu's DualSense drawing

---
 .../HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp     | 13 +++++++++++++
 src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h  |  4 ++++
 2 files changed, 17 insertions(+)

diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
index 1a31179..1a54092 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
@@ -2236,6 +2236,19 @@ ImTextureID VulkanRenderer::GenerateTexture(const std::vector<uint8>& data, cons
 	}
 }
 
+ImTextureID VulkanRenderer::GenerateTextureRGBA(const std::vector<uint8>& rgba, const Vector2i& size)
+{
+	try
+	{
+		return (ImTextureID)ImGui_ImplVulkan_GenerateTexture(m_state.currentCommandBuffer, rgba, size);
+	}
+	catch (const std::exception& ex)
+	{
+		cemuLog_log(LogType::Force, "can't generate imgui texture: {}", ex.what());
+		return nullptr;
+	}
+}
+
 void VulkanRenderer::DeleteTexture(ImTextureID id)
 {
 	WaitDeviceIdle();
diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h
index 13663e0..c93b1e5 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.h
@@ -538,6 +538,10 @@ private:
 	bool ImguiBegin(bool mainWindow) override;
 	void ImguiEnd() override;
 	ImTextureID GenerateTexture(const std::vector<uint8>& data, const Vector2i& size) override;
+public:
+	// PS5: a picture that keeps its alpha (RGBA, 4 bytes a pixel), for the in-game menu's DualSense drawing
+	ImTextureID GenerateTextureRGBA(const std::vector<uint8>& rgba, const Vector2i& size);
+private:
 	void DeleteTexture(ImTextureID id) override;
 	void DeleteFontTextures() override;
 	bool BeginFrame(bool mainWindow) override;
