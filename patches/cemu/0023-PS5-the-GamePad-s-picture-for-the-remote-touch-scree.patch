 src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp  | 11 ++++
 src/Cafe/HW/Latte/Renderer/Renderer.h         |  6 +++
 .../Latte/Renderer/Vulkan/VulkanRenderer.cpp  | 51 +++++++++++++------
 3 files changed, 53 insertions(+), 15 deletions(-)

diff --git a/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp b/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp
index acf2ed1..dff0c79 100644
--- a/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp
+++ b/src/Cafe/HW/Latte/Core/LatteRenderTarget.cpp
@@ -870,6 +870,8 @@ void LatteRenderTarget_getScreenImageArea(sint32* x, sint32* y, sint32* width, s
 bool PS5Cemu_SecondScreenInCorner(bool gamePadIsPrimary);
 void PS5Cemu_SetGamePadArea(bool visible, sint32 x, sint32 y, sint32 width, sint32 height);
 void PS5Cemu_RenderOverlay();
+// The remote touch screen (port/stream): whether a browser wants the GamePad's picture now
+bool PS5Cemu_StreamWantFrame();
 
 // The PS5 has one screen. It shows the TV or the GamePad whole, and can show the other one in its
 // bottom right corner, from the scan buffer that screen was last copied from.
@@ -1071,6 +1073,15 @@ void LatteRenderTarget_itHLECopyColorBufferToScanBuffer(MPTR colorBufferPtr, uin
 			s_ps5ScanBufferSource[screen] = {true, colorBufferPtr, colorBufferWidth, colorBufferHeight, colorBufferFormat, colorBufferPitch, colorBufferSwizzle, colorBufferTilemode};
 	}
 	s_ps5GamePadIsPrimary = showDRC;
+	// the remote touch screen: the GamePad's picture, whether or not the TV shows it, at most 30 times
+	// a second while a browser shows it (the port's port/stream: while none does, a call that reads a flag)
+	if ((renderTarget & RENDER_TARGET_DRC) && PS5Cemu_StreamWantFrame())
+	{
+		// a GamePad the TV does not show still needs the cache refresh the TV's picture gets
+		LatteTexture_UpdateDataToLatest(texView->baseTexture);
+		LatteTC_MarkTextureStillInUse(texView->baseTexture);
+		g_renderer->CaptureGamePadStream(texView);
+	}
 #endif
 	if ((renderTarget & RENDER_TARGET_DRC) && g_renderer->IsPadWindowActive())
 		LatteRenderTarget_copyToBackbuffer(texView, true);
diff --git a/src/Cafe/HW/Latte/Renderer/Renderer.h b/src/Cafe/HW/Latte/Renderer/Renderer.h
index fa77fd9..557519c 100644
--- a/src/Cafe/HW/Latte/Renderer/Renderer.h
+++ b/src/Cafe/HW/Latte/Renderer/Renderer.h
@@ -72,6 +72,12 @@ public:
 	void RequestScreenshot(ScreenshotSaveFunction onSaveScreenshot);
 	void CancelScreenshotRequest();
 
+#if defined(CEMU_PS5)
+	// the remote touch screen's GamePad picture: the screenshot's readback, sent to the port instead of
+	// saved, and leaving a screenshot asked for meanwhile alone
+	bool m_ps5StreamCapture = false;
+	void CaptureGamePadStream(LatteTextureView* view) { m_ps5StreamCapture = true; HandleScreenshotRequest(view, true); m_ps5StreamCapture = false; }
+#endif
 	virtual void HandleScreenshotRequest(LatteTextureView* texView, bool padView){}
 
 	virtual void DrawBackbufferQuad(LatteTextureView* texView, RendererOutputShader* shader, bool useLinearTexFilter,
diff --git a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
index 009f128..8d2d89c 100644
--- a/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
+++ b/src/Cafe/HW/Latte/Renderer/Vulkan/VulkanRenderer.cpp
