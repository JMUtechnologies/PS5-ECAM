 // cemuSubmitDraws, 300 as Cemu's own unless set). On the PS5 each submission costs the driver a copy
 // of its words and an AGC submission, and the GPU a reset of its state and a write-back of its caches
 uint32 PS5Cemu_SubmitDraws();
+// The remote touch screen (port/stream): the GamePad's picture, as RGB rows
+void PS5Cemu_StreamFrame(const uint8* rgb, int width, int height);
 #endif
 #include "Cafe/HW/Latte/Renderer/Vulkan/VulkanAPI.h"
 #include "Cafe/HW/Latte/Renderer/Vulkan/LatteTextureVk.h"
@@ -1027,26 +1029,35 @@ bool VulkanRenderer::IsPadWindowActive()
 
 void VulkanRenderer::HandleScreenshotRequest(LatteTextureView* texView, bool padView)
 {
-	if (!m_screenshot_requested && m_screenshot_state == ScreenshotState::None)
-		return;
-
-	if (IsSwapchainInfoValid(false))
+#if defined(CEMU_PS5)
+	if (!m_ps5StreamCapture)
+#endif
 	{
-		// we already took a pad view screenshow and want a main window screenshot
-		if (m_screenshot_state == ScreenshotState::Main && padView)
+		if (!m_screenshot_requested && m_screenshot_state == ScreenshotState::None)
 			return;
 
-		if (m_screenshot_state == ScreenshotState::Pad && !padView)
-			return;
+		if (IsSwapchainInfoValid(false))
+		{
+			// we already took a pad view screenshow and want a main window screenshot
+			if (m_screenshot_state == ScreenshotState::Main && padView)
+				return;
 
-		// remember which screenshot is left to take
-		if (m_screenshot_state == ScreenshotState::None)
-			m_screenshot_state = padView ? ScreenshotState::Main : ScreenshotState::Pad;
+			if (m_screenshot_state == ScreenshotState::Pad && !padView)
+				return;
+
+			// remember which screenshot is left to take
+			if (m_screenshot_state == ScreenshotState::None)
+				m_screenshot_state = padView ? ScreenshotState::Main : ScreenshotState::Pad;
+			else
+				m_screenshot_state = ScreenshotState::None;
+		}
 		else
 			m_screenshot_state = ScreenshotState::None;
 	}
-	else
-		m_screenshot_state = ScreenshotState::None;
+
+	// a GamePad picture for the remote touch screen can come while the game's render pass is still
+	// open: the copies and layout changes below are recorded outside it
+	draw_endRenderPass();
 
 	auto texViewVk = (LatteTextureViewVk*)texView;
 	auto baseImageTex = texViewVk->GetBaseImage();
@@ -1246,8 +1257,10 @@ void VulkanRenderer::HandleScreenshotRequest(LatteTextureView* texView, bool pad
 		barrier_image<TRANSFER_READ, TRANSFER_WRITE | IMAGE_WRITE>(baseImageTex, region.imageSubresource, baseImageTex->GetDefaultLayout());
 	}
 
+	barrier_bufferRange<TRANSFER_WRITE, HOST_READ>(buffer, 0, size);
+	const auto captureCommandBuffer = GetCurrentCommandBufferId();
 	SubmitCommandBuffer();
-	WaitCommandBufferFinished(GetCurrentCommandBufferId());
+	WaitCommandBufferFinished(captureCommandBuffer);
 
 	bool formatValid = true;
 
@@ -1273,9 +1286,10 @@ void VulkanRenderer::HandleScreenshotRequest(LatteTextureView* texView, bool pad
 		}
 		break;
 	case VK_FORMAT_R8G8B8_UNORM:
-		std::copy((uint8*)bufferPtr, (uint8*)bufferPtr + size, rgb_data.begin());
+		rgb_data.assign((uint8*)bufferPtr, (uint8*)bufferPtr + size);
 		break;
 	case VK_FORMAT_R8G8B8_SRGB:
+		rgb_data.resize(size);
 		std::transform((uint8*)bufferPtr, (uint8*)bufferPtr + size, rgb_data.begin(), SRGBComponentToRGB);
 		break;
 	default:
@@ -1293,7 +1307,14 @@ void VulkanRenderer::HandleScreenshotRequest(LatteTextureView* texView, bool pad
 		vkFreeMemory(m_logicalDevice, imageMemory, nullptr);
 
 	if (formatValid)
+	{
+#if defined(CEMU_PS5)
+		if (m_ps5StreamCapture)
+			PS5Cemu_StreamFrame(rgb_data.data(), width, height);
+		else
+#endif
 		SaveScreenshot(rgb_data, width, height, !padView);
+	}
 }
 
 static const float kQueuePriority = 1.0f;
