+	// PS5: a device's transfers run on two threads kept for it, one for its reads and one for the
+	// rest, in the order the game asks for them, instead of on a new thread each. A game polls its
+	// Skylanders portal or Infinity Base many times a second, and making and ending a thread for every
+	// poll ran the console's thread and memory budget down until the app crashed. Reads have their own
+	// thread because an Infinity Base or Toypad read waits for the answer to a write.
+	class TransferQueue
+	{
+	  public:
+		void Push(std::function<void()> job)
+		{
+			std::lock_guard lock(m_mutex);
+			m_jobs.push_back(std::move(job));
+			if (!m_started)
+			{
+				m_started = true;
+				std::thread([this] { Run(); }).detach();
+			}
+			m_wake.notify_one();
+		}
+
+	  private:
+		void Run()
+		{
+			SetThreadName("nsyshid");
+			std::unique_lock lock(m_mutex);
+			while (true)
+			{
+				m_wake.wait(lock, [this] { return !m_jobs.empty(); });
+				std::function<void()> job = std::move(m_jobs.front());
+				m_jobs.pop_front();
+				lock.unlock();
+				job();
+				lock.lock();
+			}
+		}
+
+		std::mutex m_mutex;
+		std::condition_variable m_wake;
+		std::deque<std::function<void()>> m_jobs;
+		bool m_started = false;
+	};
+
+	// The device's reads' thread, or the one for its other transfers. Kept for the rest of the
+	// process, as its thread waits on it.
+	TransferQueue& Transfers(const std::shared_ptr<Device>& device, bool reads)
+	{
+		static std::mutex s_mutex;
+		static std::map<std::pair<const Device*, bool>, std::unique_ptr<TransferQueue>> s_queues;
+		std::lock_guard lock(s_mutex);
+		std::unique_ptr<TransferQueue>& queue = s_queues[{device.get(), reads}];
+		if (!queue)
+			queue = std::make_unique<TransferQueue>();
+		return *queue;
+	}
+
+	// A synchronous transfer on the device's thread: the PPC thread waits on the event the transfer
+	// signals, then takes its result
+	sint32 TransferAndWait(const std::shared_ptr<Device>& device, bool reads,
+						   std::function<sint32(coreinit::OSEvent*)> transfer)
+	{
+		StackAllocator<coreinit::OSEvent> event;
+		coreinit::OSInitEvent(&event, coreinit::OSEvent::EVENT_STATE::STATE_NOT_SIGNALED, coreinit::OSEvent::EVENT_MODE::MODE_AUTO);
+		auto result = std::make_shared<std::promise<sint32>>();
+		std::future<sint32> done = result->get_future();
+		coreinit::OSEvent* signal = &event;
+		Transfers(device, reads).Push([transfer = std::move(transfer), result, signal] { result->set_value(transfer(signal)); });
+		coreinit::OSWaitEvent(&event);
+		return done.get();
+	}
+
