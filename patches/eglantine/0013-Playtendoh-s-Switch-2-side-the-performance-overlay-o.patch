+float glyph_texel(int glyph, int x, int y)
+{
+    x = clamp(x, 0, kGlyphWidth - 1);
+    y = clamp(y, 0, kGlyphHeight - 1);
+    int at = y * kGlyphWidth + x;
+    return float((glyph_word(glyph, at >> 3) >> uint((at & 7) * 4)) & 0xfu) / 15.0;
