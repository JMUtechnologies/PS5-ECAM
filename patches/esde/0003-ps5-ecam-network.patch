+namespace
+{
+    // PS5 (PS5-ECAM): each socket curl opens is made non-blocking by the console's own option,
+    // SO_NBIO, as the app's own downloads are (its port/ps5/curl_socket.h): a title is refused
+    // fcntl's O_NONBLOCK, and a blocking socket waits for the server to close it.
+    int ps5SocketOptions(void*, curl_socket_t socket, curlsocktype)
+    {
+        const int on {1};
+        setsockopt(socket, SOL_SOCKET, 0x1200, &on, sizeof(on));
+        return CURL_SOCKOPT_OK;
+    }
+} // namespace
