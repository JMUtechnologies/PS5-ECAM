#: port/app/ingame3ds.cpp:558 port/app/ingame3ds.cpp:566
#, menu
msgid "The screen filter and the performance overlay."
msgstr "Το φίλτρο οθόνης και η ένδειξη απόδοσης."

#: port/app/ingame3ds.cpp:559 port/app/ingame3ds.cpp:567 port/frontend/shell/porpoise_rows.cpp:110 port/frontend/shell/porpoise_rows.cpp:387 port/frontend/shell/porpoise_rows.cpp:399 port/frontend/shell/porpoise_rows.cpp:411 port/frontend/shell/porpoise_rows.cpp:423 port/frontend/shell/settings.cpp:815
#, menu
msgid "Screen filter"
msgstr "Φίλτρο οθόνης"

#: port/app/ingame3ds.cpp:560
#, menu
msgid "How the game's picture is scaled to the TV. Sharp keeps every pixel square and even; Smooth blurs them together; Square pixels takes the nearest, uneven at most sizes."
msgstr "Πώς κλιμακώνεται η εικόνα του παιχνιδιού στην τηλεόραση. Το Ευκρινές κρατά κάθε pixel τετράγωνο και ομοιόμορφο· το Απαλό τα θολώνει μεταξύ τους· τα Τετράγωνα pixel παίρνουν το πλησιέστερο, ανομοιόμορφα στα περισσότερα μεγέθη."

#: port/app/ingame3ds.cpp:563 port/app/ingame3ds.cpp:571 port/app/ingame3ds.cpp:584 port/frontend/shell/settings.cpp:727 port/frontend/shell/settings.cpp:728 port/frontend/shell/settings.cpp:810 port/frontend/shell/settings.cpp:811 port/frontend/shell/settings.cpp:828 port/frontend/shell/settings.cpp:829
