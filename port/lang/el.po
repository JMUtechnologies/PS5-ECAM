msgid "Green"
msgstr "Πράσινο"

#: port/frontend/shell/porpoise_rows.cpp:287 port/frontend/shell/porpoise_rows.cpp:289 port/frontend/shell/porpoise_rows.cpp:291 port/frontend/shell/porpoise_rows.cpp:293
msgid "Pink"
msgstr "Ροζ"

