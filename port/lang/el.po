msgstr "Κουμπιά γρήγορης αποθήκευσης"

#: port/frontend/shell/porpoise_rows.cpp:278
msgid "Touchpad + L1 saves to this slot and touchpad + L2 loads it."
msgstr "Το Touchpad + L1 αποθηκεύει σε αυτήν την υποδοχή και το touchpad + L2 το φορτώνει."

