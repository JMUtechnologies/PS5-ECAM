msgid "Turbo button"
msgstr "Κουμπί turbo"

#: port/frontend/shell/porpoise_rows.cpp:280
msgid "While held, this button presses again and again by itself."
msgstr "Ενώ κρατάτε πατημένο, αυτό το κουμπί πατάει ξανά και ξανά μόνο του."

