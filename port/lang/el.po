#: port/frontend/shell/porpoise_rows.cpp:236
msgid "The GBA game loaded at start, from games/gba/port4. None: BIOS only."
msgstr "Το παιχνίδι GBA φορτώθηκε στην αρχή, από το games/gba/port4. Κανένα: BIOS μόνο."

