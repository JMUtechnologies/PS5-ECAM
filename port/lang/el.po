msgstr "Κουμπιά γρήγορης προώθησης"

#: port/frontend/shell/porpoise_rows.cpp:276
msgid "Touchpad + R1 steps fast forward; touchpad + R2 fast-forwards while held."
msgstr "Touchpad + R1 κάνει βήματα προς τα εμπρός. touchpad + R2 γρήγορη κίνηση προς τα εμπρός ενώ κρατιέται."

#: port/frontend/shell/porpoise_rows.cpp:278
