msgstr "Απότομη διγραμμική"

#: port/frontend/shell/porpoise_rows.cpp:183
msgid "Area sampling"
msgstr "Δειγματοληψία περιοχής"

#: port/frontend/shell/porpoise_rows.cpp:185
msgid "Per-pixel lighting"
msgstr "Φωτισμός ανά pixel"

#: port/frontend/shell/porpoise_rows.cpp:185
msgid "Smoother lighting on surfaces. A little heavier."
msgstr "Ομαλός φωτισμός σε επιφάνειες. Λίγο πιο βαρύ."

#: port/frontend/shell/porpoise_rows.cpp:187
msgid "Disable fog"
msgstr "Απενεργοποιήστε την ομίχλη"

#: port/frontend/shell/porpoise_rows.cpp:187
msgid "Removes distance fog. Some games use fog for their look."
msgstr "Αφαιρεί την ομίχλη από απόσταση. Ορισμένα παιχνίδια χρησιμοποιούν ομίχλη για την εμφάνισή τους."

#: port/frontend/shell/porpoise_rows.cpp:189
msgid "Bloom"
msgstr "Bloom"

#: port/frontend/shell/porpoise_rows.cpp:189
msgid "Dolphin's graphics mod for this game's glow. Applies the next time it starts."
msgstr "Το mod γραφικών του Dolphin για τη λάμψη αυτού του παιχνιδιού. Εφαρμόζεται την επόμενη φορά που θα ξεκινήσει."

#: port/frontend/shell/porpoise_rows.cpp:190 port/frontend/shell/porpoise_rows.cpp:192
msgid "Blurred"
msgstr "Θολή"

#: port/frontend/shell/porpoise_rows.cpp:190 port/frontend/shell/porpoise_rows.cpp:192
msgid "Native resolution"
msgstr "Εγγενής ανάλυση"

#: port/frontend/shell/porpoise_rows.cpp:191
msgid "Depth of field"
msgstr "Βάθος πεδίου"

#: port/frontend/shell/porpoise_rows.cpp:191
msgid "Dolphin's graphics mod for the blur on faraway things. Applies the next time it starts."
msgstr "Το mod γραφικών του Dolphin για τη θαμπάδα σε μακρινά πράγματα. Εφαρμόζεται την επόμενη φορά που θα ξεκινήσει."

#: port/frontend/shell/porpoise_rows.cpp:193
msgid "Hide the HUD"
msgstr "Απόκρυψη του HUD"

#: port/frontend/shell/porpoise_rows.cpp:193
msgid "Hides the game's HUD, for clean screenshots. Applies the next time it starts."
msgstr "Κρύβει το HUD του παιχνιδιού, για καθαρά στιγμιότυπα οθόνης. Εφαρμόζεται την επόμενη φορά που θα ξεκινήσει."

#: port/frontend/shell/porpoise_rows.cpp:194
msgid "Native resolution goop"
msgstr "Εγγενής ανάλυση goop"

#: port/frontend/shell/porpoise_rows.cpp:194
