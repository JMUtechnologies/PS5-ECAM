msgid "Safe"
msgstr "Ασφαλής"

#: port/frontend/shell/porpoise_rows.cpp:158
msgid "Crop overscan"
msgstr "Υπερσάρωση περικοπής"

#: port/frontend/shell/porpoise_rows.cpp:158
msgid "Hides the black borders some games draw at the edges."
msgstr "Κρύβει τα μαύρα περιγράμματα μερικά παιχνίδια σχεδιάζουν στις άκρες."

#: port/frontend/shell/porpoise_rows.cpp:160
msgid "Crop left"
msgstr "Περικοπή αριστερά"

#: port/frontend/shell/porpoise_rows.cpp:160
msgid "Trims the left edge of the picture."
msgstr "Κόβει το αριστερό άκρο της εικόνας."

#: port/frontend/shell/porpoise_rows.cpp:162
msgid "Crop right"
msgstr "Περικοπή δεξιά"

#: port/frontend/shell/porpoise_rows.cpp:162
msgid "Trims the right edge of the picture."
msgstr "Κόβει τη δεξιά άκρη της εικόνας."

#: port/frontend/shell/porpoise_rows.cpp:164
msgid "Crop top"
msgstr "Crop top"

#: port/frontend/shell/porpoise_rows.cpp:164
msgid "Trims the top edge of the picture."
msgstr "Κόβει το επάνω άκρο της εικόνας."

#: port/frontend/shell/porpoise_rows.cpp:166
msgid "Crop bottom"
msgstr "Περικοπή πάτου"

#: port/frontend/shell/porpoise_rows.cpp:166
msgid "Trims the bottom edge of the picture."
msgstr "Κόβει το κάτω άκρο της εικόνας."

#: port/frontend/shell/porpoise_rows.cpp:168
msgid "Skip duplicate frames"
msgstr "Παράλειψη διπλότυπων καρέ"

#: port/frontend/shell/porpoise_rows.cpp:168
msgid "Saves work when a game shows the same frame twice."
msgstr "Αποθηκεύει την εργασία όταν ένα παιχνίδι εμφανίζει το ίδιο καρέ δύο φορές."

#: port/frontend/shell/porpoise_rows.cpp:170
msgid "Anisotropic filtering"
msgstr "Ανισότροπο φιλτράρισμα"

#: port/frontend/shell/porpoise_rows.cpp:170
msgid "Sharper textures on floors and walls seen at an angle."
msgstr "Πιο έντονες υφές σε δάπεδα και τοίχους φαίνονται υπό γωνία."

#: port/frontend/shell/porpoise_rows.cpp:172
msgid "Extra bloom"
msgstr "Επιπλέον άνθιση"

#: port/frontend/shell/porpoise_rows.cpp:172
msgid "A soft glow around the brightest parts of the picture, on top of the game's own."
msgstr "Μια απαλή λάμψη γύρω από τα πιο φωτεινά μέρη της εικόνας, πάνω από τα δικά του παιχνιδιού."

#: port/frontend/shell/porpoise_rows.cpp:173 port/frontend/shell/porpoise_rows.cpp:273 port/frontend/shell/porpoise_rows.cpp:323
msgid "Low"
msgstr "Χαμηλό"

#: port/frontend/shell/porpoise_rows.cpp:173 port/frontend/shell/porpoise_rows.cpp:275
msgid "Medium"
msgstr "Μεσαίο"

#: port/frontend/shell/porpoise_rows.cpp:173
msgid "High"
msgstr "Ψηλά"

#: port/frontend/shell/porpoise_rows.cpp:174
msgid "Saturation"
msgstr "Κορεσμός"

#: port/frontend/shell/porpoise_rows.cpp:174
msgid "How rich the colours are. 0 is as the game has them."
msgstr "Πόσο πλούσια είναι τα χρώματα. Το 0 είναι όπως τα έχει το παιχνίδι."

#: port/frontend/shell/porpoise_rows.cpp:176
msgid "Contrast"
msgstr "Αντίθεση"

#: port/frontend/shell/porpoise_rows.cpp:176
msgid "How far apart the darks and the lights are. 0 is as the game has them."
msgstr "Πόσο μακριά είναι τα σκοτάδια και τα φώτα. Το 0 είναι όπως τα έχει το παιχνίδι."

#: port/frontend/shell/porpoise_rows.cpp:178
msgid "Warmth"
msgstr "Ζεστασιά"

#: port/frontend/shell/porpoise_rows.cpp:178
msgid "Warmer (more red) or cooler (more blue). 0 is as the game has it."
msgstr "Πιο ζεστό (πιο κόκκινο) ή πιο ψυχρό (πιο μπλε). Το 0 είναι όπως το έχει το παιχνίδι."

#: port/frontend/shell/porpoise_rows.cpp:180
msgid "Texture filtering"
msgstr "Φιλτράρισμα υφής"

#: port/frontend/shell/porpoise_rows.cpp:180
msgid "Force sharp or smooth textures, or leave it to the game."
msgstr "Επιβάλετε αιχμηρές ή λείες υφές ή αφήστε το στο παιχνίδι."

#: port/frontend/shell/porpoise_rows.cpp:181 port/frontend/shell/porpoise_rows.cpp:190 port/frontend/shell/porpoise_rows.cpp:192
msgid "The game's own"
msgstr "Το παιχνίδι είναι δικό του"

#: port/frontend/shell/porpoise_rows.cpp:181
msgid "Nearest (sharp)"
msgstr "Πλησιέστερο (απότομη)"

#: port/frontend/shell/porpoise_rows.cpp:181
msgid "Linear (smooth)"
msgstr "Γραμμικό (ομαλό)"

#: port/frontend/shell/porpoise_rows.cpp:182
msgid "Output resampling"
msgstr "Επαναδειγματοληψία εξόδου"

#: port/frontend/shell/porpoise_rows.cpp:182
msgid "How Dolphin scales its picture. Sharp bilinear keeps pixels crisp."
msgstr "Πώς το Dolphin κλιμακώνει την εικόνα του. Το Sharp bilinear διατηρεί τα pixel καθαρά."

