#: port/frontend/shell/porpoise_rows.cpp:336 port/frontend/shell/settings.cpp:57
msgid "Chinese (traditional)"
msgstr "Κινεζικά (παραδοσιακά)"

#: port/frontend/shell/porpoise_rows.cpp:336 port/frontend/shell/settings.cpp:56
msgid "Korean"
msgstr "Κορεατικά"

#: port/frontend/shell/porpoise_rows.cpp:338
msgid "Fast save states"
msgstr "Καταστάσεις γρήγορης αποθήκευσης"

#: port/frontend/shell/porpoise_rows.cpp:338
msgid "Quicker and smaller states. Turn it off if a game looks wrong after loading one."
msgstr "Γρήγορες και μικρότερες πολιτείες. Απενεργοποιήστε το εάν ένα παιχνίδι φαίνεται λάθος μετά τη φόρτωση ενός."

