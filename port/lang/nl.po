msgstr "Snijdt de linkerrand van het beeld bij."

#: port/frontend/shell/porpoise_rows.cpp:154
msgid "Crop right"
msgstr "Rechts bijsnijden"

#: port/frontend/shell/porpoise_rows.cpp:154
msgid "Trims the right edge of the picture."
msgstr "Snijdt de rechterrand van het beeld bij."

#: port/frontend/shell/porpoise_rows.cpp:156
msgid "Crop top"
msgstr "Boven bijsnijden"

#: port/frontend/shell/porpoise_rows.cpp:156
msgid "Trims the top edge of the picture."
msgstr "Snijdt de bovenrand van het beeld bij."

#: port/frontend/shell/porpoise_rows.cpp:158
msgid "Crop bottom"
msgstr "Onder bijsnijden"

#: port/frontend/shell/porpoise_rows.cpp:158
