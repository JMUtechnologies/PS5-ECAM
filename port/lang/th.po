msgstr "ปิดการใช้งานหมอก"

#: port/frontend/shell/porpoise_rows.cpp:179
msgid "Removes distance fog. Some games use fog for their look."
msgstr "กำจัดหมอกระยะไกล เกมบางเกมใช้หมอกเพื่อรูปลักษณ์"

#: port/frontend/shell/porpoise_rows.cpp:181
msgid "Bloom"
msgstr "บลูม"

#: port/frontend/shell/porpoise_rows.cpp:181
msgid "A graphics mod for this game's glow. Applies next time it starts."
msgstr "ม็อดกราฟิกเพื่อความเปล่งประกายของเกมนี้ ใช้ครั้งต่อไปที่เริ่มต้น"

#: port/frontend/shell/porpoise_rows.cpp:182 port/frontend/shell/porpoise_rows.cpp:184
msgid "Blurred"
msgstr "เบลอ"

#: port/frontend/shell/porpoise_rows.cpp:182 port/frontend/shell/porpoise_rows.cpp:184
msgid "Native resolution"
msgstr "ความละเอียดดั้งเดิม"

#: port/frontend/shell/porpoise_rows.cpp:183
msgid "Depth of field"
msgstr "ความชัดลึก"

#: port/frontend/shell/porpoise_rows.cpp:183
msgid "A graphics mod for the blur on faraway things. Applies next time it starts."
msgstr "ม็อดกราฟิกสำหรับการเบลอสิ่งที่อยู่ห่างไกล ใช้ครั้งต่อไปที่เริ่มต้น"

#: port/frontend/shell/porpoise_rows.cpp:185
