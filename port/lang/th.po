#: port/frontend/shell/porpoise_rows.cpp:173
msgid "Nearest (sharp)"
msgstr "ใกล้ที่สุด (คม)"

#: port/frontend/shell/porpoise_rows.cpp:173
msgid "Linear (smooth)"
msgstr "เชิงเส้น (เรียบ)"

#: port/frontend/shell/porpoise_rows.cpp:174
msgid "Output resampling"
msgstr "การสุ่มตัวอย่างเอาต์พุต"

#: port/frontend/shell/porpoise_rows.cpp:174
msgid "How the picture is scaled. Sharp bilinear keeps pixels crisp."
msgstr "วิธีการปรับขนาดภาพ ไบลิเนียร์ที่คมชัดช่วยให้พิกเซลคมชัด"

