msgid_plural "Done: {0} files"
msgstr[0] "Valmis: {0} tiedosto"
msgstr[1] "Valmis: {0} tiedostoa"

#. a backup of the saves, as it copies ({0}: a percentage)
#: port/frontend/shell/settings.cpp:1334 port/frontend/shell/settings.cpp:1347 port/frontend/shell/settings.cpp:2061 port/frontend/shell/settings.cpp:2080
