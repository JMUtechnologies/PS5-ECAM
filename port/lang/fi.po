msgid "Fast disc loading"
msgstr "Nopea levyn lataus"

#: port/frontend/shell/porpoise_rows.cpp:358
msgid "Shorter loading screens. A few games need real disc speed."
msgstr "Lyhyemmät latausnäytöt. Jotkut pelit vaativat todellista levynopeutta."

#: port/frontend/shell/porpoise_rows.cpp:360
msgid "Cheat codes, for games that have them."
msgstr "Huijauskoodit peleille, joissa niitä on."

