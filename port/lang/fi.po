#: port/app/accounts.cpp:68 port/frontend/shell/settings.cpp:1784
msgid "The Wii U has twelve accounts at most."
msgstr "Wii U:ssa voi olla enintään kaksitoista tiliä."

#: port/app/accounts.cpp:104
msgid "The last account cannot be deleted."
msgstr "Viimeistä tiliä ei voi poistaa."

