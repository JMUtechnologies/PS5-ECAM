#: port/app/ingame.cpp:192
#, menu
msgid "Picture"
msgstr "Imagem"

#: port/app/ingame.cpp:192
#, menu
msgid "Its own shape"
msgstr "Formato original"

#: port/app/ingame.cpp:193
#, menu
msgid "Its own shape keeps the picture's proportions, with bars where they differ from the screen's; Stretched fills it."
msgstr "O formato original mantém as proporções da imagem, com faixas onde elas diferem das da tela; Esticada preenche tudo."

#: port/app/ingame.cpp:195 port/app/ingame3ds.cpp:466 port/app/ingame3ds.cpp:475 port/frontend/shell/settings.cpp:180
#, menu
msgid "Graphics"
msgstr "Gráficos"

#: port/app/ingame.cpp:196
#, menu
msgid "Upscaling, Cemu's accuracy settings and the performance overlay. Kept for the next games."
msgstr "Escala, ajustes de precisão do Cemu e o indicador de desempenho. Valem para os próximos jogos."

#: port/app/ingame.cpp:197 port/frontend/shell/settings.cpp:363
#, menu
msgid "Upscaling to 4K"
msgstr "Escala para 4K"

#: port/app/ingame.cpp:198
#, menu
msgid "How the picture is scaled to the screen: Bicubic is sharp, Hermite softer, Bilinear softer still."
msgstr "Como a imagem é ajustada à tela: Bicúbico é nítido, Hermite mais suave, Bilinear mais suave ainda."

#: port/app/ingame.cpp:199
#, menu
msgid "Accurate barriers"
msgstr "Barreiras precisas"

#: port/app/ingame.cpp:200
#, menu
msgid "Off can raise the frame rate, but some games then flicker or show wrong shadows. It changes at once."
msgstr "Desativado pode aumentar a taxa de quadros, mas alguns jogos passam a piscar ou a mostrar sombras erradas. Vale na hora."

#: port/app/ingame.cpp:201 port/frontend/shell/settings.cpp:386
#, menu
msgid "Async shader compile"
msgstr "Compilação assíncrona de shaders"

#: port/app/ingame.cpp:202
#, menu
msgid "On, new shaders build while the game carries on: no stutter, but things may be missing for a moment."
msgstr "Ativado, os shaders novos são compilados enquanto o jogo continua: sem engasgos, mas algo pode faltar por um instante."

#: port/app/ingame.cpp:203 port/frontend/shell/settings.cpp:374
#, menu
msgid "Frame pacing"
msgstr "Ritmo de quadros"

#: port/app/ingame.cpp:204
#, menu
msgid "Holds the game to an even rate: 60 fps for 4K at 120 Hz, 30 for 8K at 60 Hz. Off shows each frame when it is done."
msgstr "Mantém o jogo em um ritmo constante: 60 fps em 4K a 120 Hz, 30 em 8K a 60 Hz. Desativado mostra cada quadro assim que fica pronto."

#: port/app/ingame.cpp:205 port/app/ingame3ds.cpp:470 port/app/ingame3ds.cpp:481 port/frontend/shell/settings.cpp:380
#, menu
msgid "Performance overlay"
msgstr "Indicador de desempenho"

#: port/app/ingame.cpp:206
#, menu
msgid "Frames per second, CPU and memory use in the top left corner, as Cemu shows them."
msgstr "Quadros por segundo, uso de CPU e de memória no canto superior esquerdo, como o Cemu mostra."

#: port/app/ingame.cpp:207 port/frontend/shell/settings.cpp:383
#, menu
msgid "Shader notices"
msgstr "Avisos de shaders"

#: port/app/ingame.cpp:208
#, menu
msgid "Cemu's notes in a corner while the game builds shaders. Off hides them; they are built either way."
msgstr "Os avisos do Cemu num canto enquanto o jogo compila shaders. Desativado os esconde; eles são compilados do mesmo jeito."

#: port/app/ingame.cpp:221 port/app/ingame.cpp:251
#, menu
msgid "{0} (next start)"
msgstr "{0} (próxima inicialização)"

#: port/app/ingame.cpp:222
#, menu
msgid "This pack replaces textures: the game shows the change when it starts again."
msgstr "Este pacote substitui texturas: o jogo mostra a mudança quando for iniciado de novo."

#: port/app/ingame.cpp:223
#, menu
msgid "Cross turns it on or off; the game shows it at once."
msgstr "Cruz ativa ou desativa; o jogo mostra na hora."

#: port/app/ingame.cpp:231 port/frontend/shell/pages.cpp:279 port/frontend/shell/pages.cpp:368
#, menu
msgid "Preset"
msgstr "Predefinição"

#: port/app/ingame.cpp:233
#, menu
msgid "Left and Right choose another; the game shows it at once."
msgstr "Esquerda e Direita escolhem outra; o jogo mostra na hora."

#: port/app/ingame.cpp:237
#, menu
msgid "None for this game"
msgstr "Nenhum para este jogo"

#: port/app/ingame.cpp:237
#, menu
msgid "Reading the packs…"
msgstr "Lendo os pacotes…"

#: port/app/ingame.cpp:238
#, menu
msgid "The community graphic packs have none for this game."
msgstr "Os pacotes gráficos da comunidade não têm nenhum para este jogo."

