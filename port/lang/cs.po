#: port/app/ingame.cpp:227
#, menu
msgid "Upscaling, accuracy and the performance overlay. Applies to all games."
msgstr "Zvětšování, nastavení přesnosti Cemu a překryv výkonu. Platí i pro další hry."

#: port/app/ingame.cpp:228 port/eden/ingame.cpp:564 port/frontend/shell/settings.cpp:679 port/frontend/shell/settings.cpp:777
#, menu
msgid "Upscaling to 4K"
msgstr "Zvětšování na 4K"

#: port/app/ingame.cpp:229
#, menu
msgid "Bicubic is sharpest, Hermite softer, Bilinear softest."
msgstr "Jak se obraz zvětšuje na obrazovku: Bikubický je ostrý, Hermite měkčí, Bilineární ještě měkčí."

#: port/app/ingame.cpp:230
#, menu
msgid "Accurate barriers"
msgstr "Přesné bariéry"

#: port/app/ingame.cpp:231
#, menu
msgid "Off can raise the frame rate, but some games may flicker or show wrong shadows."
msgstr "Vypnutí může zvýšit snímkovou frekvenci, ale některé hry pak blikají nebo ukazují špatné stíny. Platí hned."

#: port/app/ingame.cpp:232 port/frontend/shell/settings.cpp:716 port/frontend/shell/settings.cpp:754 port/frontend/shell/settings.cpp:1075
#, menu
msgid "Async shader compile"
msgstr "Asynchronní kompilace shaderů"

#: port/app/ingame.cpp:233
#, menu
msgid "Builds shaders in the background. Less stutter, but some things may appear late."
msgstr "Zapnuto: nové shadery se sestavují, zatímco hra běží dál. Bez záseků, ale něco může na chvíli chybět."

#: port/app/ingame.cpp:234 port/frontend/shell/settings.cpp:697
#, menu
msgid "Frame pacing"
msgstr "Rovnoměrné snímky"

#: port/app/ingame.cpp:235
#, menu
msgid "Keeps the frame rate steady (60 fps at 4K 120 Hz, 30 at 8K 60 Hz). Off shows each frame when ready."
msgstr "Drží hru v rovnoměrném tempu: 60 fps pro 4K při 120 Hz, 30 pro 8K při 60 Hz. Vypnuto zobrazí každý snímek, jakmile je hotový."

#: port/app/ingame.cpp:236 port/app/ingame3ds.cpp:679 port/eden/ingame.cpp:574 port/frontend/shell/porpoise_rows.cpp:117 port/frontend/shell/settings.cpp:687 port/frontend/shell/settings.cpp:701 port/frontend/shell/settings.cpp:758 port/frontend/shell/settings.cpp:815 port/frontend/shell/settings.cpp:830
#, menu
msgid "Frame generation"
msgstr "Generování snímků"

#: port/app/ingame.cpp:237 port/app/ingame3ds.cpp:680 port/eden/ingame.cpp:575
#, menu
msgid "Adds a frame between each pair, so 30 fps games play at 60."
msgstr "Snímek vytvořený mezi každými dvěma snímky hry ve 30 fps, takže se ukazuje v 60. Změní se hned."

#: port/app/ingame.cpp:238 port/frontend/shell/settings.cpp:706 port/frontend/shell/switch_extras.cpp:72
