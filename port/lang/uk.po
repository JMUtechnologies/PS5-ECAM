#: port/frontend/shell/setup.cpp:211 port/frontend/shell/setup.cpp:224 port/frontend/shell/setup.cpp:255
msgid "How to"
msgstr "Як це зробити"

#: port/frontend/shell/setup.cpp:212
msgid "Keys for encrypted discs"
msgstr "Ключі для зашифрованих дисків"

#: port/frontend/shell/setup.cpp:213
msgid "Encrypted .wud and .wux dumps need their disc keys in {0}/keys.txt, one a line. Decrypted dumps, .wua files and folders with code, content and meta need none."
msgstr "Зашифрованим дампам .wud і .wux потрібні ключі їхніх дисків у {0}/keys.txt, по одному в рядку. Розшифрованим дампам, файлам .wua і текам із code, content і meta вони не потрібні."

#: port/frontend/shell/setup.cpp:221
msgid "3DS keys"
