msgid "Default"
msgstr "Predefinito"

#: port/frontend/shell/porpoise_rows.cpp:175
msgid "Sharp bilinear"
msgstr "Bilineare nitido"

#: port/frontend/shell/porpoise_rows.cpp:175
msgid "Area sampling"
msgstr "Campionamento ad area"

#: port/frontend/shell/porpoise_rows.cpp:177
msgid "Per-pixel lighting"
msgstr "Illuminazione per pixel"

#: port/frontend/shell/porpoise_rows.cpp:177
msgid "Smoother lighting on surfaces. A little heavier."
msgstr "Illuminazione più morbida sulle superfici. Un po' più pesante."

#: port/frontend/shell/porpoise_rows.cpp:179
msgid "Disable fog"
msgstr "Disattiva la nebbia"

#: port/frontend/shell/porpoise_rows.cpp:179
msgid "Removes distance fog. Some games use fog for their look."
msgstr "Rimuove la nebbia in lontananza. Alcuni giochi la usano per il loro stile."

#: port/frontend/shell/porpoise_rows.cpp:181
msgid "Bloom"
msgstr "Bagliore"

#: port/frontend/shell/porpoise_rows.cpp:181
msgid "A graphics mod for this game's glow. Applies next time it starts."
msgstr "La mod grafica di Dolphin per il bagliore di questo gioco. Si applica al prossimo avvio."

#: port/frontend/shell/porpoise_rows.cpp:182 port/frontend/shell/porpoise_rows.cpp:184
msgid "Blurred"
msgstr "Sfocato"

#: port/frontend/shell/porpoise_rows.cpp:182 port/frontend/shell/porpoise_rows.cpp:184
msgid "Native resolution"
msgstr "Risoluzione nativa"

#: port/frontend/shell/porpoise_rows.cpp:183
msgid "Depth of field"
msgstr "Profondità di campo"

#: port/frontend/shell/porpoise_rows.cpp:183
msgid "A graphics mod for the blur on faraway things. Applies next time it starts."
msgstr "La mod grafica di Dolphin per la sfocatura degli oggetti lontani. Si applica al prossimo avvio."

#: port/frontend/shell/porpoise_rows.cpp:185
msgid "Hide the HUD"
msgstr "Nascondi l'HUD"

#: port/frontend/shell/porpoise_rows.cpp:185
msgid "Hides the game's HUD, for clean screenshots. Applies the next time it starts."
msgstr "Nasconde l'HUD del gioco, per screenshot puliti. Si applica al prossimo avvio."

#: port/frontend/shell/porpoise_rows.cpp:186
msgid "Native resolution goop"
msgstr "Melma a risoluzione nativa"

#: port/frontend/shell/porpoise_rows.cpp:186
msgid "Super Mario Sunshine's goop at the game's own resolution. Applies the next time it starts."
msgstr "La melma di Super Mario Sunshine alla risoluzione propria del gioco. Si applica al prossimo avvio."

#: port/frontend/shell/porpoise_rows.cpp:187 port/frontend/shell/settings.cpp:731 port/frontend/shell/settings.cpp:738
msgid "Custom textures"
msgstr "Texture personalizzate"

#: port/frontend/shell/porpoise_rows.cpp:187
msgid "Loads HD texture packs."
msgstr "Carica i pacchetti di texture HD."

#: port/frontend/shell/porpoise_rows.cpp:188
msgid "Loads HD texture packs. Put each pack's folder, named with the game's ID (like GALE01), in /data/porpoise/saves/User/Load/Textures."
msgstr "Carica i pacchetti di texture HD. Metti la cartella di ogni pacchetto, con l'ID del gioco come nome (come GALE01), in /data/porpoise/saves/User/Load/Textures."

#: port/frontend/shell/porpoise_rows.cpp:190 port/frontend/shell/porpoise_rows.cpp:202 port/frontend/shell/porpoise_rows.cpp:214 port/frontend/shell/porpoise_rows.cpp:226
msgid "Device"
msgstr "Dispositivo"

#: port/frontend/shell/porpoise_rows.cpp:190 port/frontend/shell/porpoise_rows.cpp:202 port/frontend/shell/porpoise_rows.cpp:214 port/frontend/shell/porpoise_rows.cpp:226
msgid "What's plugged into this controller port."
msgstr "Cosa c'è in questa porta controller del GameCube."

#: port/frontend/shell/porpoise_rows.cpp:191 port/frontend/shell/porpoise_rows.cpp:203 port/frontend/shell/porpoise_rows.cpp:215 port/frontend/shell/porpoise_rows.cpp:227
msgid "What's plugged into this controller port. GBA (Integrated) is a Game Boy Advance on the link cable, for games like Four Swords Adventures. It needs the GBA BIOS at /data/porpoise/saves/User/GBA/gba_bios.bin. Best set per game."
msgstr "Cosa c'è in questa porta controller del GameCube. GBA (integrato) è un Game Boy Advance sul cavo Link, per il Tingle Tuner di Wind Waker e Four Swords Adventures. Richiede il BIOS del GBA come /data/porpoise/saves/User/GBA/gba_bios.bin. Meglio impostarlo per un solo gioco."

#: port/frontend/shell/porpoise_rows.cpp:192 port/frontend/shell/porpoise_rows.cpp:204 port/frontend/shell/porpoise_rows.cpp:216 port/frontend/shell/porpoise_rows.cpp:228 port/frontend/shell/porpoise_rows.cpp:1162
