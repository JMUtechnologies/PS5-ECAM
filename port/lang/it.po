msgid_plural "{1}: {2}, {0} games"
msgstr[0] "{1}: {2}, {0} gioco"
msgstr[1] "{1}: {2}, {0} giochi"

#: port/frontend/shell/settings.cpp:2054
msgid "Nothing played yet. Play time shows here and on each game's page."
msgstr "Ancora niente di giocato. Il tempo di un gioco conta dall’avvio alla fine, e appare qui e sulla sua pagina."

#. Settings > Play time: every side's play time added up
#: port/frontend/shell/settings.cpp:2057
