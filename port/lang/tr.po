#: port/app/ingame.cpp:220 port/frontend/shell/settings.cpp:644
#, menu
msgid "Frame pacing"
msgstr "Düzenli kare akışı"

#: port/app/ingame.cpp:221
#, menu
msgid "Keeps the frame rate steady (60 fps at 4K 120 Hz, 30 at 8K 60 Hz). Off shows each frame when ready."
msgstr "Oyunu düzenli bir hızda tutar: 120 Hz’de 4K için 60 fps, 60 Hz’de 8K için 30. Kapalıyken her kare hazır olur olmaz gösterilir."

#: port/app/ingame.cpp:222 port/app/ingame3ds.cpp:610 port/eden/ingame.cpp:626 port/frontend/shell/porpoise_rows.cpp:117 port/frontend/shell/settings.cpp:634 port/frontend/shell/settings.cpp:648 port/frontend/shell/settings.cpp:705 port/frontend/shell/settings.cpp:762 port/frontend/shell/settings.cpp:777
