msgstr "DS, GameCube, Wii, N64, SNES, NES, Game Boy, Virtual Boy, Pokémon mini oyunlarında başarılar kazanın. PS5'de yalnızca bir oturum açma belirteci tutulur, parolanız asla saklanır. Durumları kaydetme, hileler ve hız hala çalışıyor."

#: port/frontend/shell/settings.cpp:1405
msgid "{1} · {0} point"
msgid_plural "{1} · {0} points"
msgstr[0] "{1} · {0} puan"
msgstr[1] "{1} · {0} puan"

#: port/frontend/shell/settings.cpp:1405
