msgstr "Hvor høyt startprogrammets musikk spiller. Venstre og høyre endrer den med 10 %."

#: port/frontend/shell/settings.cpp:1592
msgid "Menu sounds"
msgstr "Menylyder"

#: port/frontend/shell/settings.cpp:1592
