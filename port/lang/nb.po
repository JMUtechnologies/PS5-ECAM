msgstr "Startprogrammets egen musikk, en av dine eller ingen. For å bruke din egen, legg MP3- eller WAV-filer i {0}; de vises her. Alle sider spiller det samme."

#: port/frontend/shell/settings.cpp:1590
msgid "Music volume"
msgstr "Musikkvolum"

#: port/frontend/shell/settings.cpp:1590
msgid "Menu music volume."
msgstr "Hvor høyt menyenes musikk spiller."

