msgstr "Fyller stolpene ved siden av et 4:3-bilde. Dine egne 1920 x 1080 PNG-er går i /data/porpoise/borders."

#: port/frontend/shell/porpoise_rows.cpp:137
msgid "V-Sync"
msgstr "V-Sync"

