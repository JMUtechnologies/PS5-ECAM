msgstr "Musikken som spilles i menyene, hvor høy den er, og lydene når du flytter deg og velger. Alle sider har de samme."

#: port/frontend/shell/settings.cpp:1587
msgid "Launcher music"
msgstr "Startprogrammets musikk"

#: port/frontend/shell/settings.cpp:1587
msgid "Music that plays in the menus."
msgstr "Musikk som spilles i menyene."

#: port/frontend/shell/settings.cpp:1588
