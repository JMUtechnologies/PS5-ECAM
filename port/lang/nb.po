msgstr "Skarpere teksturer på gulv og vegger sett i vinkel."

#: port/frontend/shell/porpoise_rows.cpp:164
msgid "Extra bloom"
msgstr "Ekstra blomstring"

#: port/frontend/shell/porpoise_rows.cpp:164
