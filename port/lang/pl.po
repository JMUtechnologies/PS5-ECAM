msgid "Chinese (traditional)"
msgstr "Chiński (tradycyjny)"

#: port/frontend/shell/porpoise_rows.cpp:325 port/frontend/shell/settings.cpp:58
msgid "Korean"
msgstr "Koreański"

#: port/frontend/shell/porpoise_rows.cpp:327
msgid "Fast save states"
msgstr "Szybkie stany zapisu"

#: port/frontend/shell/porpoise_rows.cpp:327
msgid "Quicker and smaller states. Turn it off if a game looks wrong after loading one."
msgstr "Szybsze i mniejsze stany. Wyłącz, jeśli gra źle wygląda po wczytaniu stanu."

#: port/frontend/shell/porpoise_rows.cpp:329
msgid "Progressive scan"
msgstr "Skanowanie progresywne"

#: port/frontend/shell/porpoise_rows.cpp:329
msgid "480p output, as on a component cable."
msgstr "Obraz 480p, jak z kabla komponentowego."

#: port/frontend/shell/porpoise_rows.cpp:331
msgid "Wii widescreen"
msgstr "Panoramiczny ekran Wii"

#: port/frontend/shell/porpoise_rows.cpp:331
msgid "The Wii's 16:9 setting, used by Wii games."
msgstr "Własne ustawienie 16:9 konsoli Wii, za którym idą gry Wii."

#: port/frontend/shell/porpoise_rows.cpp:333
msgid "PAL games at 60 Hz"
msgstr "Gry PAL w 60 Hz"

#: port/frontend/shell/porpoise_rows.cpp:333
msgid "European Wii games at 60 Hz, as a Wii set to EURGB60. Off: 50 Hz."
msgstr "Europejskie gry Wii w 60 Hz, jak na Wii ustawionym na EURGB60. Wyłączone: 50 Hz."

#: port/frontend/shell/porpoise_rows.cpp:335
msgid "Sensor bar"
msgstr "Listwa sensora"

#: port/frontend/shell/porpoise_rows.cpp:335
msgid "Where the sensor bar is."
msgstr "Gdzie według ustawień Wii znajduje się listwa sensora."

#: port/frontend/shell/porpoise_rows.cpp:336
msgid "Below the TV"
msgstr "Pod telewizorem"

#: port/frontend/shell/porpoise_rows.cpp:336
msgid "Above the TV"
msgstr "Nad telewizorem"

#: port/frontend/shell/porpoise_rows.cpp:337
msgid "GameCube boot animation"
msgstr "Animacja startowa GameCube"

#: port/frontend/shell/porpoise_rows.cpp:337
msgid "Shows the GameCube start-up before games. Needs your own IPL.bin."
msgstr "Gry zaczynają się od uruchamiania konsoli, z pliku IPL.bin z twojego BIOS-u."

#: port/frontend/shell/porpoise_rows.cpp:339
msgid "WiiConnect24 channels"
msgstr "Kanały WiiConnect24"

#: port/frontend/shell/porpoise_rows.cpp:339
msgid "Forecast, News, Check Mii Out and more through WiiLink. Needs the PS5 online."
msgstr "Pogoda, Wiadomości, Check Mii Out i inne przez WiiLink. Konsola musi być online."

#: port/frontend/shell/porpoise_rows.cpp:341
msgid "Overclocking can smooth a game that slows down. 100% is the real console."
msgstr "Podkręcanie może upłynnić grę, która zwalnia. 100% to prawdziwa konsola."

#: port/frontend/shell/porpoise_rows.cpp:343 port/frontend/shell/porpoise_rows.cpp:1774 port/frontend/shell/settings.cpp:285
msgid "Auto Boost"
msgstr "Auto Boost"

#: port/frontend/shell/porpoise_rows.cpp:343
msgid "New games start with the settings that run them best on PS5. Turn it off for a game in its own settings."
msgstr "Nowe gry startują z ustawieniami, w których działają najlepiej na PS5, sprawdzonymi w testach. Auto Boost danej gry może je wyłączyć."

#: port/frontend/shell/porpoise_rows.cpp:346 port/frontend/shell/porpoise_rows.cpp:1784
msgid "Riptide Boost"
msgstr "Riptide Boost"

#: port/frontend/shell/porpoise_rows.cpp:346 port/frontend/shell/porpoise_rows.cpp:1784
msgid "Speeds up the emulated processor's 3D math. Turn it off if a game misbehaves."
msgstr "Przyspiesza obliczenia 3D emulowanego procesora. Wyłącz, jeśli gra działa źle."

#: port/frontend/shell/porpoise_rows.cpp:348
msgid "Performance profiler"
msgstr "Profiler wydajności"

#: port/frontend/shell/porpoise_rows.cpp:348
msgid "For reporting a slow game: logs where the CPU spends its time. Costs a little speed; turn it off after."
msgstr "Do zgłoszenia wolnej gry: zapisuje w dziennikach debugowania, na co procesor PS5 traci czas. Kosztuje trochę szybkości. Wyłącz potem."

#: port/frontend/shell/porpoise_rows.cpp:350
msgid "Debug logs"
msgstr "Dzienniki debugowania"

#: port/frontend/shell/porpoise_rows.cpp:350
msgid "Keeps detailed logs for reporting a problem. Can slow games a little."
msgstr "Zachowuje szczegółowe dzienniki Porpoise w jego folderze debugowania, do zgłoszenia problemu. Może nieco spowolnić grę."

#: port/frontend/shell/porpoise_rows.cpp:352
msgid "Dual core"
msgstr "Dwa rdzenie"

#: port/frontend/shell/porpoise_rows.cpp:352
msgid "Faster. Turn it off for a game that freezes or glitches."
msgstr "Szybciej. Wyłącz dla gry, która się zawiesza lub ma usterki."

#: port/frontend/shell/porpoise_rows.cpp:354
msgid "Emulator on its own cores"
msgstr "Emulator na własnych rdzeniach"

#: port/frontend/shell/porpoise_rows.cpp:354
msgid "A PS5 core each for the emulated processor and graphics. Usually faster."
msgstr "Osobny rdzeń PS5 dla emulowanego procesora i grafiki. Zwykle szybciej."

#: port/frontend/shell/porpoise_rows.cpp:356
msgid "Exact multiply-add"
msgstr "Dokładne mnożenie z dodawaniem"

#: port/frontend/shell/porpoise_rows.cpp:356
msgid "Exact floating-point rounding. Much slower, and very few games need it."
msgstr "Dokładne zaokrąglanie liczb zmiennoprzecinkowych. Znacznie wolniej, a potrzebuje tego bardzo niewiele gier."

#: port/frontend/shell/porpoise_rows.cpp:358
msgid "Fast disc loading"
msgstr "Szybkie wczytywanie płyty"

#: port/frontend/shell/porpoise_rows.cpp:358
msgid "Shorter loading screens. A few games need real disc speed."
msgstr "Krótsze ekrany wczytywania. Kilka gier wymaga prawdziwej prędkości płyty."

#: port/frontend/shell/porpoise_rows.cpp:360
msgid "Cheat codes, for games that have them."
msgstr "Kody Dolphin do gier, które je mają."

#: port/frontend/shell/porpoise_rows.cpp:362
msgid "GBA buttons in use"
msgstr "Używane przyciski GBA"

#: port/frontend/shell/porpoise_rows.cpp:362
msgid "The default set, or one of your own."
msgstr "Zestaw Porpoise albo jeden z twoich dwóch."

#: port/frontend/shell/porpoise_rows.cpp:364
msgid "GBA web page"
msgstr "Strona WWW GBA"

