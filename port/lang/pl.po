#: port/frontend/shell/porpoise_rows.cpp:198 port/frontend/shell/porpoise_rows.cpp:210 port/frontend/shell/porpoise_rows.cpp:222 port/frontend/shell/porpoise_rows.cpp:234
msgid "Hold the GBA button, press it to toggle, or keep it always on or off."
msgstr "Czy gracz trzyma przycisk GBA, naciska go, aby włączać i wyłączać, czy go nie potrzebuje."

#: port/frontend/shell/porpoise_rows.cpp:199 port/frontend/shell/porpoise_rows.cpp:211 port/frontend/shell/porpoise_rows.cpp:223 port/frontend/shell/porpoise_rows.cpp:235 port/frontend/shell/porpoise_rows.cpp:369 port/frontend/shell/porpoise_rows.cpp:381 port/frontend/shell/porpoise_rows.cpp:393 port/frontend/shell/porpoise_rows.cpp:405
