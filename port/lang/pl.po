msgstr "Sterowany przez"

#: port/frontend/shell/porpoise_rows.cpp:193 port/frontend/shell/porpoise_rows.cpp:205 port/frontend/shell/porpoise_rows.cpp:217 port/frontend/shell/porpoise_rows.cpp:229
msgid "Who plays this GBA by holding their GBA button."
msgstr "Kto gra na tym GBA, trzymając swój przycisk GBA."

#: port/frontend/shell/porpoise_rows.cpp:194 port/frontend/shell/porpoise_rows.cpp:206 port/frontend/shell/porpoise_rows.cpp:218 port/frontend/shell/porpoise_rows.cpp:230
msgid "A player: they play it while holding their GBA button, with its sound on their controller. Its own controller: the controller in this port is the GBA, no button needed. Nobody: only from the web page."
msgstr "Gracz gra na nim, trzymając swój przycisk GBA, z dźwiękiem na swoim kontrolerze i ekranem do pokazania. Własny kontroler: kontroler w tym porcie jest GBA, bez trzymania przycisku (Four Swords Adventures). Nikt: tylko strona w przeglądarce."

#: port/frontend/shell/porpoise_rows.cpp:195 port/frontend/shell/porpoise_rows.cpp:207 port/frontend/shell/porpoise_rows.cpp:219 port/frontend/shell/porpoise_rows.cpp:231 port/frontend/shell/porpoise_rows.cpp:1153
msgid "Its own controller"
msgstr "Własny kontroler"

#: port/frontend/shell/porpoise_rows.cpp:196 port/frontend/shell/porpoise_rows.cpp:208 port/frontend/shell/porpoise_rows.cpp:220 port/frontend/shell/porpoise_rows.cpp:232
msgid "Whose controller is in this port."
msgstr "Czyj kontroler jest w tym porcie."

#: port/frontend/shell/porpoise_rows.cpp:198 port/frontend/shell/porpoise_rows.cpp:210 port/frontend/shell/porpoise_rows.cpp:222 port/frontend/shell/porpoise_rows.cpp:234 port/frontend/shell/porpoise_rows.cpp:621
