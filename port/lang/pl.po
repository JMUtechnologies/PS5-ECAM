#: port/frontend/shell/porpoise_rows.cpp:199 port/frontend/shell/porpoise_rows.cpp:211 port/frontend/shell/porpoise_rows.cpp:223 port/frontend/shell/porpoise_rows.cpp:235 port/frontend/shell/porpoise_rows.cpp:369 port/frontend/shell/porpoise_rows.cpp:381 port/frontend/shell/porpoise_rows.cpp:393 port/frontend/shell/porpoise_rows.cpp:405
msgid "Always on"
msgstr "Zawsze włączony"

#: port/frontend/shell/porpoise_rows.cpp:199 port/frontend/shell/porpoise_rows.cpp:211 port/frontend/shell/porpoise_rows.cpp:223 port/frontend/shell/porpoise_rows.cpp:235 port/frontend/shell/porpoise_rows.cpp:369 port/frontend/shell/porpoise_rows.cpp:381 port/frontend/shell/porpoise_rows.cpp:393 port/frontend/shell/porpoise_rows.cpp:405
msgid "Always off"
msgstr "Zawsze wyłączony"

#: port/frontend/shell/porpoise_rows.cpp:200 port/frontend/shell/porpoise_rows.cpp:212 port/frontend/shell/porpoise_rows.cpp:224 port/frontend/shell/porpoise_rows.cpp:236
msgid "GBA game"
msgstr "Gra GBA"

#: port/frontend/shell/porpoise_rows.cpp:200
msgid "The GBA game loaded at start, from games/gba/port1. None: BIOS only."
msgstr "Gra w tym GBA przy starcie gry: plik w games/gba/port1. Brak: sam BIOS."

#: port/frontend/shell/porpoise_rows.cpp:201 port/frontend/shell/porpoise_rows.cpp:213 port/frontend/shell/porpoise_rows.cpp:225 port/frontend/shell/porpoise_rows.cpp:237
msgid "Save beside the game"
msgstr "Zapis obok gry"

#: port/frontend/shell/porpoise_rows.cpp:201 port/frontend/shell/porpoise_rows.cpp:213 port/frontend/shell/porpoise_rows.cpp:225 port/frontend/shell/porpoise_rows.cpp:237
msgid "Keeps this GBA's save next to its game instead of with the other saves."
msgstr "Zapis tego GBA obok jego gry zamiast razem z zapisami Porpoise."

#: port/frontend/shell/porpoise_rows.cpp:212
msgid "The GBA game loaded at start, from games/gba/port2. None: BIOS only."
msgstr "Gra w tym GBA przy starcie gry: plik w games/gba/port2. Brak: sam BIOS."

#: port/frontend/shell/porpoise_rows.cpp:224
msgid "The GBA game loaded at start, from games/gba/port3. None: BIOS only."
msgstr "Gra w tym GBA przy starcie gry: plik w games/gba/port3. Brak: sam BIOS."

#: port/frontend/shell/porpoise_rows.cpp:236
msgid "The GBA game loaded at start, from games/gba/port4. None: BIOS only."
msgstr "Gra w tym GBA przy starcie gry: plik w games/gba/port4. Brak: sam BIOS."

#: port/frontend/shell/porpoise_rows.cpp:238
msgid "Console"
msgstr "Konsola"

#: port/frontend/shell/porpoise_rows.cpp:238
msgid "Which console's controls to use, if a game is detected wrongly."
msgstr "Sterowanie której konsoli dostaje gra, dla gry rozpoznanej błędnie."

#: port/frontend/shell/porpoise_rows.cpp:240
msgid "Button layout"
msgstr "Układ przycisków"

#: port/frontend/shell/porpoise_rows.cpp:241
msgid "PlayStation: Cross is A and Circle B. GameCube: Circle is A and Cross B."
msgstr "PlayStation: krzyżyk to A, a kółko B. GameCube: kółko to A, a krzyżyk B."

#: port/frontend/shell/porpoise_rows.cpp:242
msgid "PlayStation: Cross is A and Circle is B. GameCube: Circle is A and Cross is B. My layouts are the ones you make on the Buttons page. For GameCube games and Wii games played with a GameCube controller."
msgstr "PlayStation: Krzyżyk to A, a Kółko to B. GameCube: Kółko to A, a Krzyżyk to B. Moje układy to twoje własne, stworzone na stronie Przyciski. Dla gier GameCube oraz gier Wii, w które grasz kontrolerem GameCube."

#: port/frontend/shell/porpoise_rows.cpp:244
msgid "Controller rumble."
msgstr "Wibracje kontrolera, tak jak gra o nie prosi."

#: port/frontend/shell/porpoise_rows.cpp:246
msgid "Wii controller"
msgstr "Kontroler Wii"

#: port/frontend/shell/porpoise_rows.cpp:246
msgid "How a Wii game sees your DualSense."
msgstr "Jak gra Wii widzi twój DualSense."

#: port/frontend/shell/porpoise_rows.cpp:247
msgid "Remote and Nunchuk: Nunchuk on the left stick, L1 and L2. Remote: point at the TV, with motion. Held sideways: like an NES pad, tilt to steer. Two DualSenses (alpha): the second is the Nunchuk. GameCube controller: for Wii games that support one. Each other DualSense is another player's Wii Remote."
msgstr "Wii Remote i Nunchuk: Nunchuk na lewej gałce, L1 i L2. Wii Remote: trzymany w stronę telewizora, z jego ruchem. Bokiem: jak pad NES, przechylany, by skręcać. Dwa DualSense (alfa): drugi jest Nunchukiem. Kontroler GameCube: dla gier Wii, które go przyjmują. Każdy kolejny DualSense to własny Wii Remote kolejnego gracza."

#: port/frontend/shell/porpoise_rows.cpp:248
msgid "Remote and Nunchuk"
msgstr "Wii Remote i Nunchuk"

#: port/frontend/shell/porpoise_rows.cpp:248
msgid "Remote"
msgstr "Wii Remote"

#: port/frontend/shell/porpoise_rows.cpp:248
msgid "Remote held sideways"
msgstr "Wii Remote bokiem"

#: port/frontend/shell/porpoise_rows.cpp:249
msgid "Two DualSenses (alpha)"
msgstr "Dwa DualSense (alfa)"

#: port/frontend/shell/porpoise_rows.cpp:249
msgid "GameCube controller"
msgstr "Kontroler GameCube"

#: port/frontend/shell/porpoise_rows.cpp:251
msgid "Pointer"
msgstr "Wskaźnik"

#: port/frontend/shell/porpoise_rows.cpp:251
msgid "What moves the Wii Remote's pointer."
msgstr "Co porusza wskaźnikiem Wii Remote."

#: port/frontend/shell/porpoise_rows.cpp:252
msgid "Gyro: point the controller at the screen, and hold R1 a moment to centre it. Touchpad: slide a finger on it. Right stick: push it."
msgstr "Żyroskop: skieruj kontroler na ekran i przytrzymaj chwilę R1, aby go wyśrodkować. Panel dotykowy: przesuń po nim palcem. Prawa gałka: popchnij ją."

#: port/frontend/shell/porpoise_rows.cpp:254
msgid "Gyro"
msgstr "Żyroskop"

#: port/frontend/shell/porpoise_rows.cpp:254
msgid "Touchpad"
msgstr "Panel dotykowy"

#: port/frontend/shell/porpoise_rows.cpp:254 port/frontend/shell/porpoise_rows.cpp:979
msgid "Right stick"
msgstr "Prawa gałka"

#: port/frontend/shell/porpoise_rows.cpp:255
msgid "Player 1's port"
msgstr "Port gracza 1"

#: port/frontend/shell/porpoise_rows.cpp:255
msgid "The GameCube port your controller is in, for the few games that want another."
msgstr "Port GameCube, w którym jest twój kontroler, dla nielicznych gier, które chcą innego."

#: port/frontend/shell/porpoise_rows.cpp:256
msgid "The GameCube port your controller is in. A few games briefly need it in another port."
msgstr "Port kontrolera GameCube, w którym jest twój kontroler. Dla nielicznych gier, które na chwilę chcą go w innym porcie (Metal Gear Solid: The Twin Snakes)."

#: port/frontend/shell/porpoise_rows.cpp:258
msgid "Invert the control stick"
msgstr "Odwróć gałkę sterującą"

#: port/frontend/shell/porpoise_rows.cpp:258
msgid "For a game whose controls feel reversed. Best set per game."
msgstr "Dla gry, która porusza się w drugą stronę. Najlepiej ustawić dla jednej gry."

#: port/frontend/shell/porpoise_rows.cpp:259 port/frontend/shell/porpoise_rows.cpp:261
msgid "Up and down"
msgstr "Góra i dół"

#: port/frontend/shell/porpoise_rows.cpp:259 port/frontend/shell/porpoise_rows.cpp:261
msgid "Left and right"
msgstr "Lewo i prawo"

#: port/frontend/shell/porpoise_rows.cpp:259 port/frontend/shell/porpoise_rows.cpp:261
msgid "Both"
msgstr "Oba"

#: port/frontend/shell/porpoise_rows.cpp:260
msgid "Invert the C-stick"
msgstr "Odwróć gałkę C"

#: port/frontend/shell/porpoise_rows.cpp:260
msgid "For a game whose camera feels reversed. Best set per game."
msgstr "Dla gry, której kamera obraca się w drugą stronę. Najlepiej ustawić dla jednej gry."

#: port/frontend/shell/porpoise_rows.cpp:262
msgid "Stick sensitivity"
msgstr "Czułość gałki"

#: port/frontend/shell/porpoise_rows.cpp:262
msgid "Lower makes small pushes gentler. A full push still turns fully."
msgstr "Ile porusza małe wychylenie. Pełne wychylenie nadal daje pełny obrót."

#: port/frontend/shell/porpoise_rows.cpp:263 port/frontend/shell/porpoise_rows.cpp:313
msgid "Normal"
