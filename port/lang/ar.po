msgstr[0] "{0} حالات حفظ"
msgstr[1] "{0} حالة حفظ"
msgstr[2] "{0} حالة حفظ"
msgstr[3] "{0} حالات حفظ"
msgstr[4] "{0} حالة حفظ"
msgstr[5] "{0} حالة حفظ"

