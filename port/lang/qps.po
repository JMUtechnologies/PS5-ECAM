msgstr "⟦Höw löûd thé làûñçhér's mûsîç îs. Léft àñd Rîght çhàñgé ît bÿ 10%.~~~~~~~~~~~~~~~~~~~~~~~~~~⟧"

#: port/frontend/shell/settings.cpp:363
msgid "Menu sounds"
msgstr "⟦Méñû söûñds~~~~⟧"

#: port/frontend/shell/settings.cpp:363
msgid "The sounds of moving and choosing."
