#: port/frontend/shell/settings.cpp:359
msgid "The music under the menus."
msgstr "⟦Thé mûsîç ûñdér thé méñûs.~~~~~~~~~~⟧"

#: port/frontend/shell/settings.cpp:360
msgid "The launcher's own music, in the spirit of a console's setup screen, or none. Every side has the same."
