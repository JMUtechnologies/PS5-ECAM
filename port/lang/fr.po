#: port/frontend/shell/porpoise_rows.cpp:297
msgid "A quick flick of the controller shakes the Remote."
msgstr "Un petit coup sec de la manette secoue la télécommande."

#: port/frontend/shell/porpoise_rows.cpp:299
msgid "Wii MotionPlus"
msgstr "Wii MotionPlus"

#: port/frontend/shell/porpoise_rows.cpp:299
msgid "Adds MotionPlus using the gyroscope. Automatic: for games that need it."
msgstr "Un MotionPlus sur la télécommande, joué par le gyroscope. Automatique : pour les jeux qui en ont besoin."

#: port/frontend/shell/porpoise_rows.cpp:301
msgid "Setup before each game"
msgstr "Configuration avant chaque jeu"

#: port/frontend/shell/porpoise_rows.cpp:301
msgid "Shows the Wii Remote's setup when a game starts."
msgstr "Affiche la configuration de la télécommande Wii au démarrage d'un jeu."

#: port/frontend/shell/porpoise_rows.cpp:303
msgid "The game's sound."
msgstr "Le son du jeu."

#: port/frontend/shell/porpoise_rows.cpp:304
msgid "Mute the game"
msgstr "Couper le son du jeu"

#: port/frontend/shell/porpoise_rows.cpp:304
