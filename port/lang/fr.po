msgstr "Le jeu de touches de Porpoise, ou l'un de vos deux."

#: port/frontend/shell/porpoise_rows.cpp:364
msgid "GBA web page"
msgstr "Page web GBA"

#: port/frontend/shell/porpoise_rows.cpp:364
msgid "Play the GBA in a browser on the same network, on port 6771."
msgstr "L'écran et les touches de la GBA dans un navigateur du même réseau, sur le port 6771."

