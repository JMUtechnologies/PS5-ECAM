msgid "Where its screen sits on the TV. Moving it in a game makes it Manual."
msgstr "Где на телевизоре находится её экран. Если сдвинуть его в игре, будет «Вручную»."

#: port/frontend/shell/porpoise_rows.cpp:367 port/frontend/shell/porpoise_rows.cpp:379 port/frontend/shell/porpoise_rows.cpp:391 port/frontend/shell/porpoise_rows.cpp:403
msgid "Top left"
msgstr "Вверху слева"

#: port/frontend/shell/porpoise_rows.cpp:367 port/frontend/shell/porpoise_rows.cpp:379 port/frontend/shell/porpoise_rows.cpp:391 port/frontend/shell/porpoise_rows.cpp:403
msgid "Top right"
msgstr "Вверху справа"

#: port/frontend/shell/porpoise_rows.cpp:367 port/frontend/shell/porpoise_rows.cpp:379 port/frontend/shell/porpoise_rows.cpp:391 port/frontend/shell/porpoise_rows.cpp:403
msgid "Bottom left"
msgstr "Внизу слева"

#: port/frontend/shell/porpoise_rows.cpp:367 port/frontend/shell/porpoise_rows.cpp:379 port/frontend/shell/porpoise_rows.cpp:391 port/frontend/shell/porpoise_rows.cpp:403
msgid "Bottom right"
msgstr "Внизу справа"

#: port/frontend/shell/porpoise_rows.cpp:367 port/frontend/shell/porpoise_rows.cpp:379 port/frontend/shell/porpoise_rows.cpp:391 port/frontend/shell/porpoise_rows.cpp:403
msgid "Manual"
msgstr "Вручную"

#: port/frontend/shell/porpoise_rows.cpp:368 port/frontend/shell/porpoise_rows.cpp:380 port/frontend/shell/porpoise_rows.cpp:392 port/frontend/shell/porpoise_rows.cpp:404 port/frontend/shell/porpoise_rows.cpp:617
msgid "Show the GBA's screen"
msgstr "Показывать экран GBA"

#: port/frontend/shell/porpoise_rows.cpp:368 port/frontend/shell/porpoise_rows.cpp:380 port/frontend/shell/porpoise_rows.cpp:392 port/frontend/shell/porpoise_rows.cpp:404
msgid "Shows it over the game while held, toggled with each press, or always on or off."
msgstr "На телевизоре поверх игры: пока зажато, включение и выключение каждым нажатием или всегда включён или выключен."

#: port/frontend/shell/porpoise_rows.cpp:369 port/frontend/shell/porpoise_rows.cpp:381 port/frontend/shell/porpoise_rows.cpp:393 port/frontend/shell/porpoise_rows.cpp:405
msgid "While held"
msgstr "Пока зажато"

#: port/frontend/shell/porpoise_rows.cpp:370 port/frontend/shell/porpoise_rows.cpp:382 port/frontend/shell/porpoise_rows.cpp:394 port/frontend/shell/porpoise_rows.cpp:406
msgid "Position across"
msgstr "Положение по горизонтали"

#: port/frontend/shell/porpoise_rows.cpp:370 port/frontend/shell/porpoise_rows.cpp:372 port/frontend/shell/porpoise_rows.cpp:382 port/frontend/shell/porpoise_rows.cpp:384 port/frontend/shell/porpoise_rows.cpp:394 port/frontend/shell/porpoise_rows.cpp:396 port/frontend/shell/porpoise_rows.cpp:406 port/frontend/shell/porpoise_rows.cpp:408
