#: port/app/accounts.cpp:68 port/frontend/shell/settings.cpp:1802
msgid "The Wii U has twelve accounts at most."
msgstr "На Wii U может быть не больше двенадцати учётных записей."

#: port/app/accounts.cpp:104
msgid "The last account cannot be deleted."
msgstr "Последнюю учётную запись нельзя удалить."

#: port/app/accounts.cpp:109
msgid "Games start on this account: choose another one first."
msgstr "Игры запускаются с этой учётной записью: сначала выберите другую."

#: port/app/accounts.cpp:128
msgid "There is no such account."
msgstr "Такой учётной записи нет."

