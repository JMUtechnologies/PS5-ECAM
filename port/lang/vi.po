#: port/frontend/shell/shares.cpp:73
msgid "Enter the computer's address or name first."
msgstr "Nhập địa chỉ hoặc tên máy tính trước."

#: port/frontend/shell/shares.cpp:75
msgid "Enter the export's path, like /volume1/games."
msgstr "Nhập đường dẫn export, ví dụ /volume1/games."

#: port/frontend/shell/shares.cpp:75
msgid "Enter the shared folder's name, or choose one the computer lists."
msgstr "Nhập tên thư mục chia sẻ, hoặc chọn một thư mục máy tính liệt kê."

