#: port/frontend/shell/shares.cpp:82
msgid "The computer did not let the PS5 in: check the folder's sharing permissions, or sign in."
msgstr "Máy tính không cho PS5 vào: kiểm tra quyền chia sẻ của thư mục, hoặc đăng nhập."

#: port/frontend/shell/shares.cpp:83
msgid "The folder inside is not there."
msgstr "Không có thư mục bên trong đó."

#: port/frontend/shell/shares.cpp:84
msgid "The computer did not list its exports. Type the export's path, like /volume1/games."
msgstr "Máy tính không liệt kê các export. Gõ đường dẫn export, ví dụ /volume1/games."

#: port/frontend/shell/shares.cpp:85
msgid "It did not work."
