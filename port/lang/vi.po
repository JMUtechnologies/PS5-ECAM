#: port/frontend/shell/reports.cpp:75
msgid "Help Playtendoh get better?"
msgstr "Giúp cải thiện Playtendoh?"

#: port/frontend/shell/reports.cpp:77
msgid "When a game ends, Playtendoh can send a short report on how it ran, to help fix problems and grow the list of working games. It has nothing about you, and nothing is sent while you play."
msgstr "Khi trò chơi kết thúc, Playtendoh có thể gửi một báo cáo ngắn về cách trò chơi chạy để giúp khắc phục sự cố và phát triển danh sách các trò chơi đang hoạt động. Nó không có gì về bạn và không có gì được gửi đi khi bạn chơi."

#: port/frontend/shell/reports.cpp:88
msgid "What a report has"
msgstr "Báo cáo có gì"

#: port/frontend/shell/reports.cpp:89
msgid "The game and its console, how it ended, and for how long"
msgstr "Trò chơi và bảng điều khiển của nó, nó kết thúc như thế nào và kéo dài bao lâu"

#: port/frontend/shell/reports.cpp:89
msgid "The settings it ran with, and the PS5's firmware and model"
msgstr "Các cài đặt mà nó chạy cùng với chương trình cơ sở và kiểu máy của PS5"

#: port/frontend/shell/reports.cpp:90
msgid "The last lines of Playtendoh's log, with addresses and folder names removed"
msgstr "Những dòng cuối cùng trong nhật ký của Playtendoh, đã xóa địa chỉ và tên thư mục"

#: port/frontend/shell/reports.cpp:91
msgid "What it never has"
msgstr "Những gì nó không bao giờ có"

#: port/frontend/shell/reports.cpp:92
msgid "Your PSN name or ID, your console's serial, its IP or MAC address"
msgstr "Tên hoặc ID PSN của bạn, số sê-ri của bảng điều khiển, địa chỉ IP hoặc MAC của bảng điều khiển của bạn"

#: port/frontend/shell/reports.cpp:93
msgid "Your RetroAchievements and SteamGridDB accounts, room names, nicknames and Wi-Fi names"
msgstr "Tài khoản RetroAchievements và SteamGridDB, tên phòng, biệt hiệu và tên Wi-Fi của bạn"

