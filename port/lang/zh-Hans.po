msgstr "游戏指针能到达的范围，适用于指针够不到边缘的游戏。"

#: port/frontend/shell/porpoise_rows.cpp:292
msgid "Standard"
msgstr "标准"

#: port/frontend/shell/porpoise_rows.cpp:292
msgid "Wide"
msgstr "宽"

#: port/frontend/shell/porpoise_rows.cpp:292
