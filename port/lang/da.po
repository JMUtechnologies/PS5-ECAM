#: port/app/ingame.cpp:213
#, menu
msgid "Upscaling, accuracy and the performance overlay. Applies to all games."
msgstr "Opskalering, Cemus nøjagtighedsindstillinger og ydelsesoverlejringen. Gemmes til de næste spil."

#: port/app/ingame.cpp:214 port/eden/ingame.cpp:616 port/frontend/shell/settings.cpp:626 port/frontend/shell/settings.cpp:724
#, menu
msgid "Upscaling to 4K"
msgstr "Opskalering til 4K"

#: port/app/ingame.cpp:215
#, menu
msgid "Bicubic is sharpest, Hermite softer, Bilinear softest."
msgstr "Hvordan billedet skaleres til skærmen: Bikubisk er skarp, Hermite blødere, Bilineær endnu blødere."

#: port/app/ingame.cpp:216
#, menu
msgid "Accurate barriers"
msgstr "Præcise barrierer"

#: port/app/ingame.cpp:217
#, menu
msgid "Off can raise the frame rate, but some games may flicker or show wrong shadows."
msgstr "Fra kan hæve billedhastigheden, men nogle spil flimrer så eller viser forkerte skygger. Gælder med det samme."

#: port/app/ingame.cpp:218 port/frontend/shell/settings.cpp:663 port/frontend/shell/settings.cpp:701 port/frontend/shell/settings.cpp:1022
#, menu
msgid "Async shader compile"
msgstr "Asynkron shaderkompilering"

#: port/app/ingame.cpp:219
#, menu
msgid "Builds shaders in the background. Less stutter, but some things may appear late."
msgstr "Til: nye shaders bygges, mens spillet kører videre. Ingen hakken, men noget kan mangle et øjeblik."

#: port/app/ingame.cpp:220 port/frontend/shell/settings.cpp:644
#, menu
msgid "Frame pacing"
msgstr "Jævn billedrytme"

#: port/app/ingame.cpp:221
#, menu
msgid "Keeps the frame rate steady (60 fps at 4K 120 Hz, 30 at 8K 60 Hz). Off shows each frame when ready."
msgstr "Holder spillet i en jævn takt: 60 fps til 4K ved 120 Hz, 30 til 8K ved 60 Hz. Fra viser hvert billede, så snart det er klar."

#: port/app/ingame.cpp:222 port/app/ingame3ds.cpp:610 port/eden/ingame.cpp:626 port/frontend/shell/porpoise_rows.cpp:117 port/frontend/shell/settings.cpp:634 port/frontend/shell/settings.cpp:648 port/frontend/shell/settings.cpp:705 port/frontend/shell/settings.cpp:762 port/frontend/shell/settings.cpp:777
