msgid "Save beside the game"
msgstr "게임 옆에 저장"

#: port/frontend/shell/porpoise_rows.cpp:201 port/frontend/shell/porpoise_rows.cpp:213 port/frontend/shell/porpoise_rows.cpp:225 port/frontend/shell/porpoise_rows.cpp:237
