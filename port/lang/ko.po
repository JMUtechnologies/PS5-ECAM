#: port/frontend/shell/porpoise_rows.cpp:198 port/frontend/shell/porpoise_rows.cpp:210 port/frontend/shell/porpoise_rows.cpp:222 port/frontend/shell/porpoise_rows.cpp:234
msgid "Hold the GBA button, press it to toggle, or keep it always on or off."
msgstr "플레이어가 GBA 버튼을 누르고 있을지, 눌러서 켜고 끌지, 필요 없는지를 정합니다."

