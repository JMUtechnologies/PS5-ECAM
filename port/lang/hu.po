#: port/app/ingame.cpp:223 port/app/ingame3ds.cpp:611 port/eden/ingame.cpp:627
#, menu
msgid "Adds a frame between each pair, so 30 fps games play at 60."
msgstr "Egy kép készül minden két képkocka közé egy 30 fps-es játékban, így 60-nal látszik. Azonnal változik."

