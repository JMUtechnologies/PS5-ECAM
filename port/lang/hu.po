#: port/frontend/shell/settings.cpp:406 port/frontend/shell/settings.cpp:462 port/frontend/shell/switch_extras.cpp:67
msgid "No mods found"
msgstr "Nem található mod"

#: port/frontend/shell/settings.cpp:410
msgid "Cross to look on your drives"
msgstr "Kereszt: keresés a meghajtókon"

#: port/frontend/shell/settings.cpp:419
msgid "No mods on your drives"
msgstr "Nincs mod a meghajtóidon"

#: port/frontend/shell/settings.cpp:420
msgid "Copy each mod's folder into ps5cemu/mods on a USB drive and plug it in. A mod is a graphic pack (a folder with rules.txt), or a folder with content and aoc folders. See docs/GUIDE.md on GitHub."
msgstr "Másold minden mod mappáját egy USB-meghajtó ps5cemu/mods mappájába, és csatlakoztasd. A mod egy Cemu grafikus csomag (egy rules.txt fájlt tartalmazó mappa), vagy egy mappa, amelyben a lecserélt fájlokhoz content és aoc mappák vannak. A GitHubon lévő útmutató, a docs/GUIDE.md, többet mond."

#: port/frontend/shell/settings.cpp:426
msgid "Copying mods from your drives…"
msgstr "Modok másolása a meghajtóidról…"

#: port/frontend/shell/settings.cpp:449
msgid "{0} folder had no rules.txt and no game. Name the folder with its game's title ID, or add it from the game's menu."
msgid_plural "{0} folders had no rules.txt and no game. Name each folder with its game's title ID, or add it from the game's menu."
msgstr[0] "{0} mappában nem volt rules.txt, és játék sem tartozott hozzá: az ilyen modot tedd a játéka címazonosítójáról elnevezett mappába, vagy add hozzá a játék menüjéből."
msgstr[1] "{0} mappában nem volt rules.txt, és játék sem tartozott hozzájuk: az ilyen modot tedd a játéka címazonosítójáról elnevezett mappába, vagy add hozzá a játék menüjéből."

#: port/frontend/shell/settings.cpp:455
msgid "The mods could not all be copied"
msgstr "Nem minden modot sikerült átmásolni"

#: port/frontend/shell/settings.cpp:456
msgid "{0} mod was added."
msgid_plural "{0} mods were added."
msgstr[0] "{0} mod hozzáadva."
msgstr[1] "{0} mod hozzáadva."

#: port/frontend/shell/settings.cpp:462
msgid "No mods found in ps5cemu/mods on your drives."
msgstr "A meghajtóid ps5cemu/mods mappáiban nincs sem rules.txt fájlt tartalmazó mappa, sem content, aoc vagy code mappát tartalmazó mappa."

#: port/frontend/shell/settings.cpp:466
msgid "Turn them on in their games' Graphic packs."
msgstr "Kapcsold be őket a játékaik Grafikus csomagok oldalán."

#: port/frontend/shell/settings.cpp:468
msgid "{0} mod added: turn it on in its game's Graphic packs"
msgid_plural "{0} mods added: turn them on in their games' Graphic packs"
msgstr[0] "{0} mod hozzáadva: kapcsold be a játéka Grafikus csomagok oldalán"
msgstr[1] "{0} mod hozzáadva: kapcsold be őket a játékaik Grafikus csomagok oldalán"

#: port/frontend/shell/settings.cpp:484
msgid "Reset all settings"
msgstr "Állítsa vissza az összes beállítást"

#: port/frontend/shell/settings.cpp:486
msgid "Puts every setting back to default. Games, folders and saves are kept."
msgstr "Minden beállítást visszaállít az alapértelmezettre. A játékok, mappák és mentések megőrződnek."

#: port/frontend/shell/settings.cpp:516 port/frontend/shell/settings.cpp:1725
msgid "Which emulator plays this system's games, from the next game. Each keeps its own settings and saves."
msgstr "Melyik emulátor futtatja ennek az oldalnak a játékait, a következő indítottól kezdve. Mindegyik megtartja a saját beállításait és mentéseit."

#: port/frontend/shell/settings.cpp:520
msgid "Games folder"
msgstr "Játékok mappája"

#: port/frontend/shell/settings.cpp:520
msgid "Where this system's games are. Changing it doesn't move any games or saves."
msgstr "A mappa, amelyben ennek az oldalnak a játékai vannak. Másik választása semmit sem helyez át: a játékok és a mentések maradnak, ahol vannak."

#: port/frontend/shell/settings.cpp:521 port/frontend/shell/settings.cpp:1072
msgid "Look for games now"
msgstr "Játékok keresése most"

#: port/frontend/shell/settings.cpp:526 port/frontend/shell/settings.cpp:1733
msgid "Open emulator settings and saves"
msgstr "Az emulátor beállításainak és mentéseinek megnyitása"

#: port/frontend/shell/settings.cpp:527 port/frontend/shell/settings.cpp:1734
msgid "Opens this emulator's own menus for its settings, controls and saves. Quit them to come back here."
msgstr "Ennek az oldalnak az emulátora saját beállításokat, irányítást és mentéseket tart: ez megnyitja a menüit, hogy módosíthasd őket, és a kilépés ide hoz vissza. Ami már megvolt neki, ott marad, ahol van."

#: port/frontend/shell/settings.cpp:530
msgid "Porpoise's other settings, your button layouts and Wii Remote setup. Circle at the top comes back here."
msgstr "A Porpoise egyéb beállításai, a gombok elrendezése és a Wii Remote beállítása. A tetején lévő Kör jön vissza ide."

#: port/frontend/shell/settings.cpp:533 port/frontend/shell/settings.cpp:1283 port/frontend/shell/settings.cpp:1956
msgid "Back up to USB"
msgstr "Biztonsági mentés USB-re"

#: port/frontend/shell/settings.cpp:533
msgid "Every system's saves. A save state only loads in the emulator that made it."
msgstr "Minden oldal mentései, minden emulátoré. Egy mentett állapot csak abban az emulátorban töltődik be, amelyik készítette."

#: port/frontend/shell/settings.cpp:534 port/frontend/shell/settings.cpp:2847
msgid "Emulator diagnostics"
msgstr "Emulátordiagnosztika"

#: port/frontend/shell/settings.cpp:610
msgid "Still starting. One moment."
msgstr "A Cemu még indul. Egy pillanat."

#: port/frontend/shell/settings.cpp:610
msgid "The Wii U emulator did not start, so this can't be changed."
msgstr "A Cemu nem indult el, így ez nem módosítható."

#: port/frontend/shell/settings.cpp:621
msgid "The menu language, and game names where available."
msgstr "A menük nyelve, és a játékok neveié, ha a játéknak van ilyen nyelvű neve."

#: port/frontend/shell/settings.cpp:622
msgid "Playtendoh uses the PS5's language unless you choose another. Game names follow it where the game has one in that language, otherwise they are in English. Descriptions from GameTDB are in English."
msgstr "A Playtendoh a PS5 nyelvén beszél, hacsak nem választasz itt mást; az első indítás beüzemelési ellenőrzése ugyanezt a választást kínálja. A játék neve is ezt követi, ha a játéknak van ilyen nyelvű neve, ahogy egy erre a nyelvre állított konzolon; különben az angol név látszik. A leírások a GameTDB-ből jönnek angolul, a grafikus csomagok a szerzőiktől, úgy, ahogy megírták őket."

#: port/frontend/shell/settings.cpp:626 port/frontend/shell/settings.cpp:724
msgid "How the picture is scaled to the TV."
msgstr "Hogyan méreteződik a kép a tévére."

#: port/frontend/shell/settings.cpp:627
msgid "Bicubic is sharp, Bicubic Hermite a little softer, Bilinear softest. Nearest neighbour keeps pixels square. AMD FSR 1 keeps edges clean for games below 4K, at a small GPU cost."
msgstr "A Bikubikus éles, a Bikubikus Hermite kicsit lágyabb, a Bilineáris még lágyabb; a Legközelebbi szomszéd négyzetesen tartja a képpontokat. Az AMD FSR 1 tisztán tartja az éleket a 4K alatt rajzolt játékoknál, a GPU-nak kicsit több munkával, mint a Bikubikus."

#. Settings > Graphics: a row that opens the frame rate's settings (120 Hz output, frame pacing, frame generation)
#: port/frontend/shell/settings.cpp:636
msgid "Frame rate"
msgstr "Képkockasebesség"

#. Settings > Graphics: a row that opens the frame rate's settings (120 Hz output, frame pacing, frame generation)
#: port/frontend/shell/settings.cpp:636
msgid "120 Hz output, frame pacing and frame generation."
msgstr "120 Hz-es kimenet, egyenletes képkockák és képkocka-generálás."

#: port/frontend/shell/settings.cpp:637
msgid "Refresh rate, frame pacing and frame generation. Press Triangle on each for more."
msgstr "A kijelző frissítési gyakorisága, egyenletes képkockasebességre fogott játék, és két képkocka közé készített kép. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:638
msgid "120 Hz output"
msgstr "120 Hz-es kimenet"

#: port/frontend/shell/settings.cpp:638
msgid "For displays that take 120 Hz."
msgstr "120 Hz-et kezelő kijelzőkhöz."

#: port/frontend/shell/settings.cpp:639
msgid "Uses 120 Hz on displays that support it. Games run at normal speed, and late frames wait less."
msgstr "A 119,88 Hz-es mód, az azt támogató kijelzőkön. A játékok továbbra is a saját sebességükkel futnak, és a frissítésről lemaradó képkocka 17 helyett 8 ms-ot vár a következőre."

#: port/frontend/shell/settings.cpp:644
msgid "Holds a game to an even frame rate."
msgstr "Egyenletes képkockasebességen tartja a játékot."

#: port/frontend/shell/settings.cpp:645
msgid "Keeps each frame on screen for the same time, so a game that can't hold full speed runs evenly: 60 or 40 fps with 120 Hz output, 30 or 20 without. Also in the in-game menu."
msgstr "Minden képkocka legalább két vagy három frissítésig a képernyőn marad, így az a játék, amely nem bírja a kijelző tempóját, egyenletesen fut: 60 vagy 40 fps 120 Hz-es kimenettel, 30 vagy 20 anélkül. A 60 fps 120 Hz-es kimenettel olyan 4K-s játékhoz illik, amely néha 60 alá esik; a 30 fps 60 Hz-en egy 8K-s játékhoz. A játék menüjében is."

#: port/frontend/shell/settings.cpp:648 port/frontend/shell/settings.cpp:705 port/frontend/shell/settings.cpp:777
msgid "Shows 30 fps games at 60."
msgstr "A 30 fps-re korlátozott játék 60-nal látszik."

#: port/frontend/shell/settings.cpp:649 port/frontend/shell/settings.cpp:706
msgid "Adds a frame between each pair, so a 30 fps game shows at 60 (or 60 at 120 with 120 Hz output). Adds a little delay. Also in the in-game menu."
msgstr "A MihawkGen egy képet készít minden két képkocka közé egy olyan játékban, amely képkockánként két vagy több frissítést vesz igénybe, így egy 30 fps-es játék 60-nal látszik, vagy 60-nal 120 Hz-es kimenetnél. Egy gyorsabb játék úgy látszik, ahogy van. Képenként körülbelül 2 ms-ba kerül a GPU-nak 4K-ban, és kis késést ad hozzá. A játék menüjében is."

#: port/frontend/shell/settings.cpp:653
msgid "Your ReShade preset and effects, from {0}."
msgstr "A ReShade-preseted és effektjeid innen: {0}."

#: port/frontend/shell/settings.cpp:654
msgid "Runs a ReShade preset made on a PC over the game. Put ReShadePreset.ini (or presets/<title ID>.ini for one game) and its Shaders and Textures folders in {0}. Also in the in-game menu."
msgstr "Egy PC-n készült ReShade-presetet futtat a játék képén, a GamePad képernyője és a menük előtt. Tedd a ReShadePreset.ini-t (vagy egy játékhoz a presets/<címazonosító>.ini-t) az általa használt Shaders és Textures mappákkal ide: {0}. A játék indulásakor fordul le; az indítási napló megmondja, mi fut. A játék közbeni menüben is."

#: port/frontend/shell/settings.cpp:657
msgid "Frame rate, CPU and memory in a corner."
msgstr "Képkockasebesség, CPU és memória a sarokban."

#: port/frontend/shell/settings.cpp:658
msgid "Shows frame rate, CPU and memory use in the top-left corner. Also in the in-game menu."
msgstr "Képkocka/másodperc, CPU- és memóriahasználat a bal felső sarokban, ahogy a Cemu mutatja. A játék menüjében is."

#. Settings > Graphics: a row that opens the shaders' settings
#. Settings > Graphics' Shaders row, its value: where the 3DS's vertex shaders run, on the GPU (Hardware) or on the CPU (Software)
#: port/frontend/shell/settings.cpp:661 port/frontend/shell/settings.cpp:690
msgid "Shaders"
msgstr "Árnyalók"

#. Settings > Graphics: a row that opens the shaders' settings
#: port/frontend/shell/settings.cpp:661
msgid "How new shaders are built, and shader notices."
msgstr "Hogyan készülnek az új árnyalók, és a Cemu értesítései róluk."

#: port/frontend/shell/settings.cpp:662
msgid "Async shader compile and shader notices. Press Triangle on each for more."
msgstr "Az aszinkron árnyalófordítás, és az értesítések, amelyeket a Cemu mutat, amíg egy játék az árnyalóit készíti. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:663 port/frontend/shell/settings.cpp:701 port/frontend/shell/settings.cpp:1022
msgid "No stutter while new shaders build."
msgstr "Nincs akadás, amíg új árnyalók készülnek."

#: port/frontend/shell/settings.cpp:664 port/frontend/shell/settings.cpp:702 port/frontend/shell/settings.cpp:1023
msgid "On: shaders build in the background, so less stutter, but some things may appear late. Off: the game waits for each shader, which stutters but draws everything right."
msgstr "Bekapcsolva az új árnyaló a játék futása közben készül, így nem akad, de valami egy pillanatra hiányozhat. Kikapcsolva a játék mindegyikre vár: akadás, de semmi sem rajzolódik rosszul."

#: port/frontend/shell/settings.cpp:666
msgid "Shows a notice while shaders build."
msgstr "A Cemu „lefordított árnyalók” üzenetei a játék fölött."

#: port/frontend/shell/settings.cpp:667
msgid "A notice in the corner while a game builds shaders. Off hides it; shaders are built either way. Also in the in-game menu."
msgstr "Az üzenetek, amelyeket a Cemu a sarokban mutat, amíg a játék árnyalókat és pipeline-okat fordít („Loaded 1200 shaders”). A Ki elrejti őket; az árnyalók így is lefordulnak. A játék menüjében is."

#: port/frontend/shell/settings.cpp:672 port/frontend/shell/settings.cpp:716
msgid "Higher is sharper but needs more power."
msgstr "A nagyobb élesebb, és jobban terheli a GPU-t."

#: port/frontend/shell/settings.cpp:673
msgid "How large 3D scenes are drawn before scaling to the TV. Higher is sharper but needs more power, and some games slow down more."
msgstr "Mekkora méretben készülnek a 3DS 3D-s jelenetei, mielőtt a tévére méreteződnek. A nagyobb élesebb és jobban terheli a GPU-t, és amikor egy játék visszaolvas egy képet, a várakozás is vele nő."

#. Settings > Graphics: a row that opens the textures' settings (the texture filter, custom textures)
#: port/frontend/shell/settings.cpp:680
msgid "Textures"
msgstr "Textúrák"

#. Settings > Graphics: a row that opens the textures' settings (the texture filter, custom textures)
#: port/frontend/shell/settings.cpp:680
msgid "The texture filter, and texture packs."
msgstr "A textúraszűrő és a textúracsomagok."

#: port/frontend/shell/settings.cpp:681
msgid "Texture filter and your own texture packs. Press Triangle on each for more."
msgstr "Egy szűrő, amely nagyításkor simítja a játék textúráit, és a saját textúracsomagjaid. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:682
msgid "Smooths textures as they are scaled up."
msgstr "Kisimítja a textúrákat nagyításkor."

#: port/frontend/shell/settings.cpp:683
msgid "Smooths textures as they are scaled up. None keeps them as the 3DS draws them. At high resolutions this is the heaviest setting: if a game stutters, try None first."
msgstr "Kisimítja a játék textúráit nagyításkor; a Nincs úgy hagyja őket, ahogy a 3DS rajzolja. A szűrő minden textúrát újrarajzol a belső felbontáson: nagy felbontáson ez a legköltségesebb beállítás. Ha egy játék akad, először próbáld a Nincs lehetőséget."

#: port/frontend/shell/settings.cpp:685
msgid "Texture packs from azahar/load/textures."
msgstr "Textúracsomagok az azahar/load/textures mappából."

#. {0} is the app's data folder: /data/ps5cemu, or the PS5CEMU-HAR-data folder on the drive the app is installed on
#: port/frontend/shell/settings.cpp:687
msgid "Texture packs in {0}/azahar/load/textures/<title ID>."
msgstr "Textúracsomagok a {0}/azahar/load/textures/<címazonosító> mappában, ahogy az asztali Azahar betölti őket."

#. Settings > Graphics' Shaders row, its value: where the 3DS's vertex shaders run, on the GPU (Hardware) or on the CPU (Software)
#: port/frontend/shell/settings.cpp:690
msgctxt "shaders"
msgid "Hardware"
msgstr "Hardveres"

#. Settings > Graphics' Shaders row, its value: where the 3DS's vertex shaders run, on the GPU (Hardware) or on the CPU (Software)
#: port/frontend/shell/settings.cpp:690
msgctxt "shaders"
msgid "Software"
msgstr "Szoftveres"

#: port/frontend/shell/settings.cpp:691
msgid "Where the 3DS's shaders run, and how new ones are built."
msgstr "Hol futnak a 3DS árnyalói, és hogyan készülnek az újak."

#: port/frontend/shell/settings.cpp:692
msgid "Hardware shaders, outline fix and async shader compile. Press Triangle on each for more."
msgstr "A hardveres árnyalók, a körvonaljavítás hozzájuk és az aszinkron árnyalófordítás. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:693
msgid "Hardware shaders"
msgstr "Hardveres árnyalók"

#: port/frontend/shell/settings.cpp:693
msgid "Off draws 3D exactly on the CPU. Off for Pokémon by default."
msgstr "Ki: pontos 3D a CPU-n. Pokémonnál ki."

#: port/frontend/shell/settings.cpp:694
msgid "On runs 3D on the PS5's GPU, the fastest way. Off runs it on the CPU: slower, but outlines and lighting are exact. Off by default for the 3DS Pokémon games, whose outlines, lighting and shadows glitch otherwise. Applies to the next game."
msgstr "Bekapcsolva a 3DS csúcspont-árnyalói a PS5 GPU-ján futnak, ez a leggyorsabb. Kikapcsolva a CPU-n futnak, az Azahar szoftveres árnyalóiként: lassabb, de a modell és a köré rajzolt körvonal ugyanúgy számolódik, a megvilágítás pedig háromszögenként javul. Alapból ki van kapcsolva a Pokémon X, Y, Omega Ruby, Alpha Sapphire, Sun, Moon, Ultra Sun és Ultra Moon játékoknál, amelyek körvonalai, megvilágítása és árnyékai különben hibásak. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:696
msgid "Outline fix"
msgstr "Körvonaljavítás"

#: port/frontend/shell/settings.cpp:696
msgid "Fixes moving black dots on outlined 3D models."
msgstr "Kijavítja a mozgó fekete pontokat a körvonalas 3D-modelleken."

#: port/frontend/shell/settings.cpp:697
msgid "Fixes moving black dots on outlined 3D models with hardware shaders on. For the Pokémon games, turn Hardware shaders off instead. Applies to the next game."
msgstr "Minden 3D-pozíciót kétszer ugyanúgy számol ki, ahogy az Azahar az Apple GPU-in. Olyan játékhoz, amely bekapcsolt hardveres árnyalókkal mozgó fekete pontokat mutat a körvonalas modelljein; a Pokémon játékok ehelyett a Hardveres árnyalók kikapcsolásával jelennek meg helyesen. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:708
msgid "3D for red and cyan glasses"
msgstr "3D piros-cián szemüveghez"

#: port/frontend/shell/settings.cpp:708
msgid "The 3DS's 3D, in red and cyan."
msgstr "A 3DS 3D-je pirosban és ciánban."

#: port/frontend/shell/settings.cpp:709
msgid "Shows the 3DS's 3D for red and cyan glasses, with the 3D slider all the way up. Colours change with it. Applies to the next game."
msgstr "A 3DS 3D-s képernyője a két szem képével egyben, pirossal a bal, ciánnal a jobb szemnek, hogy piros-cián szemüveggel 3D-ben lásd, ahogy az Azahar anaglif módja készíti, a 3D-csúszkát teljesen felhúzva. A színek megváltoznak. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:717
msgid "How large Lichii draws a game before scaling it to the TV. Higher values are sharper and use more graphics memory."
msgstr "Az a felbontás, amelyen az Lichii megrajzolja a játékot, mielőtt a tévéhez méretezi. A magasabb érték élesebb képet ad, és több grafikus memóriát használ."

#: port/frontend/shell/settings.cpp:718
msgid "How large games are drawn before scaling to the TV. 1x is 1080p docked and 720p handheld. Higher is sharper but needs more power and graphics memory. Applies to the next game."
msgstr "Mekkorára rajzolja az Eden a játékot, mielőtt a tévére skálázza, a játék saját képéhez mérve: az 1x dokkolva 1080p, kézi módban 720p. A magasabb élesebb, és többet kér a GPU-tól; a 3x-hez és a 4x-hez kell hozzá elég grafikus memória. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:725
msgid "Choose Bilinear, AMD FSR 1, Bicubic or Nearest neighbour. Applies when the next game starts."
msgstr "Válassz: Bilineáris, AMD FSR 1, Bikubikus vagy Legközelebbi szomszéd. A következő játék indításától érvényes."

#: port/frontend/shell/settings.cpp:726
msgid "Bilinear is soft, Bicubic sharper, Nearest neighbour keeps pixels square. AMD FSR 1 keeps edges clean for games below 4K, at a small GPU cost."
msgstr "A bilineáris lágy, a bikubikus élesebb; a Legközelebbi szomszéd négyzetesen tartja a pixeleket. Az AMD FSR 1 tisztán tartja a széleket a 4K alatt rajzolt játékokban, kicsivel több munkáért a GPU-tól."

#. Settings > Graphics on the Switch side: a row that opens FSR sharpening, anti-aliasing and Eden's ReShade looks
#: port/frontend/shell/settings.cpp:734
msgid "Picture effects"
msgstr "Képeffektek"

#. Settings > Graphics on the Switch side: a row that opens FSR sharpening, anti-aliasing and Eden's ReShade looks
#: port/frontend/shell/settings.cpp:734
msgid "Sharpening, anti-aliasing and ReShade."
msgstr "Élesség, élsimítás és ReShade-stílusok."

#: port/frontend/shell/settings.cpp:735
msgid "FSR sharpening, anti-aliasing and ReShade looks (built-in or your own). Press Triangle on each for more."
msgstr "FSR-élesség, amíg az AMD FSR 1 méretezi a képet; Eden élsimítása; és egy ReShade-stílus a kép fölött, Edené vagy egy saját. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:743
msgid "How much AMD FSR 1 sharpens the picture."
msgstr "Mennyire élesíti az AMD FSR 1 a képet."

#: port/frontend/shell/settings.cpp:744
msgid "How much AMD FSR 1 sharpens the picture. 100% is the most; each step down halves it. Also in the in-game menu."
msgstr "Mennyire élesíti az AMD FSR 1 a képet, miközben a tévére skálázza: a 100% a legtöbb, és minden lépés lejjebb a felére csökkenti. A játék menüjében is, ahol azonnal változik."

#: port/frontend/shell/settings.cpp:747
msgid "Smooths the jagged edges of the picture."
msgstr "Elsimítja a kép recés éleit."

#: port/frontend/shell/settings.cpp:748
msgid "FXAA smooths edges lightly, SMAA more cleanly, each at a small GPU cost. Also in the in-game menu."
msgstr "Az Eden élsimítása a játék képén: az FXAA enyhén simítja az éleket, az SMAA tisztábban, mindkettő a GPU kicsivel több munkájáért. Kikapcsolva, ahogy az Edenben. A játék menüjében is, ahol azonnal változik."

#: port/frontend/shell/settings.cpp:752
msgid "ASTC textures"
msgstr "ASTC-textúrák"

#: port/frontend/shell/settings.cpp:752
msgid "Compressed"
msgstr "Tömörített"

#: port/frontend/shell/settings.cpp:752
msgid "Full quality"
msgstr "Teljes minőség"

#: port/frontend/shell/settings.cpp:753
msgid "Compressed saves graphics memory; full quality looks best."
msgstr "A tömörített grafikus memóriát spórol; a teljes minőség néz ki a legjobban."

#: port/frontend/shell/settings.cpp:754
msgid "Many Switch games use ASTC textures, which must be converted for the PS5. Compressed saves memory; Full quality uses four times as much, for games whose textures look blocky. Applies to the next game."
msgstr "Sok Switch-játék ASTC-ben tárolja a textúráit, amit a PS5 GPU-ja nem tud olvasni: az Eden átalakítja őket. A tömörített kicsiben tartja őket, BC3-ként; a teljes minőség meghagyja őket, ahogy vannak, négyszeres grafikus memóriával, olyan játékhoz, amelynek a textúrái kockásnak tűnnek. A következő játéktól érvényes."

#. Settings > Graphics: a row that opens the output resolution, refresh rate and frame generation
#: port/frontend/shell/settings.cpp:764
msgid "Output to the TV"
msgstr "Kimenet a tévére"

#. Settings > Graphics: a row that opens the output resolution, refresh rate and frame generation
#: port/frontend/shell/settings.cpp:764
msgid "Output size, 120 Hz and frame generation."
msgstr "A kép mérete, 120 Hz és képkocka-generálás."

#: port/frontend/shell/settings.cpp:765
msgid "Output size, refresh rate and frame generation. Each applies to the next game."
msgstr "Az Lichii kimeneti mérete, képfrissítése és képkockagenerálása; mindegyik a következő játéknál lép életbe."

#: port/frontend/shell/settings.cpp:766
msgid "Output size, 120 Hz and frame generation. Each applies to the next game."
msgstr "Az Eden által a tévére küldött kép mérete, hogy 120 Hz-en küldi-e, és a ProsperoEden képkocka-generálása. Mindegyik a következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:768 port/frontend/shell/settings.cpp:769 port/frontend/shell/settings.cpp:770 port/frontend/shell/settings.cpp:771
msgid "The resolution sent to the TV. Applies to the next game."
msgstr "A kép mérete, amelyet az Eden a tévére küld. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:773
msgid "120 Hz"
msgstr "120 Hz"

#: port/frontend/shell/settings.cpp:773 port/frontend/shell/settings.cpp:774
msgid "For TVs that support 120 Hz. Applies to the next game."
msgstr "Olyan tévéhez, amely fogadja a 120 Hz-et. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:778
msgid "Frame generation, where supported. Applies to the next game."
msgstr "Az Lichii képkockagenerálása, ha ezt a buildet és grafikus hátteret támogatja. A következő játéknál lép életbe."

#. {0} is where Lossless.dll goes: /data/eden/user/lossless/Lossless.dll, or the same on the app's drive
#: port/frontend/shell/settings.cpp:780
msgid "Adds a frame between each pair, so a 30 fps game shows at 60. Uses Lossless Scaling if your own Lossless.dll is at {0}. Adds a little delay. Applies to the next game."
msgstr "A ProsperoEden saját képkocka-generálása: egy kép készül minden két képkocka közé, így egy 30 fps-es játék 60-nal látszik. Ez a Lossless Scaling generálása, ha a Lossless.dll saját példányod itt van: {0}, különben a MihawkGené. Többet kér a GPU-tól, és egy kis késleltetést ad hozzá. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:789
msgid "How the DS's screens are scaled."
msgstr "Hogyan méreteződnek a DS képernyői."

#: port/frontend/shell/settings.cpp:790
msgid "Sharp keeps pixels crisp and even at any size. Smooth blends them. Square pixels can look uneven at some sizes. Also in the in-game menu."
msgstr "Hogyan méreteződnek a DS 256 x 192-es képernyői a tévére. Az Éles minden képpontot bármilyen méretben négyzetesen és egyformán tart; a Lágy összemossa őket; a Négyzetes képpontok a legközelebbit veszi, egyenetlenül, ahol a méret nem egész szám. A játék menüje is módosítja."

#: port/frontend/shell/settings.cpp:794
msgid "Recompiler"
msgstr "Újrafordító"

#: port/frontend/shell/settings.cpp:795
msgid "Much faster than the interpreter."
msgstr "A melonDS JIT-je: sokkal gyorsabb az értelmezőjénél."

#: port/frontend/shell/settings.cpp:795
msgid "Not available: games run in the slower mode."
msgstr "Nincs futtatható memória: a lassabb értelmező fut."

#: port/frontend/shell/settings.cpp:796
msgid "Runs games much faster, when the PS5 allows it (Diagnostics shows whether it does). Turn it off for a game that runs wrong. Applies to the next game."
msgstr "A DS két processzorát a melonDS újrafordítójával futtatja a PS5 által adott futtatható memóriában (a Diagnosztika megmutatja, hogy ad-e), sokkal gyorsabban, mint az értelmezője. Ki: az értelmező, lassabban, olyan játékhoz, amelyet az újrafordító rosszul futtat. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:803
msgid "Screen layout"
msgstr "Képernyő-elrendezés"

#: port/frontend/shell/settings.cpp:803
msgid "How the two screens fit on the TV."
msgstr "Hogyan osztozik a két képernyő a tévén."

#: port/frontend/shell/settings.cpp:804
msgid "Stacked, top only, large top with small bottom, or side by side. In a game, touchpad click + R1 changes it."
msgstr "Egymás alatt, csak a felső, a felső nagyban az alsóval mellette, vagy a kettő egymás mellett. Játék közben az érintőpanel-kattintás + R1 a következőre vált."

#: port/frontend/shell/settings.cpp:808
msgid "For games held sideways, like a book."
msgstr "Az oldalra fordítva, könyvként tartott játékokhoz."

#: port/frontend/shell/settings.cpp:809
msgid "Turns both screens a quarter turn at a time, for games played with the DS held sideways. The touchpad follows the turned screen. Also in the in-game menu."
msgstr "Negyed fordulatonként együtt forgatja a DS két képernyőjét azokhoz a játékokhoz, amelyeknél a DS-t oldalra fordítva, könyvként kell tartani (Hotel Dusk). Az érintőpanel úgy mozgatja a kurzort az alsó képernyőn, ahogy a tévé mutatja. A játék menüje is módosítja."

#: port/frontend/shell/settings.cpp:810
msgid "Turns both screens a quarter turn at a time, for games played with the 3DS held sideways. The touchpad follows the turned screen. Also in the in-game menu."
msgstr "Negyed fordulatonként együtt forgatja a 3DS két képernyőjét azokhoz a játékokhoz, amelyeknél a 3DS-t oldalra fordítva, könyvként kell tartani. Az érintőpanel úgy mozgatja a kurzort az alsó képernyőn, ahogy a tévé mutatja. A játék menüje is módosítja."

#: port/frontend/shell/settings.cpp:813
msgid "A gap between the screens, like the hinge."
msgstr "A két képernyő egymástól elválasztva, ahogy a zsanér tartja őket."

#: port/frontend/shell/settings.cpp:814
msgid "Adds a gap between the two screens in any layout. Can be set per game, and in the in-game menu."
msgstr "Rés a két képernyő között, ahol csak mindkettő látszik: egymás alatt, egymás mellett vagy könyvként elforgatva. Egy játéknak lehet sajátja; a játék menüjének gyorsműveletei is módosítják."

#: port/frontend/shell/settings.cpp:818
msgid "Touch the bottom screen while only the top one shows."
msgstr "Az érintőpanel akkor is érinti, ha csak a felső képernyő látszik."

#: port/frontend/shell/settings.cpp:819
msgid "With only the top screen shown, the touchpad still touches the bottom screen, with a cursor on the top one. For games that ask for a touch now and then. Can be set per game, and in the in-game menu."
msgstr "Ha csak a felső képernyő van a tévén, az érintőpanel akkor is az alsó képernyőt érinti: a kurzor a felső fölött mozog, mintha ott lenne az alsó, azokhoz a játékokhoz, amelyek néha érintést kérnek (Star Fox 64 3D). Kikapcsolva az érintőpanel csak a megjelenített alsó képernyőt érinti. Egy játéknak lehet sajátja; a játék menüje is módosítja."

#: port/frontend/shell/settings.cpp:821
msgid "Artwork around the screens."
msgstr "Grafika a képernyők körül."

#: port/frontend/shell/settings.cpp:822
msgid "Artwork around the screens, in every layout. Also in the in-game menu."
msgstr "Grafika a képernyők körül, soha nem rajtuk. Minden elrendezést követ, és a játék menüje is módosítja."

#: port/frontend/shell/settings.cpp:832
msgid "Adjusts where touchpad touches land, for games where they're off. 0% and 100% leave it unchanged. Doesn't affect the remote touch screen. Applies to the next game."
msgstr "Eltolja és átméretezi, hová esik az érintőpanel kurzora a DS képernyőin, olyan játékhoz, ahol mellémegy: 0% és 100% változatlanul hagyja. A telefonon lévő érintőképernyő nem változik. A következő játéktól érvényes."

#. Settings > Screens' Touch row, its value: the right stick is the stylus
#: port/frontend/shell/settings.cpp:838
msgid "Stick as stylus"
msgstr "Kar mint ceruza"

#. Settings > Screens: a row that opens the touch screen's settings (where the touchpad's cursor lands, the right stick as the stylus)
#: port/frontend/shell/settings.cpp:840
msgid "Touch"
msgstr "Érintés"

#: port/frontend/shell/settings.cpp:841
msgid "Touch position, and the right stick as stylus."
msgstr "Hová kerül az érintőpad kurzora, és a jobb kar mint érintőceruza."

#: port/frontend/shell/settings.cpp:842
msgid "Adjusts where touches land, and lets the right stick drag a touch on the bottom screen. Press Triangle on each for more."
msgstr "Eltolja és méretezi, hová kerül az érintőpad kurzora a DS képernyőin, egy játékhoz, ahol mellé talál, és a jobb karral érintést húzhatsz az alsó képernyőn. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:843
msgid "Touch, left or right"
msgstr "Érintés, balra vagy jobbra"

#: port/frontend/shell/settings.cpp:844
msgid "Touch, up or down"
msgstr "Érintés, fel vagy le"

#: port/frontend/shell/settings.cpp:845
msgid "Touch, scale"
msgstr "Érintés, méretarány"

#. a DS setting: the right stick as the touch screen's stylus (DraStic has it), for Metroid Prime Hunters' aiming
#: port/frontend/shell/settings.cpp:847
msgid "The right stick as the stylus"
msgstr "A jobb kar mint érintőceruza"

#. a DS setting: the right stick as the touch screen's stylus (DraStic has it), for Metroid Prime Hunters' aiming
#: port/frontend/shell/settings.cpp:847
msgid "Push it to drag a touch on the bottom screen."
msgstr "Elmozdítva érintést húz az alsó képernyőn."

#: port/frontend/shell/settings.cpp:848
msgid "Pushing the right stick touches the middle of the bottom screen and drags as you push, for games that aim by touch. Let go to lift. Applies to the next game."
msgstr "Mozdítsd el a jobb kart, és az alsó képernyő a közepén megérintődik; az érintés húzódik, amíg tolod, és felemelkedik, amikor elengeded: így céloz a Metroid Prime Hunters. A kar irányai ilyenkor mást nem csinálnak. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:855
msgid "DualSense rumble, in games and the launcher."
msgstr "A DualSense rezgése, a játékokban és az indítóban."

#: port/frontend/shell/settings.cpp:856
msgid "Off: no rumble in games or the launcher. Applies to every system."
msgstr "Kikapcsolva a DualSense soha nem rezeg, sem játékban, sem az indítóban. Minden oldalon ugyanígy."

#: port/frontend/shell/settings.cpp:859 port/frontend/shell/settings.cpp:911
msgid "How far a stick moves before it counts."
msgstr "Mennyit mozdul egy kar, mielőtt számít."

#: port/frontend/shell/settings.cpp:860
msgid "How far each stick moves before the game sees it. Raise it if there is drift; lower it for finer control. Also in the in-game menu."
msgstr "Mennyit mozdul a kar, mielőtt a játék észreveszi, mindkét karnál. Növeld, ha egy szereplő vagy a kamera elmozdul, amikor elengeded a kart; csökkentsd a finomabb irányításhoz. A játék menüjében is."

#: port/frontend/shell/settings.cpp:868
msgid "Hold it to press repeatedly."
msgstr "Tartsd lenyomva, és magától nyomja újra és újra."

#: port/frontend/shell/settings.cpp:869
msgid "Holding this button presses it about 15 times a second, for games that make you mash. None turns it off. Applies to every player."
msgstr "Válassz egy DualSense-gombot: amíg játékban lenyomva tartod, másodpercenként kb. tizenötször magától lenyomódik és felenged, azokhoz a játékokhoz, ahol nyomkodni kell. A gomb megtartja a hozzárendelését. A Nincs kikapcsolja. Ezen az oldalon minden játékosnak megvan."

#. Settings > Controls: a row that opens the buttons' settings (each button, the defaults)
#: port/frontend/shell/settings.cpp:876
msgid "Each button, and the defaults."
msgstr "Minden gomb és az alapértékek."

#: port/frontend/shell/settings.cpp:877
msgid "Choose the DualSense button for each Switch button, or reset to default."
msgstr "Melyik DualSense-gomb nyomja a Switch egyes gombjait, és a gombok és a holtzóna az eredeti állapotban."

#. Settings > Controls > Buttons: the row that opens the list of every button and the DualSense button on it
#: port/frontend/shell/settings.cpp:879 port/frontend/shell/settings.cpp:927
msgid "Each button"
msgstr "Minden gomb"

#: port/frontend/shell/settings.cpp:880
msgid "Choose the DualSense button for each Switch button. By default A is on Circle and B on Cross as on the Switch, + is Options and - is touchpad click."
msgstr "Melyik DualSense-gomb nyomja a Switch egyes gombjait. Alapból az A a Körön, a B a Kereszten van, ahol a Switchen; a + az Options, a - az érintőpad kattintása. Az irányítókereszt és a karok a Switchéi maradnak."

#: port/frontend/shell/settings.cpp:882 port/frontend/shell/settings.cpp:882 port/frontend/shell/settings.cpp:932
msgid "Default buttons and deadzone."
msgstr "Alapértelmezett gombok és holtzóna."

#: port/frontend/shell/settings.cpp:892
msgid "Cross sets this player's controller, motion and buttons."
msgstr "Kereszt: ennek a játékosnak a kontrollere, mozgása és gombjai."

#: port/frontend/shell/settings.cpp:893
msgid "Set to a real Wii Remote, but none found. Cross to change it."
msgstr "Valódi Wii Remote-re állítva, de egyik sem található. Kereszt, hogy cserélje ki."

#: port/frontend/shell/settings.cpp:894
msgid "This player's controller, motion, vibration, deadzones and buttons. Player 1 is the user who started Playtendoh; other signed-in users are players 2 to 4."
msgstr "Amit a játék e játékos kezében lát, valamint a mozgása, rezgése, holtzónái és gombjai. Az 1. játékos az a bejelentkezett felhasználó, aki elindította az alkalmazást; a többi bejelentkezett felhasználó DualSense-e a 2–4. játékos."

#: port/frontend/shell/settings.cpp:905
msgid "A on Circle as on the console, or on Cross."
msgstr "Hol van A: a Körön, mint a konzolon, vagy a Kereszten."

#: port/frontend/shell/settings.cpp:906
msgid "A on Circle and B on Cross as on the console, or A on Cross and B on Circle as on PlayStation. X and Y swap to match. Also in the in-game menu."
msgstr "A a Körön és B a Kereszten, ahol a konzolon vannak, vagy A a Kereszten és B a Körön, ahogy a PlayStation-játékok megerősítenek. Az X és az Y ennek megfelelően felcserélődik. A játék menüjében is."

#: port/frontend/shell/settings.cpp:910
msgid "Use DualSense motion for games that aim or steer by tilting the 3DS."
msgstr "A DualSense giroszkópja és gyorsulásmérője magáé a 3DS-é helyett, azokhoz a játékokhoz, ahol a konzol döntésével céloz vagy kormányoz az ember."

#: port/frontend/shell/settings.cpp:912
msgid "How far a stick moves before the game sees it, for the circle pad and C-stick. Raise it if there is drift; lower it for finer control."
msgstr "Mennyit mozdul egy kar, mielőtt a játék észreveszi – a Circle Padhez és a C-karhoz. Növeld, ha valami elcsúszik, miután elengedted a kart; csökkentsd a finomabb irányításért."

#: port/frontend/shell/settings.cpp:925
msgid "Each button, the turbo button, and the defaults."
msgstr "Minden gomb, a turbógomb és az alapértékek."

#: port/frontend/shell/settings.cpp:926
msgid "Choose the DualSense button for each button, set a turbo button, or reset to default."
msgstr "Melyik DualSense-gomb nyomja az egyes gombokat, egy gomb, amely újra és újra nyom, amíg nyomva tartod, és a vezérlés az eredeti állapotban."

#: port/frontend/shell/settings.cpp:928
msgid "Choose the DualSense button for each 3DS button. By default A is on Circle and B on Cross as on the 3DS. The circle pad is the left stick, the C-stick the right stick, and the touchpad the touch screen."
msgstr "Melyik DualSense-gomb nyomja meg a 3DS egyes gombjait. Alapértelmezés szerint A a Körön és B a Kereszten van, ahol a 3DS-en; a Circle Pad a bal kar, a C-Stick a jobb, az érintőpanel pedig az érintőképernyő."

#: port/frontend/shell/settings.cpp:929
msgid "Choose the DualSense button for each DS button. By default A is on Circle and B on Cross as on the DS. The left stick is a second D-pad, the touchpad is the touch screen, and holding R3 blows into the mic."
msgstr "Melyik DualSense-gomb nyomja meg a DS egyes gombjait. Alapértelmezés szerint A a Körön és B a Kereszten van, ahol a DS-en; a bal kar egy második iránygomb, az érintőpanel az érintőképernyő, az R3 lenyomva tartása pedig belefúj a mikrofonba."

#: port/frontend/shell/settings.cpp:932
msgid "Default buttons, motion and deadzone."
msgstr "Alapértelmezett gombok, mozgás és holtzóna."

#: port/frontend/shell/settings.cpp:932
msgid "The default buttons, motion and deadzone."
msgstr "Az alapértelmezett gombok, mozgás és holtzóna."

#: port/frontend/shell/settings.cpp:941
msgid "Region"
msgstr "Régió"

#: port/frontend/shell/settings.cpp:941
msgid "The emulated 3DS's region."
msgstr "Az emulált 3DS régiója."

#: port/frontend/shell/settings.cpp:942
msgid "Automatic uses each game's region. A game from another region may not start. Applies to the next game."
msgstr "Az Automatikus minden játék saját régióját veszi. Egy másik régióra készült játék nem indulhat el, vagy más nyelveket mutathat. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:944
msgid "The emulated 3DS's language."
msgstr "Az emulált 3DS nyelve."

#: port/frontend/shell/settings.cpp:945
msgid "The language games use if they follow the console. Applies to the next game."
msgstr "Az a nyelv, amelyen a konzolt követő játékok a szövegüket mutatják. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:950
msgid "The emulated 3DS's CPU speed."
msgstr "Az emulált 3DS processzorsebessége."

#: port/frontend/shell/settings.cpp:951
msgid "Higher can smooth a game that slows down, but needs more power. Lower can speed up some games. 100% is a real 3DS. Also in the in-game menu."
msgstr "Milyen gyorsan fut az emulált processzor egy 3DS-éhez képest: a magasabb stabilizálhat egy játékot, amely ott lassul, ahol egy 3DS nem lassulna, és többet kér a PS5-től; az alacsonyabb gyorsíthat egy saját ütemezése által visszafogott játékot. A 100 % egy 3DS. A játék menüjében is."

#: port/frontend/shell/settings.cpp:953
msgid "Home Menu"
msgstr "HOME menü"

#: port/frontend/shell/settings.cpp:953
msgid "Start"
msgstr "Indítás"

#: port/frontend/shell/settings.cpp:953
msgid "Run Artic Setup first"
msgstr "Előbb futtasd az Artic Setupot"

#: port/frontend/shell/settings.cpp:954
msgid "The 3DS Home Menu, from your console's files."
msgstr "A 3DS HOME menüje, a konzolod fájljaiból."

#: port/frontend/shell/settings.cpp:955
msgid "Starts the 3DS Home Menu. Needs your console's system files, copied with Artic Setup."
msgstr "Elindítja a 3DS HOME menüjét, miután az Artic Base beállítása átmásolta a saját konzolod rendszerfájljait (Artic Base)."

#: port/frontend/shell/settings.cpp:962
msgid "Docked looks sharpest. Handheld runs lighter."
msgstr "Dokkolva: a tévé képe. Kézi: a konzol saját kijelzőjének képe."

#: port/frontend/shell/settings.cpp:963
msgid "Docked draws for a TV (1080p for most games). Handheld draws for the console's screen (720p) and runs lighter. A few games differ between them. Applies to the next game."
msgstr "Dokkolva a játékok tévére rajzolnak, a legélesebben (a legtöbb 1080p-ben); kézi módban a konzol saját kijelzőjére (720p), ami kevesebbet kér a GPU-tól. Néhány játék másként néz ki vagy játszható az egyes módokban. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:970
msgid "Automatic gives each game the controller it expects, usually a Pro Controller. If a game doesn't work with it, try a Joy-Con pair. Handheld is player 1 only. Also in the in-game menu."
msgstr "Az Automatikus minden játéknak azt a vezérlőt adja, amelyet elfogad: a legtöbbnek Pro Controllert. Egy játék, amely nem működik vele, működhet Joy-Con-párral; a Kézi csak az 1. játékosé, a konzol saját képernyőjén játszott játékokhoz. A játék menüjében is."

#: port/frontend/shell/settings.cpp:978
msgid "Compared to the Switch's speed. Above 100% can let a 30 fps game reach 60, but games that time by frames play faster. None runs as fast as possible. Applies to the next game."
msgstr "A Switch saját sebességének arányában. 100% felett egy 30 fps-re korlátozott játék elérheti a 60-at, ahol a PS5-nek bőven van ideje, és egy játék, amely a képkockáival méri az időt, gyorsabban fut. A Nincs olyan gyorsan fut, ahogy a PS5 bírja. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:985 port/frontend/shell/settings.cpp:986
msgid "The language Switch games use. Automatic matches the menus."
msgstr "A nyelv, amelyet a Switch-játékok látnak. Automatikus: a menüké."

#: port/frontend/shell/settings.cpp:992
msgid "Memory"
msgstr "Memória"

#: port/frontend/shell/settings.cpp:993 port/frontend/shell/settings.cpp:994
msgid "4 GB matches the Switch. More is for mods that need it. Applies to the next game."
msgstr "4 GB a Switch sajátja. Több az ezt kérő modokhoz. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:1004
msgid "Compact memory"
msgstr "Tömör memória"

#: port/frontend/shell/settings.cpp:1004
msgid "Saves memory for the biggest games."
msgstr "Kicsin tartja a játék nagyrészt üres memóriáját, a legnagyobb játékokhoz."

#: port/frontend/shell/settings.cpp:1006
msgid "Precompile code"
msgstr "Kód előfordítása"

#: port/frontend/shell/settings.cpp:1006
msgid "Prepares code from past sessions ahead of time, for fewer hitches."
msgstr "Lefordítja a korábbi munkamenetek kódját, mielőtt a játéknak kell: kevesebb akadás."

#: port/frontend/shell/settings.cpp:1009
msgid "Fast GPU"
msgstr "Gyors GPU"

#: port/frontend/shell/settings.cpp:1009
msgid "Lowest GPU accuracy. Faster, but some effects may look wrong."
msgstr "Az Eden legalacsonyabb GPU-pontossága: gyorsabb, néhány effekt hibásan rajzolódhat."

#: port/frontend/shell/settings.cpp:1011
msgid "Unsafe CPU"
msgstr "Nem biztonságos CPU"

#: port/frontend/shell/settings.cpp:1011
msgid "Faster, less exact maths. A few games misbehave."
msgstr "Gyorsabb, pontatlan lebegőpontos számítás. Gyorsabb; néhány játék hibásan viselkedik."

#: port/frontend/shell/settings.cpp:1013
msgid "Unsafe DMA"
msgstr "Nem biztonságos DMA"

#: port/frontend/shell/settings.cpp:1013
msgid "Faster memory transfers. A few games show glitches."
msgstr "Az Eden nem biztonságos DMA-pontossága: gyorsabb, néhány játékban hibák látszanak."

#: port/frontend/shell/settings.cpp:1015
msgid "Reactive flushing"
msgstr "Reaktív ürítés"

#: port/frontend/shell/settings.cpp:1015
msgid "Keeps some effects correct. Off is faster, but some effects break."
msgstr "Helyesen tartja a GPU munkáját visszaolvasó effekteket. Kikapcsolva gyorsabb; néhány elromlik."

#: port/frontend/shell/settings.cpp:1017
msgid "Skip cache invalidation"
msgstr "Gyorsítótár-érvénytelenítés kihagyása"

#: port/frontend/shell/settings.cpp:1017
msgid "Faster, and rarely causes problems."
msgstr "Kevesebb CPU-gyorsítótár-érvénytelenítés: gyorsabb, ritkán hibás."

#. Settings > Performance: a row that opens Eden's accuracy shortcuts (Fast GPU, Unsafe CPU, ...); its value: how many are changed
#: port/frontend/shell/settings.cpp:1033
msgid "Accuracy"
msgstr "Pontosság"

#. Settings > Performance: a row that opens Eden's accuracy shortcuts (Fast GPU, Unsafe CPU, ...); its value: how many are changed
#. a group of an emulator's options in Settings: how many it holds, and how many are not the emulator's own values
#: port/frontend/shell/settings.cpp:1033 port/frontend/shell/settings.cpp:1783
msgid "{0} changed"
msgid_plural "{0} changed"
msgstr[0] "{0} módosítva"
msgstr[1] "{0} módosítva"

#: port/frontend/shell/settings.cpp:1034
msgid "Speed shortcuts. Faster, but less exact."
msgstr "Az Eden gyorsításai: gyorsabb, némelyik kevésbé pontos."

#: port/frontend/shell/settings.cpp:1035
msgid "These trade accuracy for speed, for every Switch game or just one. Press Triangle on each for more."
msgstr "A Gyors GPU, Nem biztonságos CPU, Nem biztonságos DMA, Reaktív ürítés és Gyorsítótár-érvénytelenítés kihagyása pontosságot cserél sebességre, minden Switch-játékhoz vagy csak egyhez. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:1042
msgid "The emulated DS's language."
msgstr "Az emulált DS nyelve."

#: port/frontend/shell/settings.cpp:1043
msgid "The DS's language, used by many games. Japanese, English, French, German, Italian, Spanish and Chinese; others use English. Applies to the next game."
msgstr "A DS saját nyelve, amelyet sok játék követ. A DS-en japán, angol, francia, német, olasz, spanyol és kínai van; bármely más nyelv angolt ad. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:1046
msgid "Found in melonds/bios."
msgstr "Megtalálva itt: melonds/bios."

#: port/frontend/shell/settings.cpp:1046
msgid "Not found: the built-in BIOS is used."
msgstr "Nem található: a játékokat a melonDS beépített BIOS-a futtatja."

#. {0} is the folder for a DS's own BIOS and firmware dumps
#: port/frontend/shell/settings.cpp:1048
msgid "Uses bios7.bin, bios9.bin and firmware.bin from your own DS, in {0}. Without them, most games run fine on the built-in BIOS. Applies to the next game."
msgstr "A saját DS-edből kiolvasott bios7.bin, bios9.bin és firmware.bin itt: {0}. A melonDS ezeken fut, ha ott vannak és ez be van kapcsolva. Nélkülük a saját helyettesítői (FreeBIOS) ugyanúgy futtatják a legtöbb játékot. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:1051
msgid "Noise"
msgstr "Zaj"

#: port/frontend/shell/settings.cpp:1051
msgid "Silence"
msgstr "Csend"

#: port/frontend/shell/settings.cpp:1051
msgid "A recording"
msgstr "Felvétel"

#: port/frontend/shell/settings.cpp:1052
msgid "What the DS hears while R3 is held. Applies to the next game."
msgstr "Amit a DS hall, amíg az R3 nyomva van. A következő játéktól érvényes."

#. {0} is melonDS's folder, /data/melonds or where the DS's files are; keep <the game's file name> as a placeholder
#: port/frontend/shell/settings.cpp:1054
msgid "A 16-bit mono WAV (8,000 to 48,000 Hz, up to 16 MB): {0}/microphone/<the game's file name>.wav for one game, or {0}/microphone.wav for all. It loops while R3 is held."
msgstr "A felvétel egy WAV-fájl, 16 bites mono PCM 8000–48 000 Hz-en és legfeljebb 16 MB: {0}/microphone/<a játék fájlneve>.wav egy játékhoz, {0}/microphone.wav a többihez. Újra és újra lejátszódik, amíg az R3 nyomva van, mindig az elejéről. Mikrofonról semmi sem kerül felvételre."

#: port/frontend/shell/settings.cpp:1055
msgid "GBA cartridge in Slot-2"
msgstr "GBA-kazetta a 2-es foglalatban"

#: port/frontend/shell/settings.cpp:1056
msgid "For DS games that read a GBA game in the second slot. It does not play GBA games."
msgstr "Azokhoz a DS-játékokhoz, amelyek egy GBA-játékot olvasnak a második foglalatukban, mint a Pokémon Pal Parkja. GBA-játékokat nem futtat."

#. {0} is melonDS's folder, /data/melonds or where the DS's files are
#: port/frontend/shell/settings.cpp:1058
msgid "Put the GBA game in {0}/slot2 named like the DS game, ending .gba, with its .sav if it has one. Its save is then kept in {0}/slot2-saves; your files are not changed. Applies to the next game."
msgstr "Tedd a GBA-játékot a {0}/slot2 mappába a DS-játék fájlnevével, .gba végződéssel, és mellé a .sav fájlját, ha van. A kazetta mentése ezután a {0}/slot2-saves mappában van, az oda tett fájljaid pedig sosem változnak. Az a DS-játék, amelyhez nincs ott kazetta, üres foglalattal indul. A következő játéktól érvényes."

#: port/frontend/shell/settings.cpp:1063 port/frontend/shell/setup.cpp:211 port/main_ps5.cpp:578 port/main_ps5.cpp:581 port/main_ps5.cpp:582
msgid "Switch 2 games"
msgstr "Switch 2-játékok"

#: port/frontend/shell/settings.cpp:1065
msgid "Where your games are. Cross picks another."
msgstr "Hol vannak a játékaid. A Kereszt másik mappát választ."

#. {0} is the app's data folder: /data/ps5cemu, or the PS5CEMU-HAR-data folder on the drive the app is installed on
#: port/frontend/shell/settings.cpp:1067
msgid "Wii U games: .wua, .wud, .wux, folders with code, content and meta, or in .zip, .7z or .rar. Encrypted .wud and .wux need keys in {0}/keys.txt."
msgstr "A Wii U-játékaid: .wua, .wud, .wux, vagy code, content és meta mappák, önállóan vagy .zip, .7z vagy .rar archívumban. A titkosított .wud és .wux fájlokhoz kellenek a kulcsaik a {0}/keys.txt fájlban."

#: port/frontend/shell/settings.cpp:1068
msgid "3DS games: decrypted .3ds, .cci, .cxi, .3dsx or compressed dumps, or in .zip, .7z or .rar. Install CIA files with Install a CIA file. Encrypted games won't start: decrypt them on your 3DS with GodMode9."
msgstr "A 3DS-játékaid: .3ds vagy .cci, .cxi, .3dsx és az Azahar tömörített dumpjai, visszafejtve, önállóan vagy .zip, .7z vagy .rar archívumban, itt vagy az almappákban. A CIA-fájlok telepíthetők (CIA-fájl telepítése). A titkosított dumpok nem indulnak, kulccsal sem: előbb fejtsd vissza őket a 3DS-eden (GodMode9)."

#: port/frontend/shell/settings.cpp:1069 port/main_ps5.cpp:579
msgid "Switch 2 game folders need ExeFS and RomFS. Put each game in its own folder; keep updates and DLC where Lichii expects them."
msgstr "A Switch 2-játékok mappáihoz ExeFS és RomFS szükséges. Minden játékot külön mappába tegyél; a frissítéseket és DLC-ket ott tartsd, ahol az Lichii keresi őket."

#: port/frontend/shell/settings.cpp:1070
msgid "Switch games: .nsp and .xci files, each alone or in its own folder with its update and DLC."
msgstr "A Switch-játékaid: .nsp és .xci fájlok, önállóan vagy mindegyik a saját mappájában a frissítésével és DLC-ivel."

#: port/frontend/shell/settings.cpp:1071
msgid "DS games: .nds files, or in .zip, .7z or .rar, here or in subfolders."
msgstr "DS-játékaid: .nds fájlok, önállóan vagy .zip, .7z vagy .rar archívumban, itt vagy az almappáiban."

#: port/frontend/shell/settings.cpp:1072 port/frontend/shell/shares.cpp:292
msgid "Looking…"
msgstr "Keresés…"

#: port/frontend/shell/settings.cpp:1072
msgid "Search this system's folder again."
msgstr "Ennek az oldalnak a mappája, újra."

#: port/frontend/shell/settings.cpp:1073
msgid "Searches this system's folder again for added or removed games."
msgstr "Újra átnézi ennek az oldalnak a mappáját: az azóta hozzáadott játékok megjelennek, az eltávolítottak eltűnnek."

#: port/frontend/shell/settings.cpp:1076
msgid "Look on network shares at every start"
msgstr "Hálózati megosztások átnézése minden indításkor"

#: port/frontend/shell/settings.cpp:1077
msgid "Off shows the games found last time, at once."
msgstr "Ki: a legutóbb talált játékok, azonnal."

#: port/frontend/shell/settings.cpp:1078
msgid "Searching a network share each time can be slow with a large library. Off shows the games found last time right away; use Look for games now after adding some. Folders on the PS5 or USB are always searched."
msgstr "A hálózati megosztáson lévő játékmappát minden alkalommal átnézi, amikor az oldala megnyílik, és az alkalmazás minden játék után újraindul: nagy könyvtárnál ez hosszú várakozás. Kikapcsolva az oldal azonnal megmutatja a játékokat, amelyeket legutóbb ott talált, a Játékok keresése most pedig újra keres, ha hozzáadtál néhányat. A PS5-ön vagy USB-meghajtón lévő mappákat így is, úgy is minden alkalommal átnézi."

#. Settings > Game files' Keys and firmware row, its value when the firmware is missing and the keys are there
#: port/frontend/shell/settings.cpp:1084 port/frontend/shell/settings.cpp:1099
msgid "Firmware missing"
msgstr "Hiányzik a firmware"

#. Settings > Game files' Keys and firmware row, its value when prod.keys is missing and the firmware is there
#: port/frontend/shell/settings.cpp:1085 port/frontend/shell/settings.cpp:1101
msgid "Keys missing"
msgstr "Hiányoznak a kulcsok"

#. Settings > Game files' Keys and firmware row, its value when prod.keys is missing and the firmware is there
#: port/frontend/shell/settings.cpp:1085 port/frontend/shell/settings.cpp:1101
msgid "Missing"
msgstr "Hiányzik"

#. Settings > Game files: one row for the Switch's keys (prod.keys) and its firmware, which Eden needs
#: port/frontend/shell/settings.cpp:1086 port/frontend/shell/settings.cpp:1103
msgid "Keys and firmware"
msgstr "Kulcsok és firmware"

#: port/frontend/shell/settings.cpp:1088 port/frontend/shell/setup.cpp:333
msgid "Firmware is missing: some games need it"
msgstr "Hiányzik a firmware: néhány játéknak szüksége van rá"

#: port/frontend/shell/settings.cpp:1088
msgid "Lichii found keys and firmware."
msgstr "Az Lichii megtalálta a kulcsokat és a firmware-t."

#: port/frontend/shell/settings.cpp:1089
msgid "Put your own prod.keys in {0}/keys. Neither Playtendoh nor Lichii includes keys."
msgstr "Tedd a saját prod.keys fájlodat ide: {0}/keys. Sem a Playtendoh, sem az Lichii nem tartalmaz kulcsokat."

#: port/frontend/shell/settings.cpp:1090
msgid "Put your own Switch firmware files in {0}/firmware. Neither app includes firmware."
msgstr "A saját Switch-firmwarefájljaidat ide tedd: {0}/firmware. Egyik alkalmazás sem tartalmaz firmware-t."

#: port/frontend/shell/settings.cpp:1105 port/frontend/shell/setup.cpp:311
msgid "No firmware yet: many games need it to start"
msgstr "Még nincs firmware: sok játéknak kell az induláshoz"

#: port/frontend/shell/settings.cpp:1106
msgid "Your keys are ready."
msgstr "Az Eden tudja olvasni a játékaidat."

#: port/frontend/shell/settings.cpp:1107 port/frontend/shell/setup.cpp:304
msgid "Switch games need your own console's keys: prod.keys (and title.keys) from your Switch, in {0}/keys. Playtendoh does not include keys."
msgstr "Az Eden a saját konzolod kulcsaival olvassa a Switch-játékokat: a Switchedből kimentett prod.keys (és title.keys) ide: {0}/keys. A Playtendoh nem tartalmaz kulcsokat."

#: port/frontend/shell/settings.cpp:1110 port/frontend/shell/setup.cpp:314
msgid "Many Switch games need firmware: the .nca files from your Switch, in {0}/firmware. Playtendoh does not include firmware."
msgstr "Sok Switch-játéknak kellenek a konzol saját rendszerfájljai: a firmware-je .nca fájljai, a Switchedből kimentve, ide: {0}/firmware. A Playtendoh nem tartalmaz firmware-t."

#: port/frontend/shell/settings.cpp:1118 port/frontend/shell/shares.cpp:536
msgid "Network shares"
msgstr "Hálózati megosztások"

#: port/frontend/shell/settings.cpp:1118
msgid "{0} share"
msgid_plural "{0} shares"
msgstr[0] "{0} megosztás"
msgstr[1] "{0} megosztás"

#: port/frontend/shell/settings.cpp:1119
msgid "Games on a computer or a NAS, over SMB or NFS."
msgstr "Játékok számítógépen vagy NAS-on, SMB-n vagy NFS-en."

#: port/frontend/shell/settings.cpp:1120
msgid "Add a folder shared by a computer or NAS, then choose a games folder on it in the folder browser. Nothing is written to it; saves and installs stay on the PS5. Wired is better than Wi-Fi."
msgstr "Egy Windows, macOS vagy Linux rendszerű számítógép vagy egy NAS által megosztott mappa, ott olvasva, ahol van: add hozzá itt, majd válassz rajta játékmappát a mappaböngészővel, ahol minden megosztás egy fül. Soha semmi nem íródik rá; a mentések és a telepítések a PS5-ön maradnak. Wii U-játékokhoz a kábel jobb, mint a Wi-Fi."

#: port/frontend/shell/settings.cpp:1125 port/frontend/shell/setup.cpp:250
msgid "Wii U disc keys"
msgstr "Wii U-lemezkulcsok"

#: port/frontend/shell/settings.cpp:1125 port/frontend/shell/setup.cpp:252
msgid "keys.txt found"
msgstr "keys.txt megtalálva"

#: port/frontend/shell/settings.cpp:1126
msgid "Only encrypted .wud and .wux need them."
msgstr "Csak a titkosított .wud és .wux fájlokhoz kellenek."

#: port/frontend/shell/settings.cpp:1126 port/frontend/shell/setup.cpp:252
msgid "keys.txt is missing: only encrypted .wud and .wux need it"
msgstr "keys.txt hiányzik: csak a titkosított .wud és .wux fájlokhoz kell"

#. {0} is the app's data folder: /data/ps5cemu, or the PS5CEMU-HAR-data folder on the drive the app is installed on
#: port/frontend/shell/settings.cpp:1128 port/frontend/shell/setup.cpp:255
msgid "Encrypted .wud and .wux need their disc keys in {0}/keys.txt, one per line. Other formats need none."
msgstr "A titkosított .wud és .wux dumpokhoz kellenek a lemezkulcsaik, soronként egy, ebben a fájlban: {0}/keys.txt. A visszafejtett dumpoknak, a .wua fájloknak és a code, content és meta mappáknak nem kell."

#. Settings > Game files: a row that opens Updates and DLC and Mods from USB
#: port/frontend/shell/settings.cpp:1130
msgid "Updates, DLC and mods"
msgstr "Frissítések, DLC-k és modok"

#. Settings > Game files: a row that opens Updates and DLC and Mods from USB
#: port/frontend/shell/settings.cpp:1130
msgid "Install from your drives, and add mods."
msgstr "Telepítés a meghajtóidról és Cemu-modok."

#: port/frontend/shell/settings.cpp:1131
msgid "Install updates and DLC found on your drives, and copy mods from ps5cemu/mods on a USB drive. Press Triangle on each for more."
msgstr "A meghajtóidon talált frissítések és DLC-k, mindegyik egy gombnyomással a Wii U tárhelyére telepítve, és az USB-meghajtó ps5cemu/mods mappájából másolt Cemu-modok. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:1132
msgid "Found on your drives. Install each with one press."
msgstr "A meghajtóidon találva, mindegyik egy gombnyomással telepíthető."

#: port/frontend/shell/settings.cpp:1133
msgid "Searches USB drives, extended storage, the games folder and /data for updates, DLC and games (folders with code, content and meta), listed by game. Cross installs one, Square installs all new ones. Triangle chooses another folder."
msgstr "Frissítéseket, DLC-ket és játékokat (code, content és meta mappákat) keres minden csatlakoztatott USB-meghajtón és bővített tárhelyen, a játékok mappájában és a /data alatt, és játékonként listázza őket a jelenleg telepítettekkel együtt. A Kereszt egyet telepít, a Négyzet minden újat; mind a Wii U tárhelyére (mlc01) kerül, ahogy a Cemu „Install game title, update or DLC” funkciójánál. Ott a Háromszög bármilyen más mappát választ."

#: port/frontend/shell/settings.cpp:1134
msgid "Mods from USB"
msgstr "Modok USB-ről"

#: port/frontend/shell/settings.cpp:1134
msgid "Mods from ps5cemu/mods on your drives."
msgstr "Cemu-modok a meghajtóid ps5cemu/mods mappájából."

#: port/frontend/shell/settings.cpp:1135
msgid "Copies mods from ps5cemu/mods on a USB drive. Each appears, off, on its game's Graphic packs page. A mod is a graphic pack (a folder with rules.txt), or a folder with content and aoc folders inside a folder named with the game's title ID. You can also add mods from a game's menu. See docs/GUIDE.md on GitHub."
msgstr "Átmásolja az USB-meghajtó ps5cemu/mods mappájában lévő modokat az alkalmazás grafikus csomagjai közé, ahol mindegyik megjelenik a játéka Grafikus csomagok oldalán, kikapcsolva, amíg be nem kapcsolod. A mod egy Cemu grafikus csomag (egy rules.txt fájlt tartalmazó mappa), vagy ha anélkül osztották meg, egy content és aoc mappákat tartalmazó mappa a játéka címazonosítójáról elnevezett mappában. A játék menüjében is van Modok hozzáadása USB-ről, amely az ilyen modokat ahhoz a játékhoz rendeli. A GitHubon lévő útmutató, a docs/GUIDE.md, többet mond."

#: port/frontend/shell/settings.cpp:1139
msgid "Install a CIA file"
msgstr "CIA-fájl telepítése"

#: port/frontend/shell/settings.cpp:1139
msgid "A game, an update or DLC."
msgstr "Játék, frissítés vagy DLC."

#: port/frontend/shell/settings.cpp:1140
msgid "Installs a CIA file. Updates and DLC join their game; games join the library. Circle cancels."
msgstr "Telepít egy CIA-t a 3DS tárhelyére, ahogy az Azahar Install CIA funkciója: a frissítés vagy DLC a játékához kerül, a játék pedig a könyvtárba. A kör futás közben megszakítja."

#. Settings > Game files: a row opening the list of every system's folder; {0} how many have a folder of their own, {1} how many systems
#: port/frontend/shell/settings.cpp:1163 port/frontend/shell/shell.cpp:2879
msgid "A folder for each system"
msgstr "Külön mappa minden rendszernek"

#. Settings > Game files: a row opening the list of every system's folder; {0} how many have a folder of their own, {1} how many systems
#: port/frontend/shell/settings.cpp:1163
msgid "{0} of {1} on their own"
msgstr "{0} vagy {1} önállóan"

#: port/frontend/shell/settings.cpp:1164
msgid "Keep a system's files together with the rest, or in a folder of its own."
msgstr "Tartsa a rendszer fájljait a többivel együtt, vagy egy saját mappában."

#: port/frontend/shell/settings.cpp:1165
msgid "Saves, BIOS files and settings for every system are kept together in {0}, unless you give a system its own folder. Moving is quick and nothing is deleted. Playtendoh restarts to do it. Some emulators always use their own folder."
msgstr "A mentések, a BIOS fájlok és minden rendszer beállításai a {0}-ben tárolódnak, hacsak nem ad egy rendszernek saját mappát. Az áthelyezés gyors, és semmi sem törlődik. A Playtendoh újraindul ehhez. Egyes emulátorok mindig a saját mappájukat használják."

#. Settings > Game files: a system whose emulator always keeps a folder of its own
#: port/frontend/shell/settings.cpp:1172
msgid "Its emulator always keeps its own folder."
msgstr "Az emulátora mindig megtartja a saját mappáját."

#: port/frontend/shell/settings.cpp:1179
msgid "Moves the next time Playtendoh starts."
msgstr "A Playtendoh következő indításakor mozog."

#: port/frontend/shell/settings.cpp:1180
msgid "On: this system's files get their own folder. Off: kept with the rest."
msgstr "Be: ennek a rendszernek a fájljai saját mappát kapnak. Ki: a többivel együtt tartva."

#: port/frontend/shell/settings.cpp:1181
msgid "Own folder"
msgstr "Saját mappa"

#: port/frontend/shell/settings.cpp:1181
msgid "Together"
msgstr "Együtt"

#. {0} is a file or folder already where one would be moved to
#: port/frontend/shell/settings.cpp:1186
msgid "Cannot move"
msgstr "Nem helyezhető át"

#. {0} is a file or folder already where one would be moved to
#: port/frontend/shell/settings.cpp:1186
msgid "In the way: {0}"
msgstr "Útban van: {0}"

#: port/frontend/shell/settings.cpp:1212
msgid "Account games start on"
msgstr "Fiók, amellyel a játékok indulnak"

#: port/frontend/shell/settings.cpp:1213
msgid "Set by your PS5 user, because One account for each PS5 user is on."
msgstr "A PS5-felhasználód választja: be van kapcsolva az Egy fiók minden PS5-felhasználónak."

#: port/frontend/shell/settings.cpp:1214
msgid "The next game uses these saves."
msgstr "A következő játék ezekkel a mentésekkel indul. A már futó játék megtartja a sajátjait."

#: port/frontend/shell/settings.cpp:1215
msgid "Each Wii U account has its own saves, as on a Wii U. The next game you start uses this one."
msgstr "Minden Wii U-fióknak saját mentései vannak minden játékhoz, ahogy a Wii U-n. A következő elindított játék az itt látható fiókot használja; a már futó játék azt tartja meg, amellyel elindult."

#: port/frontend/shell/settings.cpp:1218
msgid "One account for each PS5 user"
msgstr "Egy fiók minden PS5-felhasználónak"

#: port/frontend/shell/settings.cpp:1219
msgid "Whoever starts Playtendoh plays on their own saves."
msgstr "Aki elindítja a Playtendoh-t, a saját mentéseivel játszik."

#: port/frontend/shell/settings.cpp:1220
msgid "Each PS5 user gets their own Wii U account, named after them, so everyone keeps their own saves."
msgstr "Az alkalmazást elindító PS5-felhasználó saját Wii U-fiókon játszik, amely első alkalommal a PS5-nevével jön létre, így a testvérek mind megtartják a saját mentéseiket, egyszerűen azzal, hogy a saját PS5-felhasználójukról indítják az alkalmazást."

#. Settings > Accounts and saves: a row that opens New account, Rename and Delete an account
#: port/frontend/shell/settings.cpp:1222
msgid "Manage accounts"
msgstr "Fiókok kezelése"

#. Settings > Accounts and saves: a row that opens New account, Rename and Delete an account
#. how many Wii U accounts there are, of the twelve a Wii U has at most
#: port/frontend/shell/settings.cpp:1222 port/frontend/shell/settings.cpp:1225
msgid "{0} of 12"
msgstr "{0}/12"

#. Settings > Accounts and saves: a row that opens New account, Rename and Delete an account
#: port/frontend/shell/settings.cpp:1222
msgid "Add, rename or delete accounts."
msgstr "Új, átnevezett vagy törölt."

#: port/frontend/shell/settings.cpp:1223
msgid "Add an account, rename the current one, or delete another. Saves always stay in the Wii U's storage."
msgstr "Új fiók, új név annak a fióknak, amelyen a játékok indulnak, vagy egy másik fiók törlése. A mentések mindig a Wii U tárhelyén maradnak."

#. how many Wii U accounts there are, of the twelve a Wii U has at most
#: port/frontend/shell/settings.cpp:1225
msgid "New account"
msgstr "Új fiók"

#: port/frontend/shell/settings.cpp:1226
msgid "A new account starts with no saves."
msgstr "Az új fiók mentések nélkül indul."

#: port/frontend/shell/settings.cpp:1226
msgid "Up to ten letters. Games then start on it."
msgstr "Nevezd el a billentyűzettel, legfeljebb tíz betű. Ezután a játékok ezzel indulnak."

#: port/frontend/shell/settings.cpp:1227
msgid "Rename {0}"
msgstr "{0} átnevezése"

#: port/frontend/shell/settings.cpp:1227
msgid "The account games start on."
msgstr "A fiók, amellyel a játékok indulnak."

#: port/frontend/shell/settings.cpp:1228
msgid "The name games show, up to ten letters. Its saves are kept."
msgstr "A név, amelyet a játékok ehhez a fiókhoz mutatnak, legfeljebb tíz betű. A mentései úgy maradnak, ahogy vannak."

#: port/frontend/shell/settings.cpp:1236
msgid "Delete an account"
msgstr "Fiók törlése"

#: port/frontend/shell/settings.cpp:1237
msgid "Only one"
msgstr "Csak egy"

#: port/frontend/shell/settings.cpp:1238
msgid "There is only one account, and games start on it."
msgstr "Csak egy fiók van, és a játékok azzal indulnak."

#: port/frontend/shell/settings.cpp:1238
msgid "Left and Right choose which. Its saves stay in the Wii U's storage."
msgstr "A Bal és a Jobb választja ki, melyiket. A mentései a Wii U tárhelyén maradnak."

#: port/frontend/shell/settings.cpp:1239
msgid "Removes the account. Its saves stay in the Wii U's storage and backups. You can't delete the account games start on."
msgstr "A fiók törlődik; a mentései a Wii U tárhelyén (és minden biztonsági mentésben) maradnak, így semmi sem vész el. A fiók, amellyel a játékok indulnak, nem törölhető: előbb válassz másikat."

#. a backup or restore of the saves, finished ({0}: how many files)
#: port/frontend/shell/settings.cpp:1262 port/frontend/shell/settings.cpp:1921
msgid "Done: {0} file"
msgid_plural "Done: {0} files"
msgstr[0] "Kész: {0} fájl"
msgstr[1] "Kész: {0} fájl"

#. a backup of the saves, as it copies ({0}: a percentage)
#: port/frontend/shell/settings.cpp:1279 port/frontend/shell/settings.cpp:1292 port/frontend/shell/settings.cpp:1959 port/frontend/shell/settings.cpp:1978
msgid "Copying: {0}"
msgstr "Másolás: {0}"

#. the newest backup of the saves: when, and on which drive
#: port/frontend/shell/settings.cpp:1282 port/frontend/shell/settings.cpp:1961
msgid "Last: {0} · {1}"
msgstr "Utolsó: {0} · {1}"

#: port/frontend/shell/settings.cpp:1283
msgid "Every system's saves, save states and Wii U accounts."
msgstr "Minden oldal mentései, mentett állapotai és Wii U-fiókjai."

#: port/frontend/shell/settings.cpp:1284
msgid "Copies every system's saves, save states and Wii U accounts, plus your settings, to PS5CEMU-HAR-saves on the first USB drive, in a dated folder. Games are not copied, so backups stay small."
msgstr "Átmásolja a Wii U mentéseit (minden fiókét, a fiókokkal együtt), a 3DS mentéseit, extra adatait és mentett állapotait, a DS mentéseit és mentett állapotait, valamint a Switch mentéseit a felhasználói profiljaival együtt az első csatlakoztatott USB-meghajtó PS5CEMU-HAR-saves mappájába, egy dátummal és idővel elnevezett mappába. A játékokat soha, így a biztonsági mentés kicsi marad. A beállítások is velük mennek: az indítóé, az egyes játékok sajátjai és a kontrollereké."

#: port/frontend/shell/settings.cpp:1290 port/frontend/shell/settings.cpp:1976
msgid "No backups found"
msgstr "Nincs biztonsági mentés"

#: port/frontend/shell/settings.cpp:1293 port/frontend/shell/settings.cpp:1975
msgid "Restore from USB"
msgstr "Visszaállítás USB-ről"

#: port/frontend/shell/settings.cpp:1294
msgid "Back up first, or plug in the drive with your backups."
msgstr "Előbb készíts biztonsági mentést, vagy csatlakoztasd a mentéseidet tartalmazó meghajtót."

#: port/frontend/shell/settings.cpp:1294 port/frontend/shell/settings.cpp:1979
msgid "Left and Right choose which backup, the newest first."
msgstr "A Bal és a Jobb választja ki a biztonsági mentést, a legújabbal kezdve."

#. {0} is the app's data folder: /data/ps5cemu, or the PS5CEMU-HAR-data folder on the drive the app is installed on
#: port/frontend/shell/settings.cpp:1296
msgid "Restores the chosen backup's saves and settings. Current saves are moved to {0}/saves-before first, so nothing is lost. Playtendoh then restarts."
msgstr "A kiválasztott biztonsági mentés mentéseit oda teszi vissza, ahonnan jöttek. Az ott lévő jelenlegi mentések előbb a {0}/saves-before mappába kerülnek, így semmi sem vész el; azok a mentések, amelyek nincsenek a biztonsági mentésben, maradnak, ahogy vannak. A beállításai is visszakerülnek, és a Playtendoh újraindul, hogy használja őket."

#. Settings > Online: a row that opens the box art's settings (GameTDB on or off, downloading the covers again)
#: port/frontend/shell/settings.cpp:1317 port/frontend/shell/settings.cpp:1325 port/frontend/shell/setup.cpp:346
msgid "Box art"
msgstr "Borítók"

#: port/frontend/shell/settings.cpp:1318
msgid "Covers for the library, from libretro's thumbnails."
msgstr "Borítók a könyvtárhoz, a libretro bélyegképeiből."

#: port/frontend/shell/settings.cpp:1318
msgid "Covers for the library, from GameTDB."
msgstr "Borítók a könyvtárhoz a GameTDB-ről."

#: port/frontend/shell/settings.cpp:1319
msgid "Download covers from GameTDB, or download missing or all covers again. For Switch, choose box art or game icons."
msgstr "Letöltődjenek-e a borítók a GameTDB-ről (art.gametdb.com), és a hiányzók vagy mind újbóli letöltése. A Switch oldalon az is, hogy egy játék a borítóját vagy a saját ikonját mutatja."

#: port/frontend/shell/settings.cpp:1322
msgid "Downloads each new game's cover from GameTDB. Off: no covers are downloaded."
msgstr "Amikor egy játék először megjelenik, a borítója letöltődik a GameTDB-ből (art.gametdb.com) a dobozán lévő azonosító alapján. Ki: semmi több nem töltődik le."

#: port/frontend/shell/settings.cpp:1325
msgid "Switch covers"
msgstr "Switch-borítók"

#: port/frontend/shell/settings.cpp:1325
msgid "Game icons"
msgstr "Játékikonok"

#: port/frontend/shell/settings.cpp:1325
msgid "GameTDB's box art, or each game's own icon."
msgstr "Borítók a GameTDB-ből, vagy minden játék saját ikonja."

#: port/frontend/shell/settings.cpp:1326
msgid "Box art comes from GameTDB. Game icons come from the games, as on the Switch home menu. A Game.png or Game.jpg next to a game is always used."
msgstr "A borítók a GameTDB-ből jönnek, minden játéknál a neve alapján megtalálva. A játékikonok a játékok sajátjai, a fájljaikból olvasva, ahogy a Switch HOME menüje mutatja őket. Egy játék melletti kép (Game.png vagy Game.jpg) mindkét esetben a borítója."

#: port/frontend/shell/settings.cpp:1328
msgid "Tries again for every game on this system without a cover. Covers download in the background."
msgstr "Újra lekéri a GameTDB-ről ezen az oldal minden olyan játékának borítóját, amelynek nincs, azokét is, amelyekhez korábban nem volt. A borítók a háttérben töltődnek le, amíg az indítót használod."

#: port/frontend/shell/settings.cpp:1331
msgid "Downloads every cover on this system again. Useful if a cover is wrong or broken."
msgstr "Ezen az oldalon minden játék borítóját újra letölti, lecserélve a meglévőket. Hasznos, ha egy borító rossz vagy sérültnek látszik."

#: port/frontend/shell/settings.cpp:1335
msgid "Send reports"
msgstr "Jelentések küldése"

#: port/frontend/shell/settings.cpp:1335
msgid "How games run, with nothing about you."
msgstr "Hogyan futnak a játékok, és semmi sem szól rólad."

#. {0} is the address of the page that lists every field a report has
#: port/frontend/shell/settings.cpp:1337
msgid "When a game ends, a short report is sent: the game, how it ended, its settings, the PS5's firmware and model, and the end of the log with addresses and folder names removed. Never your PSN name, serial, addresses, accounts or saves. Nothing is sent while you play. Off deletes reports waiting to be sent. Every field: {0}"
msgstr "Amikor egy játék véget ér, egy rövid jelentést küldenek: a játék, hogyan ért véget, beállításai, a PS5 firmware-je és modellje, valamint a napló vége a címek és mappanevek eltávolításával. Soha ne adja meg a PSN nevét, sorozatát, címét, fiókját vagy mentését. Játék közben nem küld el semmit. Ki törli az elküldésre váró jelentéseket. Minden mező: {0}"

#: port/frontend/shell/settings.cpp:1341
msgid "Play from your 3DS, or copy its system files."
msgstr "Játék a 3DS-edről, és beállítás róla."

#: port/frontend/shell/settings.cpp:1342
msgid "Artic Base plays a game from your 3DS over the network; saves stay on the 3DS. Artic Setup copies your 3DS's system files, for the Home Menu and games that need them."
msgstr "Az Artic Base egy játékot futtat a hálózatodon lévő 3DS-ről, a mentései a 3DS-en maradnak; az Artic Setup egy 3DS rendszerfájljait másolja az Azaharba, a HOME menühöz és az azokat igénylő játékokhoz."

#: port/frontend/shell/settings.cpp:1348
msgid "A room lets Switch games play local wireless together online. The room chosen here is joined when a Switch game starts; then choose Local Wireless (or local play) in the game."
msgstr "A szoba egy szerver, ahol a Switch-játékok megtalálják egymást a helyi vezeték nélküli játékhoz, mint az asztali Edenben és a ProsperoEdenben. Az itt választott szobába minden Switch-játék indulásakor belép: aztán válaszd a játékban a Helyi vezeték nélküli játékot (vagy a helyi játékot). Ha egy szobába nem lehet belépni, ide jössz vissza az okkal."

#. Settings > Online on the Switch side: a row that opens the rooms for the games' local wireless play
#: port/frontend/shell/settings.cpp:1350
msgid "Multiplayer"
msgstr "Többjátékos"

#. Settings > Online on the Switch side: a row that opens the rooms for the games' local wireless play
#: port/frontend/shell/settings.cpp:1350 port/frontend/shell/settings.cpp:1355
msgid "None: games play offline"
msgstr "Nincs: a játékok offline futnak"

#: port/frontend/shell/settings.cpp:1351
msgid "Play local wireless games online."
msgstr "Szobák a játékok helyi vezeték nélküli játékához, online."

#: port/frontend/shell/settings.cpp:1356
msgid "Joined when a Switch game starts. Cross goes back to offline."
msgstr "Belép, amikor egy Switch-játék elindul. A kereszt újra offline-ra vált."

#: port/frontend/shell/settings.cpp:1356
msgid "Choose a public room below, or a private one."
msgstr "Válassz lent egy nyilvános szobát, vagy egy privátot."

#: port/frontend/shell/settings.cpp:1359
msgid "Nickname"
msgstr "Becenév"

#: port/frontend/shell/settings.cpp:1359
msgid "Your name in the room."
msgstr "A neved a szobában."

#: port/frontend/shell/settings.cpp:1360
msgid "What others in the room see. 4 to 20 letters, digits, spaces, dots, dashes or underscores."
msgstr "Amit mások látnak rólad egy szobában: 4–20 latin betű, számjegy, szóköz, pont, kötőjel vagy aláhúzás, ahogy az Eden elfogadja."

#: port/frontend/shell/settings.cpp:1362
msgid "Private room"
msgstr "Privát szoba"

#: port/frontend/shell/settings.cpp:1363
msgid "Cross to enter one"
msgstr "Kereszt a megadásához"

#: port/frontend/shell/settings.cpp:1364
msgid "Join a room by address, port and password."
msgstr "Egy szoba a címe, portja és jelszava alapján."

#: port/frontend/shell/settings.cpp:1365
msgid "For a room someone shared with you: its address (name or IPv4), UDP port (usually 24872) and password, if any."
msgstr "Egy szoba, amelynek a címét valaki megadta neked: a címe (név vagy IPv4-cím), az UDP-portja (24872, hacsak mást nem mondanak) és a jelszava, ha van."

#: port/frontend/shell/settings.cpp:1368
msgid "No public rooms right now"
msgstr "Most nincs nyilvános szoba"

#: port/frontend/shell/settings.cpp:1369
msgid "{0} room"
msgid_plural "{0} rooms"
msgstr[0] "{0} szoba"
msgstr[1] "{0} szoba"

#: port/frontend/shell/settings.cpp:1370
msgid "Public rooms"
msgstr "Nyilvános szobák"

#: port/frontend/shell/settings.cpp:1370
msgid "Cross downloads the list again."
msgstr "A kereszt újra letölti a listát."

#: port/frontend/shell/settings.cpp:1371
msgid "Featured rooms first, then the busiest. Rooms for another version can't be joined."
msgstr "A ProsperoEden nyilvános szobáinak listája: előbb a saját kiemelt szobái, aztán a többi, a legtelibbek elöl. Az Eden másik verziójához tartozó szobába nem lehet belépni."

#: port/frontend/shell/settings.cpp:1378 port/frontend/shell/shares.cpp:317 port/frontend/shell/shares.cpp:489
msgid "Password"
msgstr "Jelszó"

#. one of ProsperoEden's own rooms, which its list puts first
#: port/frontend/shell/settings.cpp:1381
msgid "Featured"
msgstr "Kiemelt"

#: port/frontend/shell/settings.cpp:1383
msgid "Another version"
msgstr "Másik verzió"

#: port/frontend/shell/settings.cpp:1385
msgid "{0} (chosen)"
msgstr "{0} (választva)"

#: port/frontend/shell/settings.cpp:1386
msgid "Any game"
msgstr "Bármely játék"

#: port/frontend/shell/settings.cpp:1393
msgid "Community graphic packs"
msgstr "Közösségi grafikus csomagok"

#: port/frontend/shell/settings.cpp:1393
msgid "Cross checks GitHub for newer ones."
msgstr "A kereszt újabbakat keres a GitHubon."

#: port/frontend/shell/settings.cpp:1394
msgid "Community graphic packs for Wii U games, downloaded from GitHub. They download in the background the first time the Wii U opens."
msgstr "A Cemu közösségi grafikus csomagjai a GitHub legújabb kiadásából, ha az újabb a telepítetteknél. Nincsenek benne az alkalmazásban: amikor a Wii U oldal először indul el nélkülük, a háttérben letöltődnek."

#: port/frontend/shell/settings.cpp:1400
msgid "Earn achievements in DS, GameCube, Wii, N64, SNES, NES, Game Boy, Virtual Boy and Pokémon mini games. Only a sign-in token is kept on the PS5, never your password. Save states, cheats and speed still work."
msgstr "Szerezz jutalmakat a DS, GameCube, Wii, N64, SNES, NES, Game Boy, Virtual Boy, Pokémon mini játékokban. A PS5 csak egy bejelentkezési tokent tárol, a jelszava soha. Az állapotok mentése, a csalások és a sebesség továbbra is működnek."

#: port/frontend/shell/settings.cpp:1405
msgid "{1} · {0} point"
msgid_plural "{1} · {0} points"
msgstr[0] "{1} · {0} pont"
msgstr[1] "{1} · {0} pont"

#: port/frontend/shell/settings.cpp:1405
msgid "Hold Cross to sign out"
msgstr "Kijelentkezéshez tartsd nyomva a keresztet"

#: port/frontend/shell/settings.cpp:1406
msgid "Signed in on every console that has achievements."
msgstr "Minden olyan konzolra bejelentkezve, amely rendelkezik eredményekkel."

#: port/frontend/shell/settings.cpp:1409
msgid "Cross to sign in"
msgstr "Kereszt: bejelentkezés"

#: port/frontend/shell/settings.cpp:1410
msgid "Sign in once for every console that has achievements."
msgstr "Jelentkezzen be egyszer minden jutalmakkal rendelkező konzolhoz."

#: port/frontend/shell/settings.cpp:1411
msgid "Unlock notices"
msgstr "Értesítés a teljesítményekről"

#: port/frontend/shell/settings.cpp:1411
msgid "Show unlocks as PS5 notifications."
msgstr "Minden teljesítmény PS5-értesítésként."

#: port/frontend/shell/settings.cpp:1412
msgid "Shows unlocks, and your progress when a game starts, as PS5 notifications. Off: see them in the in-game menu."
msgstr "Egy megszerzett teljesítmény, és a játék indulásakor a számuk, a PS5 saját értesítéseiként. Ki: csak a játékmenü Teljesítmények pontjában láthatók."

#: port/frontend/shell/settings.cpp:1416
msgid "Playtendoh updates"
msgstr "Playtendoh-frissítések"

#: port/frontend/shell/settings.cpp:1416
msgid "Cross checks GitHub for a newer version."
msgstr "A kereszt újabb verziót keres a GitHubon."

#: port/frontend/shell/settings.cpp:1417
msgid "Playtendoh checks for updates each time it starts. Cross checks again or installs the new version, then restarts. Your games, saves and settings are kept."
msgstr "A Playtendoh minden indításkor megkérdezi a GitHubot a legújabb kiadásról. A kereszt újra rákérdez, vagy telepíti a talált újabb verziót: a kiadás fájljai letöltődnek, ellenőrződnek és a jelenlegiek helyére kerülnek, az alkalmazás pedig újraindul. A játékaid, mentéseid és beállításaid úgy maradnak, ahogy vannak."

#. {0} is the version the last update replaced, as in 5.0.0
#: port/frontend/shell/settings.cpp:1422
msgid "Go back to {0}"
msgstr "Vissza ehhez: {0}"

#: port/frontend/shell/settings.cpp:1423
msgid "The version before the last update."
msgstr "Az utolsó frissítés előtti verzió, változatlanul megőrizve."

#: port/frontend/shell/settings.cpp:1424
msgid "Hold Cross to go back to the version before the last update. Playtendoh restarts. Your games, saves and settings are kept."
msgstr "Az utolsó frissítés megőrizte az általa lecserélt verziót. A Kereszt nyomva tartása visszateszi annak fájljait ezek helyére, és a Playtendoh újraindul azzal a verzióval. A játékaid, mentéseid és beállításaid nem változnak. Az újabb verziót induláskor nem ajánlja fel újra; ez az oldal továbbra is megtalálja."

#: port/frontend/shell/settings.cpp:1429
msgid "Put each system's files back first: Settings > Game files > A folder for each system."
msgstr "Előbb tedd vissza minden rendszer fájljait: Beállítások > Játékfájlok > Külön mappa minden rendszernek."

#: port/frontend/shell/settings.cpp:1447
msgid "Theme"
msgstr "Téma"

#: port/frontend/shell/settings.cpp:1449
msgid "The launcher's colours, corners and background. Make your own as a JSON file in {0}/themes; the text below this page says how. Games and in-game menus don't change."
msgstr "Hogyan néz ki az indító: a színei, a sarkai és ami a menük mögött mozog. Minden témában ugyanazok a képernyők és gombok vannak. Készítsd el a sajátodat JSON-fájlként ide: {0}/themes, ezek bármelyikéből kiindulva: az oldal alatti szöveg elmondja, hogyan. Csak az indító változik: a játékok menüi és maguk a játékok olyanok maradnak, amilyenek."

#: port/frontend/shell/settings.cpp:1455
msgid "How the Library is laid out."
msgstr "A könyvtár elrendezése."

#: port/frontend/shell/settings.cpp:1456
msgid "Classic shows one console at a time, with Recently played on top. Orbit is a dial for picking a console, with recent games in the centre. EmulationStation (ES-DE) is a separate launcher, downloaded the first time you choose it. Your games, settings and saves stay the same."
msgstr "A Classic egyszerre egy konzolt jelenít meg, a Legutóbbi lejátszással a tetején. Az Orbit egy tárcsa a konzol kiválasztásához, középpontjában a legutóbbi játékokkal. A EmulationStation (ES-DE) egy külön indító, amely az első választáskor töltődik le. A játékok, a beállítások és a mentések változatlanok maradnak."

#: port/frontend/shell/settings.cpp:1461
msgid "EmulationStation (ES-DE) shows the same games with its own themes. It's a separate download of about 850 MB and stays through updates. Games still play here with the same settings, saves and in-game menu. Hold L1 while Playtendoh starts to use this launcher instead."
msgstr "A EmulationStation (ES-DE) ugyanazokat a játékokat mutatja, saját témáival. Ez egy külön letölthető körülbelül 850 MB, és a frissítések alatt marad. A játékok továbbra is ugyanazokkal a beállításokkal, mentésekkel és játékon belüli menüvel játszhatók itt. Tartsa lenyomva a L1 gombot, miközben a Playtendoh ezt az indítót kezdi használni helyette."

#: port/frontend/shell/settings.cpp:1465
msgid "Asking GitHub…"
msgstr "GitHub kérdezés…"

#: port/frontend/shell/settings.cpp:1472
msgid "Hold Cross to remove"
msgstr "Az eltávolításhoz tartsa lenyomva a Kereszt-t"

#: port/frontend/shell/settings.cpp:1472
msgid "Cross to download · {0} MB"
msgstr "Kereszt letölthető · {0} MB"

#: port/frontend/shell/settings.cpp:1475
msgid "Installed. Choose it as the Layout above."
msgstr "Telepítve. Válassza ki a fenti elrendezésként."

#: port/frontend/shell/settings.cpp:1475
msgid "A separate launcher, as a download."
msgstr "Külön indító, letöltésként."

#. Settings > Launcher: a row that opens which sides the bar shows (Wii U, Switch, DS, 3DS)
#: port/frontend/shell/settings.cpp:1483
msgid "Systems"
msgstr "Oldalak"

#. Settings > Launcher: a row that opens which sides the bar shows (Wii U, Switch, DS, 3DS)
#: port/frontend/shell/settings.cpp:1483
msgid "Which systems the bar shows."
msgstr "Mely rendszereket mutatja a sáv."

#: port/frontend/shell/settings.cpp:1484
msgid "Choose which systems the bar shows. Hidden systems keep their games and settings. At least one stays on."
msgstr "Az oldalak, amelyeket a sáv kínál, a négy bármilyen kombinációjában. Egy elrejtett oldal megtartja a játékait és beállításait, és visszajönnek, amikor újra bekapcsolod. Legalább egy oldal bekapcsolva marad."

#: port/frontend/shell/settings.cpp:1488
msgid "This system's games, in the bar."
msgstr "Ennek a rendszernek a játékai a sávon."

#: port/frontend/shell/settings.cpp:1488
msgid "Show this system in the bar. Hidden systems keep their games and settings. At least one stays on."
msgstr "Hogy a sáv megmutatja-e ezt az oldalt. Elrejtve a játékai és beállításai megmaradnak, és visszajönnek, ha újra bekapcsolod. Legalább egy oldal bekapcsolva marad."

#: port/frontend/shell/settings.cpp:1490
msgid "Wii U"
msgstr "Wii U oldal"

#: port/frontend/shell/settings.cpp:1490
msgid "Wii U games, in the bar."
msgstr "A Cemu játékai a sávon."

#: port/frontend/shell/settings.cpp:1491
msgid "Show the Wii U in the bar. Hidden systems keep their games and settings. At least one stays on."
msgstr "Hogy a sáv megmutatja-e a Wii U oldalt (Cemu). Elrejtve a játékai és beállításai megmaradnak, és visszajönnek, ha újra bekapcsolod. Legalább egy oldal bekapcsolva marad."

#: port/frontend/shell/settings.cpp:1493 port/frontend/shell/shell.cpp:1672
msgid "Switch"
msgstr "Váltás"

#: port/frontend/shell/settings.cpp:1493
msgid "Switch games, in the bar."
msgstr "Az Eden játékai a sávon."

#: port/frontend/shell/settings.cpp:1494
msgid "Show the Switch in the bar. Hidden systems keep their games and settings. At least one stays on."
msgstr "Hogy a sáv megmutatja-e a Switch oldalt (Eden). Elrejtve a játékai és beállításai megmaradnak, és visszajönnek, ha újra bekapcsolod. Legalább egy oldal bekapcsolva marad."

#: port/frontend/shell/settings.cpp:1495
msgid "DS"
msgstr "DS oldal"

#: port/frontend/shell/settings.cpp:1495
msgid "DS games, in the bar."
msgstr "A melonDS játékai a sávon."

#: port/frontend/shell/settings.cpp:1496
msgid "Show the DS in the bar. Hidden systems keep their games and settings. At least one stays on."
msgstr "Hogy a sáv megmutatja-e a DS oldalt (melonDS). Elrejtve a játékai és beállításai megmaradnak, és visszajönnek, ha újra bekapcsolod. Legalább egy oldal bekapcsolva marad."

#: port/frontend/shell/settings.cpp:1497
msgid "3DS"
msgstr "3DS oldal"

#: port/frontend/shell/settings.cpp:1497
msgid "3DS games, in the bar."
msgstr "Az Azahar játékai a sávon."

#: port/frontend/shell/settings.cpp:1498
msgid "Show the 3DS in the bar. Hidden systems keep their games and settings. At least one stays on."
msgstr "Hogy a sáv megmutatja-e a 3DS oldalt (Azahar). Elrejtve a játékai és beállításai megmaradnak, és visszajönnek, ha újra bekapcsolod. Legalább egy oldal bekapcsolva marad."

#: port/frontend/shell/settings.cpp:1500
msgid "3D box art"
msgstr "3D doboz art"

#: port/frontend/shell/settings.cpp:1500
msgid "Covers as boxes, with a spine."
msgstr "Dobozos borítások, gerinccel."

#: port/frontend/shell/settings.cpp:1501
msgid "Each cover drawn as its box, turned a little, with its spine. Off: flat covers."
msgstr "Mindegyik borító dobozaként van megrajzolva, kissé elfordítva, a gerincével. Ki: lapos borítók."

#: port/frontend/shell/settings.cpp:1502
msgid "Game pictures behind menus"
msgstr "Játékképek a menük mögött"

#: port/frontend/shell/settings.cpp:1502
msgid "The selected game's cover, blurred, behind the menus."
msgstr "A kijelölt játék borítója, elmosva, a képernyők mögött."

#: port/frontend/shell/settings.cpp:1503
msgid "The selected game's picture fills the background, blurred and dimmed. Off: just the game's colours."
msgstr "A kijelölt játék képe kitölti a képernyőt a menük mögött, elmosva és elsötétítve, így a kijelölés mozgatása az egész képernyőt megváltoztatja. Ki: csak a játék színei."

#: port/frontend/shell/settings.cpp:1504
msgid "Library filters"
msgstr "Könyvtárszűrők"

#: port/frontend/shell/settings.cpp:1504
msgid "A row of filters above the list."
msgstr "Mind, Nemrég hozzáadott, Kedvencek: egy sor a lista fölött."

#: port/frontend/shell/settings.cpp:1505
msgid "Filters above the list: All, Recently added (last 30 days), Favourites, and for Wii U, Graphic packs on. Off: just Sort and Search."
msgstr "Egy sor szűrő a könyvtár listája fölött: Mind, Nemrég hozzáadott (az utolsó 30 nap), Kedvencek és a Wii U oldalon Grafikus csomaggal, mindegyik a számával. Ki: a listában minden játék benne van, és a Rendezés és a Keresés elég neki."

#: port/frontend/shell/settings.cpp:1513 port/frontend/shell/settings.cpp:1523
msgid "Larger text"
msgstr "Nagyobb szöveg"

#: port/frontend/shell/settings.cpp:1513 port/frontend/shell/settings.cpp:1525
msgid "High contrast"
msgstr "Nagy kontraszt"

#: port/frontend/shell/settings.cpp:1514 port/frontend/shell/settings.cpp:1527
msgid "Reduce motion"
msgstr "Kevesebb mozgás"

#. Settings > Launcher: a row that opens Larger text, High contrast, Reduce motion and Hold to confirm
#: port/frontend/shell/settings.cpp:1520
msgid "Accessibility"
msgstr "Akadálymentesség"

#: port/frontend/shell/settings.cpp:1521
msgid "Larger text, high contrast, reduced motion and hold to confirm."
msgstr "Nagyobb szöveg, nagy kontraszt, kevesebb mozgás, nyomva tartás a megerősítéshez."

#: port/frontend/shell/settings.cpp:1522
msgid "Text size, contrast, motion, and how long to hold Cross to confirm. Press Triangle on each for more."
msgstr "Egy fokkal nagyobb szöveg, átlátszatlan panelek teljes erősségű szöveggel, áttűnések mozgás helyett, és mennyi ideig kell nyomva tartani a Keresztet ahhoz, ami nem vonható vissza. A Háromszög minden sornál többet mond."

#: port/frontend/shell/settings.cpp:1523
msgid "Makes all text a step larger."
msgstr "Minden szövegméret egy fokkal nagyobb."

#: port/frontend/shell/settings.cpp:1524
msgid "Makes every text size one step larger."
msgstr "Minden szövegstílus egy fokkal nagyobb: a feliratok 20-ról 23-ra, az olvasandó szöveg 26-ról 30-ra."

#: port/frontend/shell/settings.cpp:1525
msgid "Opaque panels, full-strength text, a thicker ring."
msgstr "Átlátszatlan panelek, teljes erejű szöveg, vastagabb gyűrű."

#: port/frontend/shell/settings.cpp:1526
msgid "Opaque panels instead of glass, all text at full strength, a thicker focus ring and no grain or pictures behind the menus."
msgstr "Üveg helyett átlátszatlan panelek, minden szöveg teljes erővel, vastagabb kijelölőgyűrű, és se szemcse, se képek a menük mögött."

#: port/frontend/shell/settings.cpp:1527
msgid "Fades instead of motion."
msgstr "Áttűnések mozgás helyett."

#: port/frontend/shell/settings.cpp:1528
msgid "Animations become short fades, and the background stays still."
msgstr "A rugózó animációkból rövid áttűnések lesznek; a menük mögött semmi sem úszik, „lélegzik” vagy emelkedik."

#: port/frontend/shell/settings.cpp:1529
msgid "Hold to confirm"
msgstr "Nyomva tartás a megerősítéshez"

#: port/frontend/shell/settings.cpp:1529
msgid "How long to hold Cross for actions that can't be undone."
msgstr "Meddig kell nyomva tartani a keresztet ahhoz, ami nem vonható vissza."

#: port/frontend/shell/settings.cpp:1530
msgid "Actions like clearing caches or resetting controls need Cross held to confirm. This sets how long."
msgstr "A gyorsítótárak törlését, az Artic Setupot és az irányítás visszaállítását nyomva tartással kell megerősíteni, soha nem dupla nyomással. Ennyi ideig."

#: port/frontend/shell/settings.cpp:1532
msgid "Run first-time setup again."
msgstr "Az első indítás választásai újra: oldalak, téma, gombok."

#: port/frontend/shell/settings.cpp:1533
msgid "Shows the first-time setup again: language, systems, theme, buttons, music, vibration and game pictures."
msgstr "Az oldal, amellyel az első indítás kezdődik: a nyelv, az oldalak, a téma, A és B, a zene, a rezgés és a játékok képei, egy oldalon."

#: port/frontend/shell/settings.cpp:1537
msgid "Checks storage, performance, games, keys and box art."
msgstr "Tárhely, újrafordítók, játékok, kulcsok és borítók, ellenőrizve."

#: port/frontend/shell/settings.cpp:1538
msgid "Each check shows its status and what to do. It also appears on first start, and when a check fails."
msgstr "Minden ellenőrzésnek van állapota, jelentése és teendője. Az első indításkor is megjelenik, és mindig, ha az alkalmazás indulásakor egy ellenőrzés nem sikerül."

#: port/frontend/shell/settings.cpp:1539
msgid "Copy logs to USB"
msgstr "Naplók másolása USB-re"

#: port/frontend/shell/settings.cpp:1539
msgid "Copy logs to a USB drive for a bug report."
msgstr "A hibajelentéshez szükséges naplók, USB-meghajtóra."

#: port/frontend/shell/settings.cpp:1540
msgid "Copies the last five sessions' logs and the settings into a dated folder on a USB drive, to attach to a report."
msgstr "Átmásolja az utolsó öt munkamenet naplóit és a beállításokat egy dátummal ellátott mappába egy USB-meghajtón, hogy egy hibajelentéshez csatolhasd."

#: port/frontend/shell/settings.cpp:1542 port/frontend/shell/settings.cpp:1545
msgid "Clear shader caches"
msgstr "Árnyaló-gyorsítótárak törlése"

#: port/frontend/shell/settings.cpp:1543 port/frontend/shell/settings.cpp:1546
msgid "Try this if a game crashes."
msgstr "Hibás gyorsítótár miatt összeomló játékhoz."

#: port/frontend/shell/settings.cpp:1543
msgid "Deletes the Wii U shader caches. Games rebuild them, so the first few minutes may stutter."
msgstr "Törli a Cemu árnyaló-gyorsítótárait. A játékok futás közben újraépítik őket: az első percekben akadás lesz."

#: port/frontend/shell/settings.cpp:1547
msgid "Deletes the 3DS shader caches. Games rebuild them, so the first few minutes may stutter."
msgstr "Törli az Azahar árnyaló-gyorsítótárait. A játékok futás közben újraépítik őket: az első percekben akadás lesz."

#. Settings > Diagnostics: the copies of games unpacked from their archives (.zip, .7z...), kept for their next start
#: port/frontend/shell/settings.cpp:1557
msgid "Unpacked games"
msgstr "Kicsomagolt játékok"

#: port/frontend/shell/settings.cpp:1561
msgid "Games unpacked from archives, kept for faster starts."
msgstr "Archívumokból származó játékok, kicsomagolva megőrizve a következő indításukhoz."

#. {0} is the folder they are kept in
#: port/frontend/shell/settings.cpp:1563
msgid "Deletes unpacked copies of archived games in {0}. They unpack again next time. Old copies are removed automatically when space runs low."
msgstr "Törli az archívumukból kicsomagolt játékok másolatait, amelyek itt vannak: {0}. Mindegyiket a következő indításakor újra kicsomagolja; ha hely kell, a legrégebben használt másolatok maguktól törlődnek."

#: port/frontend/shell/settings.cpp:1573
msgid "Wii U games' volume"
msgstr "Wii U-játékok hangereje"

#: port/frontend/shell/settings.cpp:1573
msgid "3DS games' volume"
msgstr "3DS-játékok hangereje"

#: port/frontend/shell/settings.cpp:1573
msgid "Switch games' volume"
msgstr "Switch-játékok hangereje"

#: port/frontend/shell/settings.cpp:1573
msgid "DS games' volume"
msgstr "DS-játékok hangereje"

#: port/frontend/shell/settings.cpp:1574
msgid "The games' sound."
msgstr "A játékok hangja."

#: port/frontend/shell/settings.cpp:1574
msgid "Game volume for this system. Left and Right change it by 10%."
msgstr "A játékok hangja ezen az oldalon. A Bal és a Jobb 10 %-kal módosítja."

#: port/frontend/shell/settings.cpp:1577
msgid "GamePad speaker"
msgstr "GamePad-hangszóró"

#: port/frontend/shell/settings.cpp:1577
msgid "GamePad sound from the DualSense speaker."
msgstr "A Wii U GamePad saját hangja, a DualSense-en."

#: port/frontend/shell/settings.cpp:1578
msgid "Plays GamePad speaker sounds from player 1's DualSense. Many games send all their sound there too, so it's off by default. Applies to the next game."
msgstr "A hangok, amelyeket a játékok a Wii U GamePad hangszóróján játszanak le, az 1. játékos DualSense-ének hangszóróján. Sok játék a teljes hangját is oda küldi, ezért ki van kapcsolva, hacsak nem kéred. A következő játéktól érvényes."

#. Settings > System: a row that opens the launcher's music and menu sounds
#: port/frontend/shell/settings.cpp:1585
msgid "Launcher sound"
msgstr "Az indító hangja"

#. Settings > System: a row that opens the launcher's music and menu sounds
#: port/frontend/shell/settings.cpp:1585
msgid "The menus' music and sounds."
msgstr "A menük zenéje és hangjai."

#: port/frontend/shell/settings.cpp:1586
msgid "Menu music, its volume, and menu sounds. The same for every system."
msgstr "A menükben szóló zene, a hangereje, és a mozgás és választás hangjai. Minden oldalon ugyanazok."

#: port/frontend/shell/settings.cpp:1587
msgid "Launcher music"
msgstr "Az indító zenéje"

#: port/frontend/shell/settings.cpp:1587
msgid "Music that plays in the menus."
msgstr "Zene, ami a menükben szól."

#: port/frontend/shell/settings.cpp:1588
msgid "Built-in music, your own, or none. For your own, put MP3 or WAV files in {0}."
msgstr "Az indító saját zenéje, egy a tieid közül, vagy semmi. A sajátodhoz tegyél MP3- vagy WAV-fájlokat ide: {0}; itt jelennek meg. Minden oldal ugyanazt játssza."

#: port/frontend/shell/settings.cpp:1590
msgid "Music volume"
msgstr "Zene hangereje"

#: port/frontend/shell/settings.cpp:1590
msgid "Menu music volume."
msgstr "Milyen hangos a menük zenéje."

#: port/frontend/shell/settings.cpp:1591
msgid "How loud the launcher's music is. Left and Right change it by 10%."
msgstr "Milyen hangos az indító zenéje. Balra és jobbra 10%-kal változtatja."

#: port/frontend/shell/settings.cpp:1592
msgid "Menu sounds"
msgstr "Menühangok"

#: port/frontend/shell/settings.cpp:1592
msgid "The sounds of moving and choosing."
msgstr "A mozgás és a választás hangjai."

#: port/frontend/shell/settings.cpp:1593
msgid "The launcher's sounds as you move, choose and go back."
msgstr "Az indító hangjai, amikor mozogsz, választasz és visszalépsz."

#. Settings > System on the Wii U side: a row that opens Cemu's emulated portals (Skylanders, Disney Infinity, LEGO Dimensions)
#: port/frontend/shell/settings.cpp:1602
msgid "Emulated toy portals."
msgstr "A Cemu emulált portáljai."

#: port/frontend/shell/settings.cpp:1607
msgid "For the Skylanders games."
msgstr "A Skylanders-játékokhoz."

#: port/frontend/shell/settings.cpp:1608
