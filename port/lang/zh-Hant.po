msgid "Setup before each game"
msgstr "每次遊戲前設定"

#: port/frontend/shell/porpoise_rows.cpp:301
msgid "Shows the Wii Remote's setup when a game starts."
msgstr "遊戲啟動時顯示 Wii 遙控器的設定。"

