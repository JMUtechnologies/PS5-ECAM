msgstr "直握，扳機朝電視"

#: port/frontend/shell/porpoise_rows.cpp:294
msgid "Upright, facing you"
msgstr "直握，正面朝自己"

#: port/frontend/shell/porpoise_rows.cpp:295
msgid "Motion"
msgstr "動作感應"

#: port/frontend/shell/porpoise_rows.cpp:295
msgid "Tilt, swing and point with the DualSense."
msgstr "DualSense 的動作即為遙控器的動作：傾斜、揮動與指向。"

