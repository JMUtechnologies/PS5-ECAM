msgstr "Resolución nativa"

#: port/frontend/shell/porpoise_rows.cpp:191
msgid "Depth of field"
msgstr "Profundidad de campo"

#: port/frontend/shell/porpoise_rows.cpp:191
msgid "Dolphin's graphics mod for the blur on faraway things. Applies the next time it starts."
msgstr "El mod gráfico de Dolphin para el desenfoque de lo lejano. Se aplica la próxima vez que empiece."

#: port/frontend/shell/porpoise_rows.cpp:193
msgid "Hide the HUD"
msgstr "Ocultar el HUD"

#: port/frontend/shell/porpoise_rows.cpp:193
msgid "Hides the game's HUD, for clean screenshots. Applies the next time it starts."
msgstr "Oculta el HUD del juego, para capturas limpias. Se aplica la próxima vez que empiece."

#: port/frontend/shell/porpoise_rows.cpp:194
msgid "Native resolution goop"
msgstr "Pringue a resolución nativa"

#: port/frontend/shell/porpoise_rows.cpp:194
msgid "Super Mario Sunshine's goop at the game's own resolution. Applies the next time it starts."
msgstr "El pringue de Super Mario Sunshine a la resolución propia del juego. Se aplica la próxima vez que empiece."

#: port/frontend/shell/porpoise_rows.cpp:195 port/frontend/shell/settings.cpp:682 port/frontend/shell/settings.cpp:690
msgid "Custom textures"
msgstr "Texturas personalizadas"

#: port/frontend/shell/porpoise_rows.cpp:195
msgid "Loads HD texture packs."
msgstr "Carga paquetes de texturas HD."

#: port/frontend/shell/porpoise_rows.cpp:196
msgid "Loads HD texture packs. Put each pack's folder, named with the game's ID (like GALE01), in /data/porpoise/saves/User/Load/Textures."
msgstr "Carga paquetes de texturas HD. Pon la carpeta de cada paquete, con el ID del juego como nombre (como GALE01), en /data/porpoise/saves/User/Load/Textures."

#: port/frontend/shell/porpoise_rows.cpp:198 port/frontend/shell/porpoise_rows.cpp:210 port/frontend/shell/porpoise_rows.cpp:222 port/frontend/shell/porpoise_rows.cpp:234
msgid "Device"
msgstr "Dispositivo"

#: port/frontend/shell/porpoise_rows.cpp:198 port/frontend/shell/porpoise_rows.cpp:210 port/frontend/shell/porpoise_rows.cpp:222 port/frontend/shell/porpoise_rows.cpp:234
msgid "What this GameCube controller port holds."
msgstr "Qué hay en este puerto de mando de GameCube."

#: port/frontend/shell/porpoise_rows.cpp:199 port/frontend/shell/porpoise_rows.cpp:211 port/frontend/shell/porpoise_rows.cpp:223 port/frontend/shell/porpoise_rows.cpp:235
msgid "What this GameCube controller port holds. GBA (Integrated) is a Game Boy Advance on the link cable, for Wind Waker's Tingle Tuner and Four Swords Adventures. It needs the GBA BIOS as /data/porpoise/saves/User/GBA/gba_bios.bin. Best set for one game."
msgstr "Qué hay en este puerto de mando de GameCube. GBA (integrada) es una Game Boy Advance en el cable Link, para el Tingle Tuner de Wind Waker y Four Swords Adventures. Necesita la BIOS de GBA como /data/porpoise/saves/User/GBA/gba_bios.bin. Mejor ajustarlo para un solo juego."

#: port/frontend/shell/porpoise_rows.cpp:200 port/frontend/shell/porpoise_rows.cpp:212 port/frontend/shell/porpoise_rows.cpp:224 port/frontend/shell/porpoise_rows.cpp:236 port/frontend/shell/porpoise_rows.cpp:1173
