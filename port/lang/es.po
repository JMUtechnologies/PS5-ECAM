#: port/frontend/shell/porpoise_rows.cpp:201 port/frontend/shell/porpoise_rows.cpp:213 port/frontend/shell/porpoise_rows.cpp:225 port/frontend/shell/porpoise_rows.cpp:237
msgid "Who plays this GBA, while holding their GBA button."
msgstr "Quién juega con esta GBA, mientras mantiene su botón de GBA."

#: port/frontend/shell/porpoise_rows.cpp:202 port/frontend/shell/porpoise_rows.cpp:214 port/frontend/shell/porpoise_rows.cpp:226 port/frontend/shell/porpoise_rows.cpp:238
msgid "A player plays it while holding their GBA button, its sound on their controller and its screen theirs to show. Its own controller: the controller in this port is the GBA, no button held (Four Swords Adventures). Nobody: only the page in a browser."
msgstr "Un jugador la usa mientras mantiene su botón de GBA, con su sonido en su mando y su pantalla a su disposición. Su propio mando: el mando de este puerto es la GBA, sin mantener ningún botón (Four Swords Adventures). Nadie: solo la página en un navegador."

#: port/frontend/shell/porpoise_rows.cpp:203 port/frontend/shell/porpoise_rows.cpp:215 port/frontend/shell/porpoise_rows.cpp:227 port/frontend/shell/porpoise_rows.cpp:239 port/frontend/shell/porpoise_rows.cpp:1164
msgid "Its own controller"
msgstr "Su propio mando"

#: port/frontend/shell/porpoise_rows.cpp:204 port/frontend/shell/porpoise_rows.cpp:216 port/frontend/shell/porpoise_rows.cpp:228 port/frontend/shell/porpoise_rows.cpp:240
msgid "Whose controller is in this port."
msgstr "De quién es el mando de este puerto."

