msgstr "Volver a los valores propios del emulador"

#: port/frontend/shell/settings.cpp:1793
msgid "Nothing changed"
msgstr "Nada cambió"

#: port/frontend/shell/settings.cpp:1795
msgid "Resets every option above to {0}'s default, for every game on this system."
msgstr "Restablece todas las opciones anteriores a los valores predeterminados de {0}, para cada juego en este sistema."

