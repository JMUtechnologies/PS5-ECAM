#: port/app/accounts.cpp:68 port/frontend/shell/settings.cpp:1802
msgid "The Wii U has twelve accounts at most."
msgstr "La Wii U admite doce cuentas como máximo."

#: port/app/accounts.cpp:104
msgid "The last account cannot be deleted."
msgstr "La última cuenta no se puede eliminar."

#: port/app/accounts.cpp:109
msgid "Games start on this account: choose another one first."
msgstr "Los juegos se inician con esta cuenta: elige antes otra."

