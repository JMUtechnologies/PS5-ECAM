msgid "New account"
msgstr "Akun baru"

#: port/frontend/shell/settings.cpp:1226
msgid "A new account starts with no saves."
msgstr "Akun baru dimulai tanpa data simpanan."

#: port/frontend/shell/settings.cpp:1226
msgid "Up to ten letters. Games then start on it."
msgstr "Beri nama dengan keyboard, paling banyak sepuluh huruf. Game dimulai dengan akun ini setelahnya."

#: port/frontend/shell/settings.cpp:1227
msgid "Rename {0}"
msgstr "Ganti nama {0}"

#: port/frontend/shell/settings.cpp:1227
