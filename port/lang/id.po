msgstr "Aktif: file sistem ini mendapatkan foldernya sendiri. Mati: disimpan bersama yang lain."

#: port/frontend/shell/settings.cpp:1181
msgid "Own folder"
msgstr "Folder sendiri"

#: port/frontend/shell/settings.cpp:1181
