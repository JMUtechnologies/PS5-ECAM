msgstr "Ruang pribadi"

#: port/frontend/shell/settings.cpp:1363
msgid "Cross to enter one"
msgstr "Silang untuk memasukkan"

#: port/frontend/shell/settings.cpp:1364
msgid "Join a room by address, port and password."
